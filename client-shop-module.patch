+@using PetManagementSystem.Helpers
+@model PetManagementSystem.ViewModels.Shop.MyInvoiceViewModel
+@{
+    ViewData["Title"] = $"Hóa đơn #{Model.InvoiceId}";
+}
+
+<link rel="stylesheet" href="~/css/shop.css" asp-append-version="true" />
+
+<div class="d-flex justify-content-between mb-3 no-print">
+    <a asp-action="Details" asp-route-id="@Model.OrderId" class="btn btn-outline-secondary">&larr; Về đơn hàng</a>
+    <button type="button" class="btn btn-shop" onclick="window.print()"><i class="bi bi-printer me-1"></i>In hóa đơn</button>
+</div>
+
+<div class="card border-0 shadow-sm rounded-4 p-4">
+    <div class="d-flex justify-content-between flex-wrap gap-2 mb-4">
+        <div>
+            <h3 class="fw-bold mb-0">HÓA ĐƠN #@Model.InvoiceId</h3>
+            <div class="text-muted">PetCare - Hệ thống quản lý thú cưng</div>
+        </div>
+        <div class="text-md-end">
+            <div>Ngày lập: <strong>@CommerceFormat.DateTimeText(Model.InvoiceDate)</strong></div>
+            <div>Đơn hàng: <strong>#@Model.OrderId</strong></div>
+        </div>
+    </div>
+
+    <div class="row mb-4">
+        <div class="col-md-6">
+            <h6 class="fw-bold">Khách hàng</h6>
+            <div>@Model.CustomerName</div>
+            @if (!string.IsNullOrEmpty(Model.Email)) { <div class="text-muted">@Model.Email</div> }
+            <div class="text-muted">@Model.Phone</div>
+            <div class="text-muted">@Model.ShippingAddress</div>
+        </div>
+    </div>
+
+    <div class="table-responsive">
+        <table class="table align-middle">
+            <thead class="table-light">
+                <tr>
+                    <th>Sản phẩm</th>
+                    <th class="text-end">Đơn giá</th>
+                    <th class="text-center">SL</th>
+                    <th class="text-end">Thành tiền</th>
+                </tr>
+            </thead>
+            <tbody>
+                @foreach (var item in Model.Items)
+                {
+                    <tr>
+                        <td>@item.ProductName@(string.IsNullOrEmpty(item.Unit) ? "" : " (" + item.Unit + ")")</td>
+                        <td class="text-end">@CommerceFormat.Money(item.Price)</td>
+                        <td class="text-center">@item.Quantity</td>
+                        <td class="text-end">@CommerceFormat.Money(item.Subtotal)</td>
+                    </tr>
+                }
+            </tbody>
+            <tfoot>
+                <tr>
+                    <td colspan="3" class="text-end">Tiền thuế</td>
+                    <td class="text-end">@CommerceFormat.Money(Model.TaxAmount)</td>
