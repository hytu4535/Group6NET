@@ -0,0 +1,176 @@
+using System.Text.RegularExpressions;
+using PetManagementSystem.Helpers;
+using PetManagementSystem.Models;
+using PetManagementSystem.Repositories;
+using PetManagementSystem.ViewModels.Shop;
+
+namespace PetManagementSystem.Services;
+
+public class CheckoutService(
+    IClientCartService cartService,
+    IClientCartRepository cartRepository,
+    IClientOrderRepository orderRepository,
+    IUserRepository userRepository,
+    ILogger<CheckoutService> logger) : ICheckoutService
+{
+    private static readonly Regex PhoneSeparators = new(@"[\s.\-]", RegexOptions.Compiled);
+
+    public async Task<CheckoutViewModel> BuildAsync(int userId, CheckoutInputModel? input = null)
+    {
+        if (input is null)
+        {
+            var user = await userRepository.GetByIdAsync(userId);
+            input = new CheckoutInputModel
+            {
+                ShippingAddress = user?.Address ?? string.Empty,
+                Phone = user?.PhoneNumber ?? string.Empty
+            };
+        }
+
+        if (string.IsNullOrEmpty(input.PaymentMethod) || !ClientPaymentMethods.Supported.Contains(input.PaymentMethod))
+        {
+            input.PaymentMethod = ClientPaymentMethods.Supported[0];
+        }
+
+        return new CheckoutViewModel
+        {
+            Cart = await cartService.GetCartAsync(userId),
+            Input = input,
+            PaymentOptions = ClientPaymentMethods.Supported.Select(m => new PaymentOptionViewModel
+            {
+                Value = m,
+                Label = PaymentMethods.Label(m),
+                Description = ClientPaymentMethods.Description(m)
+            }).ToList()
+        };
+    }
+
+    public async Task<ServiceResult<int>> PlaceOrderAsync(int userId, CheckoutInputModel input)
+    {
+        if (!ClientPaymentMethods.Supported.Contains(input.PaymentMethod))
+        {
+            return ServiceResult<int>.Fail("Phương thức thanh toán không được hỗ trợ", nameof(input.PaymentMethod));
+        }
+
+        var phone = PhoneSeparators.Replace(input.Phone ?? string.Empty, string.Empty);
+        if (phone.Length is < 8 or > 15)
+        {
+            return ServiceResult<int>.Fail("Số điện thoại không hợp lệ", nameof(input.Phone));
+        }
+
+        var address = input.ShippingAddress.TrimToNull();
+        if (address is null)
+        {
+            return ServiceResult<int>.Fail("Địa chỉ giao hàng là bắt buộc", nameof(input.ShippingAddress));
+        }
+
+        var user = await userRepository.GetByIdAsync(userId);
+        if (user is null || !string.Equals(user.Status, "active", StringComparison.OrdinalIgnoreCase))
+        {
+            return ServiceResult<int>.Fail("Tài khoản không tồn tại hoặc đã bị khóa");
+        }
+
+        try
+        {
+            await using var transaction = await orderRepository.BeginTransactionAsync();
+
+            var cart = await cartRepository.GetActiveCartAsync(userId, includeItems: true);
+            if (cart is null || cart.Items.Count == 0)
+            {
+                return ServiceResult<int>.Fail("Giỏ hàng của bạn đang trống");
+            }
+
+            // Kiểm tra lại phía server bằng dữ liệu hiện hành trong CSDL, không dùng giá/số lượng từ client.
+            var lines = cart.Items.OrderBy(i => i.ProductId).ToList();
+            foreach (var item in lines)
+            {
+                var product = item.Product;
+                if (product is null || product.Status != ProductStatuses.Active)
+                {
+                    return ServiceResult<int>.Fail($"Sản phẩm \"{product?.ProductName ?? "#" + item.ProductId}\" đã ngừng bán, vui lòng xóa khỏi giỏ hàng");
+                }
+
+                if (item.Quantity < 1)
+                {
+                    return ServiceResult<int>.Fail("Giỏ hàng có số lượng không hợp lệ");
+                }
+
+                if (product.StockQuantity < item.Quantity)
+                {
+                    return ServiceResult<int>.Fail($"Sản phẩm \"{product.ProductName}\" chỉ còn {product.StockQuantity} trong kho");
+                }
+            }
+
+            var order = new Order
+            {
+                UserId = userId,
+                OrderDate = DateTime.Now,
+                ShippingAddress = address,
+                Phone = phone,
+                Status = OrderStatuses.Pending,
+                Note = input.Note.TrimToNull()
+            };
+
+            foreach (var item in lines)
+            {
+                var price = item.Product!.SellPrice;
+                order.Items.Add(new OrderItem
+                {
+                    ProductId = item.ProductId,
+                    Quantity = item.Quantity,
+                    Price = price,
+                    Subtotal = price * item.Quantity
+                });
+            }
+
+            order.TotalAmount = order.Items.Sum(x => x.Subtotal);
+            if (order.TotalAmount > CommerceMapping.MaxMoney)
+            {
+                return ServiceResult<int>.Fail("Tổng giá trị đơn hàng vượt quá giới hạn cho phép");
+            }
+
+            // Chốt giỏ nguyên tử: nếu bấm đặt hàng nhiều lần, chỉ yêu cầu đầu tiên giành được giỏ.
+            if (!await cartRepository.TryMarkCheckedOutAsync(cart.Id, userId))
+            {
+                return ServiceResult<int>.Fail("Giỏ hàng đã được đặt hoặc đã thay đổi. Vui lòng kiểm tra lại đơn hàng của bạn");
+            }
+
+            // Trừ kho nguyên tử theo từng sản phẩm; thiếu hàng ở bất kỳ dòng nào thì rollback toàn bộ.
+            foreach (var item in lines)
+            {
+                if (!await orderRepository.TryReserveStockAsync(item.ProductId, item.Quantity))
+                {
+                    return ServiceResult<int>.Fail($"Sản phẩm \"{item.Product!.ProductName}\" không còn đủ hàng để đặt");
+                }
+            }
+
+            await orderRepository.AddOrderAsync(order);
+
+            await orderRepository.AddPaymentAsync(new Payment
+            {
+                OrderId = order.Id,
+                PaymentMethod = input.PaymentMethod,
+                Amount = order.TotalAmount,
+                PaymentDate = order.OrderDate,
+                Status = PaymentStatuses.Pending,
+                TransactionCode = $"PAY-{order.Id}-{DateTime.Now:yyyyMMddHHmmssfff}"
+            });
+
+            // Ghi lại đơn giá đã dùng để đặt hàng vào cart_items.price của giỏ vừa chốt.
+            foreach (var item in lines)
+            {
+                item.Price = item.Product!.SellPrice;
+            }
+
+            await cartRepository.TrySaveAsync();
+
+            await transaction.CommitAsync();
+            return ServiceResult<int>.Ok(order.Id);
+        }
+        catch (Exception ex)
+        {
+            logger.LogError(ex, "Đặt hàng thất bại cho user {UserId}", userId);
+            return ServiceResult<int>.Fail("Không thể đặt hàng lúc này, vui lòng thử lại sau");
+        }
+    }
+}
diff --git a/PetManagementSystem/Services/ClientCartService.cs b/PetManagementSystem/Services/ClientCartService.cs
new file mode 100644
index 0000000..b9fd66a
--- /dev/null
+++ b/PetManagementSystem/Services/ClientCartService.cs
@@ -0,0 +1,193 @@
+using PetManagementSystem.Helpers;
+using PetManagementSystem.Models;
+using PetManagementSystem.Repositories;
+using PetManagementSystem.ViewModels.Shop;
+
+namespace PetManagementSystem.Services;
+
+public class ClientCartService(IClientCartRepository cartRepository) : IClientCartService
+{
+    private const string SaveFailedMessage = "Không thể cập nhật giỏ hàng lúc này, vui lòng thử lại.";
+
+    public async Task<CartViewModel> GetCartAsync(int userId)
+    {
+        var cart = await cartRepository.GetActiveCartAsync(userId, includeItems: true);
+        return ToViewModel(cart);
+    }
+
+    public async Task<ServiceResult<CartChangeResult>> AddItemAsync(int userId, int productId, int quantity)
+    {
+        if (quantity < 1)
+        {
+            return ServiceResult<CartChangeResult>.Fail("Số lượng phải lớn hơn 0");
+        }
+
+        var product = await cartRepository.GetProductAsync(productId);
+        if (product is null || product.Status != ProductStatuses.Active)
+        {
+            return ServiceResult<CartChangeResult>.Fail("Sản phẩm không tồn tại hoặc đã ngừng bán");
+        }
+
+        if (product.StockQuantity <= 0)
+        {
+            return ServiceResult<CartChangeResult>.Fail($"Sản phẩm \"{product.ProductName}\" đã hết hàng");
+        }
+
+        var cart = await cartRepository.GetActiveCartAsync(userId, includeItems: true)
+                   ?? await cartRepository.CreateActiveCartAsync(userId);
+
+        var existing = cart.Items.FirstOrDefault(i => i.ProductId == productId);
+        var newQuantity = (existing?.Quantity ?? 0) + quantity;
+        if (newQuantity > product.StockQuantity)
+        {
+            var inCart = existing?.Quantity ?? 0;
+            var message = inCart > 0
+                ? $"Sản phẩm \"{product.ProductName}\" chỉ còn {product.StockQuantity} trong kho (bạn đã có {inCart} trong giỏ)"
+                : $"Sản phẩm \"{product.ProductName}\" chỉ còn {product.StockQuantity} trong kho";
+            return ServiceResult<CartChangeResult>.Fail(message, nameof(AddToCartRequest.Quantity));
+        }
+
+        if (existing is null)
+        {
+            existing = new CartItem
+            {
+                CartId = cart.Id,
+                ProductId = product.Id,
+                Quantity = newQuantity,
+                Price = product.SellPrice
+            };
+            cartRepository.AddItem(existing);
+        }
+        else
+        {
+            existing.Quantity = newQuantity;
+            existing.Price = product.SellPrice;
+        }
+
+        cart.UpdatedAt = DateTime.Now;
+        if (!await cartRepository.TrySaveAsync())
+        {
+            return ServiceResult<CartChangeResult>.Fail(SaveFailedMessage);
+        }
+
+        return await SummarizeAsync(userId, existing.Id, product.SellPrice);
+    }
+
+    public async Task<ServiceResult<CartChangeResult>> UpdateQuantityAsync(int userId, int itemId, int quantity)
+    {
+        if (quantity < 1)
+        {
+            return ServiceResult<CartChangeResult>.Fail("Số lượng phải lớn hơn 0", nameof(UpdateCartItemRequest.Quantity));
+        }
+
+        var item = await cartRepository.GetActiveItemAsync(userId, itemId);
+        if (item is null)
+        {
+            return ServiceResult<CartChangeResult>.Fail("Không tìm thấy sản phẩm trong giỏ hàng");
+        }
+
+        var product = item.Product;
+        if (product is null || product.Status != ProductStatuses.Active)
+        {
+            return ServiceResult<CartChangeResult>.Fail("Sản phẩm đã ngừng bán, vui lòng xóa khỏi giỏ hàng");
+        }
+
+        if (quantity > product.StockQuantity)
+        {
+            return ServiceResult<CartChangeResult>.Fail(
+                $"Sản phẩm \"{product.ProductName}\" chỉ còn {product.StockQuantity} trong kho",
+                nameof(UpdateCartItemRequest.Quantity));
+        }
+
+        item.Quantity = quantity;
+        item.Price = product.SellPrice;
+        item.Cart!.UpdatedAt = DateTime.Now;
+
+        if (!await cartRepository.TrySaveAsync())
+        {
+            return ServiceResult<CartChangeResult>.Fail(SaveFailedMessage);
+        }
+
+        return await SummarizeAsync(userId, item.Id, product.SellPrice);
+    }
+
+    public async Task<ServiceResult<CartChangeResult>> RemoveItemAsync(int userId, int itemId)
+    {
+        var item = await cartRepository.GetActiveItemAsync(userId, itemId);
+        if (item is null)
+        {
+            return ServiceResult<CartChangeResult>.Fail("Không tìm thấy sản phẩm trong giỏ hàng");
+        }
+
+        item.Cart!.UpdatedAt = DateTime.Now;
+        cartRepository.RemoveItem(item);
+
+        if (!await cartRepository.TrySaveAsync())
+        {
+            return ServiceResult<CartChangeResult>.Fail(SaveFailedMessage);
+        }
+
+        return await SummarizeAsync(userId, null, 0);
+    }
+
+    private async Task<ServiceResult<CartChangeResult>> SummarizeAsync(int userId, int? itemId, decimal unitPrice)
+    {
+        var cart = await cartRepository.GetActiveCartAsync(userId, includeItems: true);
+        var view = ToViewModel(cart);
+        var line = itemId.HasValue ? view.Items.FirstOrDefault(x => x.ItemId == itemId.Value) : null;
+
+        return ServiceResult<CartChangeResult>.Ok(new CartChangeResult
+        {
+            ItemId = itemId,
+            Quantity = line?.Quantity ?? 0,
+            LineTotal = line?.LineTotal ?? (itemId.HasValue ? unitPrice : 0),
+            CartTotal = view.TotalAmount,
+            CartQuantity = view.TotalQuantity,
+            LineCount = view.Items.Count
+        });
+    }
+
+    /// <summary>Đơn giá luôn lấy từ products.sell_price hiện hành; cart_items.price chỉ là giá ghi nhận ở lần cập nhật gần nhất.</summary>
+    internal static CartViewModel ToViewModel(Cart? cart)
+    {
+        var model = new CartViewModel();
+        if (cart is null)
+        {
+            return model;
+        }
+
+        foreach (var item in cart.Items.OrderBy(i => i.Id))
+        {
+            var product = item.Product;
+            var line = new CartLineViewModel
+            {
+                ItemId = item.Id,
+                ProductId = item.ProductId,
+                ProductName = product?.ProductName ?? $"#{item.ProductId}",
+                ImageUrl = product?.ImageUrl,
+                Unit = product?.Unit,
+                UnitPrice = product?.SellPrice ?? item.Price,
+                Quantity = item.Quantity,
+                StockQuantity = product?.StockQuantity ?? 0,
+                PriceChanged = product is not null && product.SellPrice != item.Price
+            };
+
+            if (product is null || product.Status != ProductStatuses.Active)
+            {
+                line.Issue = "Sản phẩm đã ngừng bán";
+            }
+            else if (product.StockQuantity <= 0)
+            {
+                line.Issue = "Sản phẩm đã hết hàng";
+            }
+            else if (item.Quantity > product.StockQuantity)
+            {
+                line.Issue = $"Chỉ còn {product.StockQuantity} sản phẩm trong kho";
+            }
+
+            model.Items.Add(line);
+        }
+
+        return model;
+    }
+}
diff --git a/PetManagementSystem/Services/ClientOrderService.cs b/PetManagementSystem/Services/ClientOrderService.cs
new file mode 100644
index 0000000..fd9335d
--- /dev/null
+++ b/PetManagementSystem/Services/ClientOrderService.cs
@@ -0,0 +1,173 @@
+using PetManagementSystem.Helpers;
+using PetManagementSystem.Models;
+using PetManagementSystem.Repositories;
+using PetManagementSystem.ViewModels.Shop;
+
+namespace PetManagementSystem.Services;
+
+public class ClientOrderService(
+    IClientOrderRepository orderRepository,
+    ILogger<ClientOrderService> logger) : IClientOrderService
+{
+    public async Task<MyOrderListViewModel> GetOrdersAsync(int userId, MyOrdersQuery query)
+    {
+        var status = CommerceMapping.NormalizeOption(query.Status, OrderStatuses.All);
+        var result = await orderRepository.SearchOwnedAsync(
+            userId,
+            status.Length == 0 ? null : status,
+            query.From,
+            query.To,
+            query.Page,
+            Paging.DefaultPageSize);
+
+        return new MyOrderListViewModel
+        {
+            Status = status.Length == 0 ? null : status,
+            From = query.From,
+            To = query.To,
+            Page = result.Page,
+            PageSize = result.PageSize,
+            TotalCount = result.TotalCount,
+            Items = result.Items.Select(o => new MyOrderRowViewModel
+            {
+                Id = o.Id,
+                OrderDate = o.OrderDate,
+                TotalAmount = o.TotalAmount,
+                Status = o.Status,
+                ItemCount = o.Items.Count,
+                PaymentStatus = SummarizePayment(o)
+            }).ToList()
+        };
+    }
+
+    public async Task<MyOrderDetailsViewModel?> GetOrderAsync(int userId, int orderId)
+    {
+        var order = await orderRepository.GetOwnedDetailsAsync(userId, orderId);
+        if (order is null)
+        {
+            return null;
+        }
+
+        var paid = order.Payments.Where(p => p.Status == PaymentStatuses.Completed).Sum(p => p.Amount);
+
+        return new MyOrderDetailsViewModel
+        {
+            Id = order.Id,
+            OrderDate = order.OrderDate,
+            ShippingAddress = order.ShippingAddress,
+            Phone = order.Phone,
+            Note = order.Note,
+            Status = order.Status,
+            TotalAmount = order.TotalAmount,
+            PaidAmount = paid,
+            CanCancel = order.Status == OrderStatuses.Pending && paid == 0,
+            HasInvoice = order.Invoice is not null,
+            Items = order.Items.OrderBy(i => i.Id).Select(ToItem).ToList(),
+            Payments = order.Payments.OrderByDescending(p => p.PaymentDate).ThenByDescending(p => p.Id).Select(p => new MyPaymentViewModel
+            {
+                Id = p.Id,
+                PaymentMethod = p.PaymentMethod,
+                Amount = p.Amount,
+                PaymentDate = p.PaymentDate,
+                Status = p.Status,
+                TransactionCode = p.TransactionCode
+            }).ToList()
+        };
+    }
+
+    public async Task<ServiceResult> CancelAsync(int userId, int orderId)
+    {
+        var order = await orderRepository.GetOwnedDetailsAsync(userId, orderId);
+        if (order is null)
+        {
+            return ServiceResult.Fail("Không tìm thấy đơn hàng");
+        }
+
+        if (order.Status != OrderStatuses.Pending)
+        {
+            return ServiceResult.Fail("Chỉ có thể hủy đơn khi đơn đang chờ xác nhận. Vui lòng liên hệ cửa hàng để được hỗ trợ.");
+        }
+
+        try
+        {
+            await using var transaction = await orderRepository.BeginTransactionAsync();
+
+            // Chuyển trạng thái có điều kiện (đang pending) để tránh xung đột với nhân viên vừa xác nhận đơn.
+            if (!await orderRepository.TryCancelPendingAsync(userId, orderId))
+            {
+                return ServiceResult.Fail("Đơn hàng vừa được cập nhật trạng thái nên không thể hủy. Vui lòng tải lại trang.");
+            }
+
+            if (await orderRepository.HasCompletedPaymentAsync(orderId))
+            {
+                return ServiceResult.Fail("Đơn hàng đã có thanh toán thành công. Vui lòng liên hệ cửa hàng để được hoàn tiền và hủy đơn.");
+            }
+
+            foreach (var item in order.Items.OrderBy(i => i.ProductId))
+            {
+                await orderRepository.ReleaseStockAsync(item.ProductId, item.Quantity);
+            }
+
+            await orderRepository.FailPendingPaymentsAsync(orderId);
+
+            await transaction.CommitAsync();
+            return ServiceResult.Ok();
+        }
+        catch (Exception ex)
+        {
+            logger.LogError(ex, "Hủy đơn {OrderId} thất bại cho user {UserId}", orderId, userId);
+            return ServiceResult.Fail("Không thể hủy đơn lúc này, vui lòng thử lại sau");
+        }
+    }
+
+    public async Task<MyInvoiceViewModel?> GetInvoiceAsync(int userId, int orderId)
+    {
+        var invoice = await orderRepository.GetOwnedInvoiceAsync(userId, orderId);
+        if (invoice?.Order is null)
+        {
+            return null;
+        }
+
+        return new MyInvoiceViewModel
+        {
+            InvoiceId = invoice.Id,
+            OrderId = invoice.OrderId,
+            InvoiceDate = invoice.InvoiceDate,
+            CustomerName = CommerceFormat.DisplayName(invoice.Order.User),
+            Email = invoice.Order.User?.Email,
+            Phone = invoice.Order.Phone,
+            ShippingAddress = invoice.Order.ShippingAddress,
+            TotalAmount = invoice.TotalAmount,
+            TaxAmount = invoice.TaxAmount,
+            Items = invoice.Order.Items.OrderBy(i => i.Id).Select(ToItem).ToList()
+        };
+    }
+
+    private static MyOrderItemViewModel ToItem(OrderItem item) => new()
+    {
+        ProductId = item.ProductId,
+        ProductName = item.Product?.ProductName ?? $"#{item.ProductId}",
+        ImageUrl = item.Product?.ImageUrl,
+        Unit = item.Product?.Unit,
+        Quantity = item.Quantity,
+        Price = item.Price,
+        Subtotal = item.Subtotal
+    };
+
+    /// <summary>Trạng thái thanh toán tổng hợp của đơn: đã đủ tiền -> completed, ngược lại lấy giao dịch gần nhất.</summary>
+    private static string? SummarizePayment(Order order)
+    {
+        if (order.Payments.Count == 0)
+        {
+            return null;
+        }
+
+        var paid = order.Payments.Where(p => p.Status == PaymentStatuses.Completed).Sum(p => p.Amount);
+        if (order.TotalAmount > 0 && paid >= order.TotalAmount)
+        {
+            return PaymentStatuses.Completed;
+        }
+
+        return order.Payments.OrderByDescending(p => p.PaymentDate).ThenByDescending(p => p.Id).First().Status;
+    }
+}
