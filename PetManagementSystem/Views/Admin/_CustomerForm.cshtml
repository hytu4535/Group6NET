@model PetManagementSystem.ViewModels.CustomerFormViewModel
@{ var isCreate = ViewData["IsCreate"] is true; }
<input asp-for="Id" type="hidden" />
@if (!isCreate)
{
    <input asp-for="UserId" type="hidden" />
}
<div class="mb-3">
    <label asp-for="UserId" class="form-label">Tài khoản</label>
    <select asp-for="UserId" asp-items="Model.UserOptions" class="form-select customer-user-select" disabled="@(!isCreate)">
        <option value="">-- Chọn username đã có --</option>
    </select>
    <span asp-validation-for="UserId" class="text-danger"></span>
    <div class="customer-user-message text-danger small mt-1" role="alert"></div>
</div>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="row g-3">
    <div class="col-md-6"><label asp-for="FullName" class="form-label">Họ tên</label><input asp-for="FullName" class="form-control customer-account-field" readonly /><span asp-validation-for="FullName" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="Email" class="form-label">Email</label><input asp-for="Email" class="form-control customer-account-field" readonly /><span asp-validation-for="Email" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="PhoneNumber" class="form-label">Số điện thoại</label><input asp-for="PhoneNumber" class="form-control customer-account-field" readonly /><span asp-validation-for="PhoneNumber" class="text-danger"></span></div>
    <div class="col-12"><label asp-for="Address" class="form-label">Địa chỉ</label><textarea asp-for="Address" class="form-control customer-account-field" rows="2" readonly></textarea></div>
</div>
