@using Microsoft.AspNetCore.Mvc.ViewFeatures
@{
    Layout = "_AdminLayout";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Thống kê tổng quan</h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-tool" data-card-widget="collapse">
                        <i class="fas fa-minus"></i>
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-lg-3 col-6">
                        <div class="small-box bg-info">
                            <div class="inner">
                                <h3>@(ViewData["TotalUsers"] != null ? Convert.ToInt32(ViewData["TotalUsers"]) : 0)</h3>
                                <p>Người dùng</p>
                            </div>
                            <div class="icon">
                                <i class="ion ion-person-add"></i>
                            </div>
                            <a href="@Url.Action("Users", "Identity")" class="small-box-footer">Xem thêm <i class="fas fa-arrow-circle-right"></i></a>
                        </div>
                    </div>
                    <div class="col-lg-3 col-6">
                        <div class="small-box bg-success">
                            <div class="inner">
                                <h3>@(ViewData["TotalRoles"] != null ? Convert.ToInt32(ViewData["TotalRoles"]) : 0)</h3>
                                <p>Vai trò</p>
                            </div>
                            <div class="icon">
                                <i class="ion ion-person-stalker"></i>
                            </div>
                            <a href="@Url.Action("Roles", "Identity")" class="small-box-footer">Xem thêm <i class="fas fa-arrow-circle-right"></i></a>
                        </div>
                    </div>
                    <div class="col-lg-3 col-6">
                        <div class="small-box bg-warning">
                            <div class="inner">
                                <h3>@(ViewData["TotalPermissions"] != null ? Convert.ToInt32(ViewData["TotalPermissions"]) : 0)</h3>
                                <p>Quyền</p>
                            </div>
                            <div class="icon">
                                <i class="ion ion-locked"></i>
                            </div>
                            <a href="@Url.Action("Permissions", "Identity")" class="small-box-footer">Xem thêm <i class="fas fa-arrow-circle-right"></i></a>
                        </div>
                    </div>
                    <div class="col-lg-3 col-6">
                        <div class="small-box bg-danger">
                            <div class="inner">
                                <h3>@(ViewData["TotalStaff"] != null ? Convert.ToInt32(ViewData["TotalStaff"]) : 0)</h3>
                                <p>Nhân viên</p>
                            </div>
                            <div class="icon">
                                <i class="ion ion-person"></i>
                            </div>
                            <a href="@Url.Action("Staff", "Identity")" class="small-box-footer">Xem thêm <i class="fas fa-arrow-circle-right"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <partial name="~/Views/Admin/Partials/Dashboard/_ModuleCard.cshtml"
                 view-data='new ViewDataDictionary(ViewData)
                 {
                     ["CardTitle"] = "Identity",
                     ["CardIcon"] = "bi bi-shield-lock",
                     ["CardDescription"] = "Quản lý tài khoản, phân quyền và nhân sự nội bộ.",
                     ["CardLinkUrl"] = Url.Action("Customers", "Admin"),
                     ["CardLinkText"] = "Mở module",
                     ["CardThemeClass"] = "module-identity",
                     ["CardTags"] = new[] { "users", "roles", "permissions", "role_permissions", "staff", "veterinarians" }
                 }' />
</div>
    <div class="col-lg-6">
        <partial name="~/Views/Admin/Partials/Dashboard/_ModuleCard.cshtml"
                 view-data='new ViewDataDictionary(ViewData)
                 {
                     ["CardTitle"] = "PetCare",
                     ["CardIcon"] = "bi bi-heart",
                     ["CardDescription"] = "Hồ sơ thú cưng, hình ảnh, thông báo và trao đổi khách hàng.",
                     ["CardLinkUrl"] = Url.Action("Pets", "Admin"),
                     ["CardLinkText"] = "Mở module",
                     ["CardThemeClass"] = "module-petcare",
                     ["CardTags"] = new[] { "pets", "pet_images", "notifications", "feedbacks", "chat_conversations" }
                 }' />
</div>
    <div class="col-lg-6">
        <partial name="~/Views/Admin/Partials/Dashboard/_ModuleCard.cshtml"
                 view-data='new ViewDataDictionary(ViewData)
                 {
                     ["CardTitle"] = "Service & Medical",
                     ["CardIcon"] = "bi bi-clipboard2-pulse",
                     ["CardDescription"] = "Dịch vụ, lịch hẹn và hồ sơ y tế thú cưng.",
                     ["CardLinkUrl"] = Url.Action("Appointments", "Admin"),
                     ["CardLinkText"] = "Mở module",
                     ["CardThemeClass"] = "module-service",
                     ["CardTags"] = new[] { "services", "appointments", "appointment_services", "pet_health_records", "vaccination_records", "medical_prescriptions", "service_packages", "pet_packages" }
                 }' />
</div>
    <div class="col-lg-6">
        <partial name="~/Views/Admin/Partials/Dashboard/_ModuleCard.cshtml"
                 view-data='new ViewDataDictionary(ViewData)
                 {
                     ["CardTitle"] = "Commerce",
                     ["CardIcon"] = "bi bi-cart3",
                     ["CardDescription"] = "Quản lý kho, nhập hàng, bán hàng và thanh toán.",
                     ["CardLinkUrl"] = Url.Action("Orders", "Commerce"),
                     ["CardLinkText"] = "Mở module",
                     ["CardThemeClass"] = "module-commerce",
                     ["CardTags"] = new[] { "suppliers", "import_receipts", "import_details", "categories", "products", "carts", "cart_items", "orders", "order_items", "payments", "invoices" }
                 }' />
</div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Thống kê theo tháng</h3>
                <div class="card-tools">
                    <div class="input-group input-group-sm" style="width: 150px;">
                        <select class="form-control form-control-navbar">
                            <option selected>Tháng này</option>
                            <option>Tháng geç</option>
                            <option>3 tháng gần nhất</option>
                            <option>Năm nay</option>
                        </select>
                    </div>
                    <button type="button" class="btn btn-tool" data-card-widget="collapse">
                        <i class="fas fa-minus"></i>
                    </button>
                </div>
            </div>
            <div class="card-body">
                <canvas id="monthlyChart" style="min-height: 250px; height: 250px; max-height: 250px; max-width: 100%;"></canvas>
            </div>
        </div>
    </div>
</div>