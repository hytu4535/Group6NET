@model IEnumerable<PetManagementSystem.Models.Feedback>

@{
    Layout = "_AdminLayout";
    var currentPage = ViewData["Page"] is int pageValue ? pageValue : 1;
    var pageSize = ViewData["PageSize"] is int currentPageSize ? currentPageSize : 10;
    var totalItems = ViewData["TotalItems"] is int total ? total : 0;
    var totalPages = (int)Math.Ceiling(totalItems / (double)pageSize);
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Danh sách phản hồi</h5>
        <span class="text-muted small">@totalItems phản hồi</span>
    </div>
    <div class="card-body">
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success">@successMessage</div>
        }
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Khách hàng</th>
                        <th>Nội dung</th>
                        <th>Thời gian</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">Chưa có phản hồi nào.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var feedback in Model)
                        {
                            var isResolved = string.Equals(feedback.Status, "resolved", StringComparison.OrdinalIgnoreCase);
                            <tr>
                                <td>@feedback.Id</td>
                                <td><strong>@(feedback.User?.FullName ?? feedback.User?.Username ?? $"User #{feedback.UserId}")</strong></td>
                                <td class="text-break">@feedback.Comment</td>
                                <td>@feedback.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <span class="badge @(isResolved ? "text-bg-success" : "text-bg-warning")">
                                        @(isResolved ? "Đã xử lý" : "Chờ xử lý")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <form asp-action="UpdateFeedbackStatus" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@feedback.Id" />
                                        <input type="hidden" name="status" value="@(isResolved ? "pending" : "resolved")" />
                                        <input type="hidden" name="page" value="@currentPage" />
                                        <input type="hidden" name="pageSize" value="@pageSize" />
                                        <button type="submit"
                                                class="btn btn-sm @(isResolved ? "btn-outline-secondary" : "btn-success")">
                                            @(isResolved ? "Đổi thành chờ" : "Đánh dấu đã xử lý")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (totalPages > 1)
        {
            <nav class="mt-3" aria-label="Phân trang phản hồi">
                <ul class="pagination justify-content-center mb-0">
                    @for (var pageNumber = 1; pageNumber <= totalPages; pageNumber++)
                    {
                        <li class="page-item @(pageNumber == currentPage ? "active" : "")">
                            <a class="page-link" asp-controller="Admin" asp-action="Feedbacks" asp-route-page="@pageNumber"
                               asp-route-pageSize="@pageSize">@pageNumber</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>