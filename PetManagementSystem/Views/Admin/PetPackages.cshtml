@model List<PetManagementSystem.Models.PetPackage>
@{
    Layout = "_AdminLayout";
    var pets = ViewBag.Pets as List<PetManagementSystem.Models.Pet> ?? new();
    var activePetIds = ViewBag.ActivePetIds as List<int> ?? new();
    var servicePackages = ViewBag.ServicePackages as List<PetManagementSystem.Models.ServicePackage> ?? new();
}

<div class="d-flex justify-content-end mb-3">
    <button type="button" class="btn btn-primary rounded-3 px-3 py-2" data-bs-toggle="modal" data-bs-target="#petPackageModal" onclick="resetPetPackageForm()">
        <i class="bi bi-plus-circle me-1"></i> Tạo gói thú cưng
    </button>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @success
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Tên Thú Cưng</th>
                        <th>Chủ Thú Cưng</th>
                        <th>Tên Gói</th>
                        <th>Ngày Mua / Hạn</th>
                        <th>Trạng Thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int index = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@(index++)</td>
                                <td class="fw-semibold">@item.Pet?.Name</td>
                                <td>@(item.Pet?.User?.FullName ?? item.Pet?.User?.Username ?? "N/A")</td>
                                <td><span class="badge bg-secondary">@item.ServicePackage?.Name</span></td>
                                <td>
                                    <div>@item.StartDate.ToString("dd/MM/yyyy") &rarr; @item.EndDate.ToString("dd/MM/yyyy")</div>
                                </td>
                                <td>
                                    @if (item.Status == 1)
                                    {
                                        <span class="badge bg-success">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Hết hạn / Ngừng</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex gap-1 justify-content-end">
                                        <button type="button" class="btn btn-sm btn-outline-info" title="Xem chi tiết gói" onclick="viewPetPackageDetails(@item.Id)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-primary" title="Sửa" onclick="editPetPackage(@item.Id, @item.PetId, @item.PackageId, '@item.StartDate.ToString("yyyy-MM-dd")', '@item.EndDate.ToString("yyyy-MM-dd")', @item.Status)">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                        <form asp-action="DeletePetPackage" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bản ghi này?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">Chưa có gói dịch vụ nào được gán cho thú cưng.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Thêm/Sửa Gói Thú Cưng -->
<div class="modal fade" id="petPackageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="petPackageForm" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" id="petPackageId" name="Id" value="0" />
                <input type="hidden" id="hiddenPetId" name="PetId" value="" />
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold" id="petPackageModalTitle">Tạo gói cho thú cưng</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Thú cưng</label>
                        <select class="form-select" id="PetId" required>
                            <option value="">-- Chọn thú cưng --</option>
                            @foreach (var p in pets)
                            {
                                var isActive = activePetIds.Contains(p.Id);
                                <option value="@p.Id" data-active="@(isActive ? "1" : "0")">@p.Name (@p.Species)</option>
                            }
                        </select>
                        <span class="text-danger small" data-valmsg-for="PetId" data-valmsg-replace="true"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Gói dịch vụ</label>
                        <select class="form-select" id="PackageId" name="PackageId" required>
                            <option value="">-- Chọn gói dịch vụ --</option>
                            @foreach (var sp in servicePackages)
                            {
                                <option value="@sp.Id">@sp.Name (@sp.Price.ToString("N0") đ)</option>
                            }
                        </select>
                        <span class="text-danger small" data-valmsg-for="PackageId" data-valmsg-replace="true"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Ngày bắt đầu</label>
                            <input type="date" class="form-control" id="StartDate" name="StartDate" required />
                            <span class="text-danger small" data-valmsg-for="StartDate" data-valmsg-replace="true"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Ngày kết thúc</label>
                            <input type="date" class="form-control" id="EndDate" name="EndDate" required />
                            <span class="text-danger small" data-valmsg-for="EndDate" data-valmsg-replace="true"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Trạng thái</label>
                        <select class="form-select" id="PetPackageStatus" name="Status">
                            <option value="1">Hoạt động</option>
                            <option value="0">Hết hạn / Ngừng</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary">Lưu thông tin</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function resetPetPackageForm() {
            $('#petPackageForm').attr('action', '/Admin/CreatePetPackage');
            $('#petPackageId').val(0);
            $('#petPackageForm')[0].reset();
            
            // Enable pet dropdown and set name
            $('#PetId').prop('disabled', false).attr('name', 'PetId');
            $('#hiddenPetId').val('');

            $('#PetId option').each(function() {
                if ($(this).data('active') == '1' && $(this).val() !== '') {
                    $(this).hide();
                } else {
                    $(this).show();
                }
            });
            $('#PetId').val('');
            $('#petPackageForm button[type="submit"]').prop('disabled', false);
            $('[data-valmsg-for="PetId"]').text('');
            $('#StartDate').val(new Date().toISOString().split('T')[0]);
            let nextMonth = new Date();
            nextMonth.setMonth(nextMonth.getMonth() + 1);
            $('#EndDate').val(nextMonth.toISOString().split('T')[0]);
            $('#PetPackageStatus').val('1');
            $('#petPackageModalTitle').text('Tạo gói cho thú cưng');
        }

        function editPetPackage(id, petId, packageId, startDate, endDate, status) {
            $('#petPackageForm').attr('action', '/Admin/SavePetPackage');
            $('#petPackageId').val(id);

            // Disable pet dropdown and use hidden input
            $('#PetId option').show();
            $('#PetId').val(petId).removeAttr('name').prop('disabled', true);
            $('#hiddenPetId').val(petId);

            $('#PackageId').val(packageId);
            $('#StartDate').val(startDate);
            $('#EndDate').val(endDate);
            $('#PetPackageStatus').val(status);
            $('#petPackageForm button[type="submit"]').prop('disabled', false);
            $('[data-valmsg-for="PetId"]').text('');
            $('#petPackageModalTitle').text('Cập nhật gói dịch vụ thú cưng');
            new bootstrap.Modal('#petPackageModal').show();
        }

        $(document).ready(function() {
            $('#PetId').on('change', function() {
                var selectedOpt = $(this).find(':selected');
                $('#hiddenPetId').val($(this).val());
                if (selectedOpt.data('active') == '1') {
                    $('[data-valmsg-for="PetId"]').text('Thú cưng này đã có gói dịch vụ đang hoạt động!');
                    $('#petPackageForm button[type="submit"]').prop('disabled', true);
                } else {
                    $('[data-valmsg-for="PetId"]').text('');
                    $('#petPackageForm button[type="submit"]').prop('disabled', false);
                }
            });

            $('#petPackageForm').on('submit', function (e) {
                e.preventDefault();
                var selectedOpt = $('#PetId').find(':selected');
                if (!$('#PetId').prop('disabled') && selectedOpt.data('active') == '1') {
                    $('[data-valmsg-for="PetId"]').text('Thú cưng này đã có gói dịch vụ đang hoạt động!');
                    return false;
                }
                if (!$(this).valid()) {
                    return false;
                }
                var form = $(this);
                $.ajax({
                    type: 'POST',
                    url: form.attr('action'),
                    data: form.serialize(),
                    success: function (res) {
                        if (res && res.success === false) {
                            alert(res.message);
                        } else {
                            location.reload();
                        }
                    },
                    error: function (xhr) {
                        if (xhr.responseJSON) {
                            if (xhr.responseJSON.message) {
                                alert(xhr.responseJSON.message);
                            } else if (xhr.responseJSON.errors) {
                                var errors = xhr.responseJSON.errors;
                                $('.text-danger.small').text('');
                                for (var key in errors) {
                                    var msg = Array.isArray(errors[key]) ? errors[key][0] : errors[key];
                                    $('[data-valmsg-for="' + key + '"]').text(msg);
                                }
                            }
                        } else {
                            location.reload();
                        }
                    }
                });
            });

            @if (ViewBag.ShowModal != null)
            {
                <text>
                new bootstrap.Modal('#@ViewBag.ShowModal').show();
                </text>
            }
        });

        function viewPetPackageDetails(id) {
            $.get('/Admin/GetPetPackageDetails/' + id, function(res) {
                if (res.success) {
                    $('#detailPetName').text(res.petName + ' (' + res.species + ')');
                    $('#detailOwnerName').text(res.ownerName);
                    $('#detailPackageName').text(res.packageName);
                    $('#detailStatus').html(res.status === 'Hoạt động' ? '<span class="badge bg-success">Hoạt động</span>' : '<span class="badge bg-secondary">' + res.status + '</span>');
                    $('#detailDateRange').text(res.startDate + ' -> ' + res.endDate);

                    var tbody = $('#detailServicesTableBody');
                    tbody.empty();
                    if (res.services && res.services.length > 0) {
                        res.services.forEach(function(s, idx) {
                            tbody.append(
                                '<tr>' +
                                '<td>' + (idx + 1) + '</td>' +
                                '<td><strong>' + s.name + '</strong></td>' +
                                '<td>' + s.duration + ' phút</td>' +
                                '<td class="text-success fw-bold">' + s.price.toLocaleString('vi-VN') + ' đ</td>' +
                                '</tr>'
                            );
                        });
                    } else {
                        tbody.append('<tr><td colspan="4" class="text-center text-muted">Không có dịch vụ thành phần nào trong gói này.</td></tr>');
                    }

                    new bootstrap.Modal('#petPackageDetailModal').show();
                } else {
                    alert(res.message || 'Không thể lấy thông tin chi tiết gói.');
                }
            });
        }
    </script>
}

<!-- Modal Chi tiết Gói Dịch Vụ Thú Cưng -->
<div class="modal fade" id="petPackageDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold">Chi tiết gói dịch vụ của thú cưng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <p><strong>Thú cưng:</strong> <span id="detailPetName" class="text-primary fw-semibold"></span></p>
                        <p><strong>Chủ sở hữu:</strong> <span id="detailOwnerName"></span></p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Tên gói:</strong> <span id="detailPackageName" class="badge bg-secondary"></span></p>
                        <p><strong>Trạng thái:</strong> <span id="detailStatus"></span></p>
                        <p><strong>Thời hạn:</strong> <span id="detailDateRange"></span></p>
                    </div>
                </div>
                <h6 class="fw-bold text-success border-bottom pb-2">Danh sách dịch vụ thành phần trong gói</h6>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Tên dịch vụ</th>
                                <th>Thời lượng</th>
                                <th>Giá gốc</th>
                            </tr>
                        </thead>
                        <tbody id="detailServicesTableBody">
                            <tr><td colspan="4" class="text-center text-muted">Đang tải...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>
