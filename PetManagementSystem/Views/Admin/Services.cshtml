@model List<PetManagementSystem.Models.Service>
@{
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-end mb-3">
    <button type="button" class="btn btn-primary rounded-3 px-3 py-2" data-bs-toggle="modal" data-bs-target="#serviceModal" onclick="resetServiceForm()">
        <i class="bi bi-plus-circle me-1"></i> Tạo dịch vụ
    </button>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @success
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Tên dịch vụ</th>
                        <th>Mô tả</th>
                        <th>Giá</th>
                        <th>Thời lượng</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int index = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@(index++)</td>
                                <td class="fw-semibold">@item.Name</td>
                                <td>@item.Description</td>
                                <td class="text-primary fw-bold">@item.Price.ToString("N0") đ</td>
                                <td>@item.DurationMinutes phút</td>
                                <td>
                                    @if (item.Status == 1)
                                    {
                                        <span class="badge bg-success">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Ngừng hoạt động</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex gap-1 justify-content-end">
                                        <button class="btn btn-sm btn-outline-primary" title="Sửa" onclick="editService(@item.Id, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(item.Name))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(item.Description ?? ""))', @item.Price, @item.DurationMinutes, @item.Status)">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                        <form asp-action="DeleteService" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa dịch vụ này?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">Chưa có dịch vụ nào trong hệ thống.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Thêm/Sửa Dịch vụ -->
<div class="modal fade" id="serviceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="serviceForm" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" id="serviceId" name="Id" value="0" />
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold" id="serviceModalTitle">Tạo dịch vụ mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Tên dịch vụ</label>
                        <input type="text" class="form-control" id="ServiceName" name="Name" required />
                        <span class="text-danger small" data-valmsg-for="Name" data-valmsg-replace="true"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Mô tả</label>
                        <textarea class="form-control" id="ServiceDescription" name="Description" rows="3"></textarea>
                        <span class="text-danger small" data-valmsg-for="Description" data-valmsg-replace="true"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Giá (VNĐ)</label>
                            <input type="number" step="1000" class="form-control" id="ServicePrice" name="Price" required />
                            <span class="text-danger small" data-valmsg-for="Price" data-valmsg-replace="true"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Thời lượng (phút)</label>
                            <input type="number" class="form-control" id="ServiceDuration" name="DurationMinutes" required />
                            <span class="text-danger small" data-valmsg-for="DurationMinutes" data-valmsg-replace="true"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Trạng thái</label>
                        <select class="form-select" id="ServiceStatus" name="Status">
                            <option value="1">Hoạt động</option>
                            <option value="0">Ngừng hoạt động</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary">Lưu dịch vụ</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function resetServiceForm() {
            $('#serviceForm').attr('action', '/Admin/CreateService');
            $('#serviceId').val(0);
            $('#serviceForm')[0].reset();
            $('#ServiceStatus').val('1');
            $('#serviceModalTitle').text('Tạo dịch vụ mới');
            $('.text-danger').text('');
        }

        function editService(id, name, desc, price, duration, status) {
            $('#serviceForm').attr('action', '/Admin/SaveService');
            $('#serviceId').val(id);
            $('#ServiceName').val(name);
            $('#ServiceDescription').val(desc);
            $('#ServicePrice').val(price);
            $('#ServiceDuration').val(duration);
            $('#ServiceStatus').val(status);
            $('#serviceModalTitle').text('Cập nhật dịch vụ');
            $('.text-danger').text('');
            new bootstrap.Modal('#serviceModal').show();
        }

        $(document).ready(function() {
            $('#serviceForm').on('submit', function (e) {
                e.preventDefault();
                if (!$(this).valid()) {
                    return false;
                }
                var form = $(this);
                $.ajax({
                    type: 'POST',
                    url: form.attr('action'),
                    data: form.serialize(),
                    success: function (res) {
                        location.reload();
                    },
                    error: function (xhr) {
                        if (xhr.responseJSON && xhr.responseJSON.errors) {
                            var errors = xhr.responseJSON.errors;
                            $('.text-danger.small').text('');
                            for (var key in errors) {
                                var msg = Array.isArray(errors[key]) ? errors[key][0] : errors[key];
                                $('[data-valmsg-for="' + key + '"]').text(msg);
                            }
                        } else {
                            location.reload();
                        }
                    }
                });
            });

            @if (ViewBag.ShowModal != null)
            {
                <text>
                new bootstrap.Modal('#@ViewBag.ShowModal').show();
                </text>
            }
        });
    </script>
}
