@{
    Layout = "_AdminLayout";
}

<partial name="~/Views/Admin/Partials/Shared/_ModuleSummary.cshtml"
         view-data='new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData)
         {
             ["SummaryTitle"] = "Service & Medical: Services / Packages",
             ["SummaryDescription"] = "Bảng liên quan: services, service_packages, pet_packages.",
             ["SummaryThemeClass"] = "module-summary-service"
         }' />

<div class="row g-3">
    <div class="col-md-4">
        <div class="card-panel h-100">
            <h5 class="mb-2">Gói Cơ bản</h5>
            <p class="text-muted small">Tắm + vệ sinh tai, cắt móng cho thú cưng.</p>
            <h4 class="text-warning">150.000đ</h4>
            <span class="badge badge-status-active mb-3">Đang áp dụng</span>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-primary w-100"><i class="bi bi-pencil-square"></i> Sửa</button>
                <button class="btn btn-sm btn-outline-danger w-100"><i class="bi bi-trash"></i> Xóa</button>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-panel h-100">
            <h5 class="mb-2">Gói Spa Cao cấp</h5>
            <p class="text-muted small">Tắm sữa tắm chuyên dụng, tỉa lông tạo kiểu, xịt thơm.</p>
            <h4 class="text-warning">350.000đ</h4>
            <span class="badge badge-status-active mb-3">Đang áp dụng</span>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-primary w-100"><i class="bi bi-pencil-square"></i> Sửa</button>
                <button class="btn btn-sm btn-outline-danger w-100"><i class="bi bi-trash"></i> Xóa</button>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-panel h-100">
            <h5 class="mb-2">Khám sức khỏe định kỳ</h5>
            <p class="text-muted small">Khám tổng quát, tư vấn dinh dưỡng, tiêm phòng.</p>
            <h4 class="text-warning">250.000đ</h4>
            <span class="badge badge-status-inactive mb-3">Tạm ngưng</span>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-primary w-100"><i class="bi bi-pencil-square"></i> Sửa</button>
                <button class="btn btn-sm btn-outline-danger w-100"><i class="bi bi-trash"></i> Xóa</button>
            </div>
        </div>
    </div>
</div>

<div class="text-end mt-3">
    <button class="btn btn-warning text-white"><i class="bi bi-plus-lg"></i> Thêm gói dịch vụ</button>
</div>
