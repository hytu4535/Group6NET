@{
    Layout = "_AdminLayout";
}

<div class="card-panel">
    <div class="card-panel-header">
        <h5>Phản hồi từ khách hàng</h5>
    </div>
    <div class="table-responsive">
        <table class="table table-admin table-hover align-middle">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Khách hàng</th>
                    <th>Nội dung</th>
                    <th>Đánh giá</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>1</td>
                    <td>Nguyễn Văn A</td>
                    <td>Dịch vụ tắm cho bé Milo rất tốt, nhân viên thân thiện.</td>
                    <td class="text-warning">★★★★★</td>
                    <td><span class="badge badge-status-active">Đã xử lý</span></td>
                    <td><button class="btn btn-sm btn-outline-primary"><i class="bi bi-reply-fill"></i> Trả lời</button></td>
                </tr>
                <tr>
                    <td>2</td>
                    <td>Trần Thị B</td>
                    <td>Đặt lịch dễ dàng, mong có thêm ưu đãi.</td>
                    <td class="text-warning">★★★★</td>
                    <td><span class="badge badge-status-pending">Chờ xử lý</span></td>
                    <td><button class="btn btn-sm btn-outline-primary"><i class="bi bi-reply-fill"></i> Trả lời</button></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
