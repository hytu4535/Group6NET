@{
    Layout = "_AdminLayout";
}

<div class="card-panel">
    <div class="card-panel-header">
        <h5>Danh sách Thú cưng</h5>
        <button class="btn btn-warning text-white" type="button" data-bs-toggle="modal" data-bs-target="#petModal">
            <i class="bi bi-plus-lg"></i> Thêm thú cưng
        </button>
    </div>
    <div class="table-responsive">
        <table class="table table-admin table-hover align-middle">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Ảnh</th>
                    <th>Tên</th>
                    <th>Loài</th>
                    <th>Giống</th>
                    <th>Ngày sinh</th>
                    <th>Cân nặng</th>
                    <th>Chủ nuôi</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>1</td>
                    <td><i class="bi bi-image text-muted fs-4"></i></td>
                    <td>Milo</td>
                    <td>Chó</td>
                    <td>Poodle</td>
                    <td>12/03/2022</td>
                    <td>4.5 kg</td>
                    <td>Nguyễn Văn A</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil-square"></i></button>
                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                    </td>
                </tr>
                <tr>
                    <td>2</td>
                    <td><i class="bi bi-image text-muted fs-4"></i></td>
                    <td>Kitty</td>
                    <td>Mèo</td>
                    <td>Anh lông ngắn</td>
                    <td>05/07/2021</td>
                    <td>3.8 kg</td>
                    <td>Trần Thị B</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil-square"></i></button>
                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                    </td>
                </tr>
                <tr>
                    <td>3</td>
                    <td><i class="bi bi-image text-muted fs-4"></i></td>
                    <td>Lucky</td>
                    <td>Chó</td>
                    <td>Corgi</td>
                    <td>20/01/2023</td>
                    <td>9.2 kg</td>
                    <td>Lê Văn C</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil-square"></i></button>
                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal thêm/sửa thú cưng -->
<div class="modal fade" id="petModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm thú cưng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="mb-3">
                        <label class="form-label">Tên thú cưng</label>
                        <input type="text" class="form-control" placeholder="Nhập tên" />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Loài</label>
                            <select class="form-select">
                                <option>Chó</option>
                                <option>Mèo</option>
                                <option>Khác</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Giống</label>
                            <input type="text" class="form-control" placeholder="Nhập giống" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Ngày sinh</label>
                            <input type="date" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Cân nặng (kg)</label>
                            <input type="number" step="0.1" class="form-control" placeholder="0.0" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Chủ nuôi</label>
                        <select class="form-select">
                            <option>Nguyễn Văn A</option>
                            <option>Trần Thị B</option>
                            <option>Lê Văn C</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-warning text-white">Lưu</button>
            </div>
        </div>
    </div>
</div>
