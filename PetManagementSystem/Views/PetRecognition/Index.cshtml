@{
    ViewData["Title"] = "Nhận diện thú cưng";
    Layout = "_AdminLayout";
    var selectedPetId = ViewData["PetId"];
}

<style>
    .pr-page {
        --pr-ink: #172b4d;
        --pr-muted: #718096;
        --pr-line: #e6ebf2;
        --pr-soft: #f6f8fb;
        --pr-green: #138a72;
        --pr-green-dark: #0d705c;
        --pr-orange: #f0932b;
        max-width: 1540px;
        margin: 0 auto;
        color: var(--pr-ink);
    }
    .pr-page,.pr-page * { box-sizing: border-box; }
    .pr-intro {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        max-width: 1540px;
        margin: 0 auto 18px;
    }
    .pr-intro h1 {
        margin: 0;
        color: #172b4d;
        font-size: clamp(22px, 2.2vw, 28px);
        font-weight: 800;
        letter-spacing: -.02em;
    }
    .pr-intro p {
        max-width: 850px;
        margin: 5px 0 0;
        color: #718096;
        font-size: 13px;
        line-height: 1.6;
    }
    @@media (max-width: 560px) {
        .pr-intro { align-items: flex-start; flex-direction: column; }
    }
    .pr-hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin: 0 0 22px;
        padding: 22px 26px;
        color: #fff;
        background: linear-gradient(118deg, #173b4a 0%, #126d68 58%, #168b72 100%);
        border-radius: 18px;
        box-shadow: 0 12px 28px rgba(23, 59, 74, .16);
        overflow: hidden;
        position: relative;
    }
    .pr-hero:after {
        content: "";
        position: absolute;
        width: 230px;
        height: 230px;
        right: 9%;
        top: -145px;
        border: 1px solid rgba(255,255,255,.14);
        border-radius: 50%;
        box-shadow: 0 0 0 28px rgba(255,255,255,.035), 0 0 0 58px rgba(255,255,255,.025);
        pointer-events: none;
    }
    .pr-hero-copy,.pr-status { position: relative; z-index: 1; }
    .pr-kicker { font-size: 11px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: #b5eee0; }
    .pr-hero h2 { font-size: clamp(22px, 2.5vw, 29px); font-weight: 800; letter-spacing: -.03em; margin: 6px 0; }
    .pr-hero p { max-width: 760px; margin: 0; color: rgba(255,255,255,.8); font-size: 13px; line-height: 1.65; }
    .pr-status { display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; border: 1px solid rgba(255,255,255,.24); background: rgba(255,255,255,.12); border-radius: 999px; padding: 10px 14px; font-size: 12px; font-weight: 700; }
    .pr-grid { display: grid; grid-template-columns: minmax(0, .88fr) minmax(0, 1.32fr); gap: 20px; align-items: start; }
    .pr-page.camera-first .pr-grid { grid-template-columns: minmax(0, 1fr); }
    .pr-page.camera-first #resultsPanel { display: none; }
    .pr-page.camera-first .pr-camera { aspect-ratio: 16/7; min-height: 320px; max-height: 540px; }
    .pr-page.confirmed-mode .pr-grid { display: none; }
    .pr-page.results-mode .pr-grid { grid-template-columns: minmax(280px, .7fr) minmax(0, 1.3fr); }
    .pr-page.results-mode #resultsPanel { display: block; }
    .pr-panel { min-width: 0; overflow: hidden; background: #fff; border: 1px solid var(--pr-line); border-radius: 16px; box-shadow: 0 5px 18px rgba(25,42,70,.045); }
    .pr-panel-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; padding: 18px 20px; border-bottom: 1px solid var(--pr-line); }
    .pr-panel-title { display: flex; align-items: flex-start; gap: 11px; }
    .pr-panel-icon { flex: 0 0 38px; width: 38px; height: 38px; display: grid; place-items: center; color: var(--pr-green); background: #e9f7f2; border-radius: 11px; font-size: 17px; }
    .pr-panel-head h3 { margin: 1px 0 4px; font-size: 15px; font-weight: 800; }
    .pr-panel-head p { margin: 0; color: var(--pr-muted); font-size: 12px; line-height: 1.5; }
    .pr-panel-body { padding: 18px 20px 20px; }
    .pr-tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 5px; margin-bottom: 14px; padding: 4px; background: var(--pr-soft); border-radius: 11px; }
    .pr-tab { min-height: 39px; border: 0; border-radius: 8px; background: transparent; color: #65758b; font-size: 12px; font-weight: 750; cursor: pointer; transition: .18s ease; }
    .pr-tab:hover { color: var(--pr-green-dark); }
    .pr-tab.active { color: var(--pr-green-dark); background: #fff; box-shadow: 0 2px 7px rgba(23,43,77,.09); }
    .pr-camera { position: relative; display: flex; align-items: center; justify-content: center; overflow: hidden; aspect-ratio: 4/3; min-height: 220px; max-height: 440px; color: #fff; background: radial-gradient(ellipse at 50% 45%, #223f48, #152a34 72%); border: 1px solid #263f48; border-radius: 13px; }
    .pr-camera:before { content: ""; position: absolute; inset: 16px; border: 1px solid rgba(255,255,255,.09); border-radius: 10px; pointer-events: none; }
    .pr-camera video,.pr-camera img { position: relative; z-index: 1; width: 100%; height: 100%; object-fit: contain; display: block; }
    .pr-camera-placeholder { position: relative; z-index: 1; max-width: 320px; padding: 20px; text-align: center; color: #d8e7e8; }
    .pr-placeholder-icon { display: grid; place-items: center; width: 56px; height: 56px; margin: 0 auto 12px; color: #bcece0; background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.12); border-radius: 17px; font-size: 23px; }
    .pr-camera-placeholder strong { display: block; margin-bottom: 5px; color: #fff; font-size: 14px; }
    .pr-camera-placeholder span { display: block; font-size: 12px; line-height: 1.6; color: #b8cbce; }
    .pr-camera-actions { display: flex; gap: 8px; margin-top: 12px; }
    .pr-btn { display: inline-flex; align-items: center; justify-content: center; gap: 7px; min-height: 38px; padding: 9px 12px; border: 1px solid var(--pr-line); border-radius: 9px; background: #fff; color: var(--pr-ink); font-size: 12px; font-weight: 750; cursor: pointer; text-decoration: none; transition: background .16s ease, border-color .16s ease, transform .16s ease; }
    .pr-btn:hover { border-color: #bad8ce; background: #f8fcfa; color: var(--pr-green-dark); transform: translateY(-1px); }
    .pr-btn:disabled { opacity: .55; cursor: not-allowed; transform: none; }
    .pr-btn-primary { color: #fff; background: var(--pr-green); border-color: var(--pr-green); }
    .pr-btn-primary:hover { color: #fff; background: var(--pr-green-dark); border-color: var(--pr-green-dark); }
    .pr-camera-actions .pr-btn { flex: 1; }
    .pr-btn-block { width: 100%; min-height: 44px; margin-top: 12px; font-size: 13px; }
    .pr-file-label { display: flex; align-items: center; justify-content: center; gap: 9px; min-height: 48px; margin-top: 12px; padding: 11px 14px; border: 1px dashed #b5c9c4; border-radius: 11px; background: #f8fbfa; color: #355f56; font-size: 12px; font-weight: 750; cursor: pointer; transition: .16s ease; }
    .pr-file-label:hover { border-color: var(--pr-green); background: #f0faf6; }
    .pr-file-label > i { color: var(--pr-green); font-size: 17px; }
    .pr-file-label input { display: none; }
    .pr-file-info { min-height: 18px; margin-top: 8px; color: var(--pr-muted); font-size: 11px; overflow-wrap: anywhere; }
    .pr-help { display: flex; align-items: flex-start; gap: 8px; margin-top: 14px; padding: 11px 12px; border: 1px solid #edf0f4; border-radius: 10px; background: #fafbfd; color: var(--pr-muted); font-size: 11px; line-height: 1.55; }
    .pr-help i { flex: 0 0 auto; margin-top: 1px; color: var(--pr-orange); }
    .pr-notice { display: none; margin-bottom: 13px; padding: 10px 12px; border-radius: 9px; font-size: 12px; line-height: 1.5; }
    .pr-notice.show { display: block; }
    .pr-notice.error { color: #9e3037; background: #fff2f1; border: 1px solid #f5d3d1; }
    .pr-notice.success { color: #176c50; background: #effaf5; border: 1px solid #ccebdc; }
    .pr-notice.warning { color: #8a4b08; background: #fff7e8; border: 1px solid #f1d29d; }
    .pr-notice.info { color: #275f8a; background: #f0f7fd; border: 1px solid #d7e9f7; }
    .pr-tools { display: flex; align-items: center; gap: 8px; margin-bottom: 15px; }
    .pr-search { display: flex; flex: 1; align-items: center; gap: 9px; min-width: 150px; padding: 0 11px; border: 1px solid #dfe6ee; border-radius: 9px; background: #fff; }
    .pr-search:focus-within { border-color: #76bba8; box-shadow: 0 0 0 3px rgba(19,138,114,.09); }
    .pr-search i { color: #8695a7; }
    .pr-search input { width: 100%; min-width: 0; padding: 11px 0; border: 0; outline: 0; background: transparent; color: var(--pr-ink); font-size: 12px; }
    .pr-search input::placeholder { color: #98a4b3; }
    .pr-search-btn { white-space: nowrap; }
    .pr-count { flex: 0 0 auto; padding: 7px 9px; border-radius: 8px; background: #edf7f3; color: #236e59; font-size: 11px; font-weight: 800; white-space: nowrap; }
    .pr-results-meta { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 11px; }
    .pr-results-meta strong { font-size: 13px; }
    .pr-results-meta span { color: var(--pr-muted); font-size: 11px; text-align: right; }
    .pr-candidates { display: flex; flex-direction: column; gap: 9px; }
    .pr-candidate { display: grid; grid-template-columns: 58px minmax(0,1fr) auto; gap: 11px; align-items: center; padding: 11px; border: 1px solid var(--pr-line); border-radius: 12px; transition: .15s ease; }
    .pr-candidate:hover { border-color: #b7d9cc; background: #fcfefd; }
    .pr-candidate.selected { border-color: var(--pr-green); box-shadow: 0 0 0 2px #d8f0e6; background: #f8fcfa; }
    .pr-avatar { width: 58px; height: 58px; border-radius: 11px; object-fit: cover; display: flex; align-items: center; justify-content: center; color: #8aa098; background: #edf3f0; font-size: 21px; }
    .pr-candidate-main { min-width: 0; }
    .pr-candidate-heading { display: flex; align-items: center; flex-wrap: wrap; gap: 7px; margin-bottom: 4px; }
    .pr-pet-name { margin: 0; font-size: 15px; font-weight: 800; overflow-wrap: anywhere; }
    .pr-pet-id { padding: 3px 7px; border-radius: 6px; background: #f1f4f8; color: #617087; font-size: 10px; font-weight: 700; }
    .pr-sub,.pr-owner { color: var(--pr-muted); font-size: 11px; line-height: 1.5; overflow-wrap: anywhere; }
    .pr-owner-card { margin-top: 8px; padding: 8px 10px; border: 1px solid #e9eef3; border-radius: 9px; background: #fafbfd; }
    .pr-owner-label { display: block; margin-bottom: 2px; color: #8491a2; font-size: 9px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
    .pr-owner-name { display: block; color: #243750; font-size: 13px; font-weight: 800; line-height: 1.4; overflow-wrap: anywhere; }
    .pr-owner-contact { margin-top: 3px; color: #627188; font-size: 10px; line-height: 1.5; overflow-wrap: anywhere; }
    .pr-owner-contact i { margin-right: 4px; color: #8292a4; }
    .pr-candidate-actions { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; }
    .pr-score { padding: 6px 8px; border: 1px solid transparent; border-radius: 8px; font-size: 15px; font-weight: 800; text-align: center; white-space: nowrap; }
    .pr-score-success { border-color: #a7f3d0; background: #ecfdf5; color: #047857; }
    .pr-score-warning { border-color: #fde68a; background: #fffbeb; color: #b45309; }
    .pr-score-danger { border-color: #fecdd3; background: #fff1f2; color: #be123c; }
    .pr-score-secondary { border-color: #e2e8f0; background: #f8fafc; color: #64748b; }
    .pr-score small { display: block; margin-top: 2px; color: inherit; font-size: 9px; font-weight: 600; opacity: .8; }
    .pr-select-btn { min-height: 34px; padding: 7px 10px; font-size: 11px; }
    .pr-empty { padding: 28px 18px; border: 1px dashed #d7e3de; border-radius: 12px; color: var(--pr-muted); text-align: center; }
    .pr-empty > i { display: block; margin-bottom: 9px; color: #9bb5ab; font-size: 26px; }
    .pr-empty strong { display: block; margin-bottom: 5px; color: #39534b; font-size: 13px; }
    .pr-empty p { margin: 0; font-size: 11px; line-height: 1.6; }
    .pr-footer { margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--pr-line); color: var(--pr-muted); font-size: 10px; line-height: 1.6; }
    .pr-confirm-box { display: none; margin-top: 12px; padding: 13px; border: 1px solid #cfe5dc; border-radius: 11px; background: #f4fbf7; }
    .pr-confirm-box.show { display: block; }
    .pr-confirm-title { margin-bottom: 4px; font-size: 12px; font-weight: 800; }
    .pr-confirm-desc { margin-bottom: 10px; color: var(--pr-muted); font-size: 11px; line-height: 1.5; }
    .pr-confirm-box .pr-btn { width: 100%; }
    .pr-modal-pet { display: flex; align-items: center; gap: 14px; padding: 14px; border: 1px solid var(--pr-line); border-radius: 12px; background: #f8fafc; }
    .pr-modal-pet .pr-avatar { flex: 0 0 68px; width: 68px; height: 68px; }
    .pr-modal-pet-name { margin: 0 0 4px; color: var(--pr-ink); font-size: 16px; font-weight: 800; }
    .pr-modal-pet-owner { margin: 0; color: #53647b; font-size: 12px; line-height: 1.5; }
    .pr-compare-images { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12px; }
    .pr-compare-image { min-width: 0; margin: 0; }
    .pr-compare-image img,.pr-compare-placeholder { display: grid; width: 100%; height: 190px; place-items: center; border: 1px solid var(--pr-line); border-radius: 11px; background: #f6f8fb; object-fit: contain; color: #8190a0; }
    .pr-compare-image .pr-avatar { width: 100%; height: 190px; border: 1px solid var(--pr-line); border-radius: 11px; object-fit: contain; }
    .pr-compare-image figcaption { margin-top: 6px; color: var(--pr-muted); font-size: 11px; font-weight: 700; text-align: center; }
    .pr-confirm-details { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .pr-confirm-detail { min-width: 0; padding: 10px 12px; border: 1px solid var(--pr-line); border-radius: 10px; background: #fff; }
    .pr-confirm-detail small { display: block; margin-bottom: 3px; color: #718096; font-size: 10px; font-weight: 700; text-transform: uppercase; }
    .pr-confirm-detail strong { overflow-wrap: anywhere; }
    .pr-low-confidence-warning { padding: 11px 12px; border: 1px solid #dc3545; border-radius: 10px; background: #fff1f1; color: #842029; font-size: 12px; line-height: 1.5; }
    .pr-low-confidence-ack { padding: 11px 12px; border: 1px solid #dc3545; border-radius: 10px; background: #fffafa; color: #842029; font-size: 12px; line-height: 1.5; }
    .pr-low-confidence-ack .form-check-input { border-color: #dc3545; }
    #confirmCandidateModal { --pr-ink: #172b4d; --pr-line: #e6ebf2; --pr-green: #138a72; --pr-green-dark: #0d705c; }
    #confirmCandidateModal .modal-footer { display: flex; justify-content: flex-end; gap: 10px; flex-wrap: nowrap; }
    #confirmCandidateModal .pr-btn { min-height: 42px; padding: 10px 16px; font-size: 13px; }
    #confirmCandidateModal .pr-btn-primary { min-width: 175px; }
    .pr-service-panel { margin-top: 20px; padding: 20px; border: 1px solid var(--pr-line); border-radius: 16px; background: #fff; box-shadow: 0 5px 18px rgba(25,42,70,.045); }
    .pr-service-panel[hidden] { display: none; }
    .pr-service-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 14px; margin-bottom: 15px; }
    .pr-service-header h3 { margin: 0 0 4px; font-size: 16px; font-weight: 800; }
    .pr-service-header p { margin: 0; color: var(--pr-muted); font-size: 12px; line-height: 1.5; }
    .pr-service-pet { flex: 0 0 auto; padding: 8px 11px; border-radius: 9px; background: #edf7f3; color: #236e59; font-size: 11px; font-weight: 750; }
    .pr-service-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 11px; }
    .pr-service-link { display: flex; align-items: flex-start; gap: 11px; min-height: 94px; padding: 13px; border: 1px solid var(--pr-line); border-radius: 12px; color: var(--pr-ink); text-decoration: none; transition: .16s ease; }
    .pr-service-link:hover { transform: translateY(-2px); border-color: #a8d4c4; background: #fbfefd; color: var(--pr-green-dark); box-shadow: 0 5px 15px rgba(23,43,77,.06); }
    .pr-service-icon { flex: 0 0 36px; width: 36px; height: 36px; display: grid; place-items: center; border-radius: 10px; background: #e9f7f2; color: var(--pr-green); font-size: 16px; }
    .pr-service-link strong { display: block; margin: 1px 0 4px; font-size: 12px; font-weight: 800; }
    .pr-service-link small { display: block; color: var(--pr-muted); font-size: 10px; line-height: 1.5; }
    .pr-spinner { display: inline-block; width: 16px; height: 16px; border: 2px solid #cde5dc; border-top-color: var(--pr-green); border-radius: 50%; animation: prspin .7s linear infinite; }
    @@keyframes prspin { to { transform: rotate(360deg); } }
    @@media (max-width: 1100px) {
        .pr-page.results-mode .pr-grid { grid-template-columns: minmax(250px,.72fr) minmax(0,1.28fr); }
        .pr-tools { flex-wrap: wrap; }
        .pr-search { flex-basis: 100%; }
    }
    @@media (max-width: 850px) {
        .pr-page.results-mode .pr-grid,.pr-grid { grid-template-columns: 1fr; }
        .pr-page.camera-first .pr-camera { aspect-ratio: 4/3; min-height: 260px; max-height: 62vh; }
        .pr-page.results-mode .pr-camera { min-height: 200px; max-height: 340px; }
    }
    @@media (max-width: 560px) {
        .pr-hero { align-items: flex-start; flex-direction: column; padding: 19px; }
        .pr-hero:after { right: -90px; }
        .pr-panel-head { padding: 15px; }
        .pr-panel-body { padding: 14px; }
        .pr-candidate { grid-template-columns: 50px minmax(0,1fr); gap: 9px; }
        .pr-avatar { width: 50px; height: 50px; }
        .pr-candidate-actions { grid-column: 2; flex-direction: row; align-items: center; flex-wrap: wrap; }
        .pr-results-meta { align-items: flex-start; flex-direction: column; gap: 3px; }
        .pr-results-meta span { text-align: left; }
        .pr-camera-actions .pr-btn { padding: 9px 6px; font-size: 11px; }
        .pr-search-btn { flex: 0 0 auto; }
        .pr-service-panel { padding: 15px; }
        .pr-service-header { flex-direction: column; }
        .pr-service-grid { grid-template-columns: 1fr; }
        .pr-compare-images,.pr-confirm-details { grid-template-columns: 1fr; }
    }
</style>

<div hidden>@Html.AntiForgeryToken()</div>

<header class="pr-intro">
    <div>
        <h1>Nhận diện cá thể thú cưng</h1>
        <p>Hệ thống ứng dụng AI sinh trắc học và trích xuất đặc trưng để xác định danh tính thú cưng, tra cứu hồ sơ và hỗ trợ tìm kiếm thất lạc.</p>
    </div>
    <a class="pr-btn" asp-controller="PetRecognition" asp-action="History">
        <i class="bi bi-clock-history"></i> Lịch sử nhận diện
    </a>
</header>

<div class="pr-page camera-first" id="petRecognitionPage">
    <div class="pr-grid">
        <section class="pr-panel" id="cameraPanel">
            <div class="pr-panel-head">
                <div class="pr-panel-title">
                    <span class="pr-panel-icon"><i class="bi bi-camera"></i></span>
                    <div>
                        <h3 id="cameraPanelTitle">Ảnh đầu vào</h3>
                        <p>Chụp trực tiếp hoặc chọn ảnh rõ mặt thú cưng.</p>
                    </div>
                </div>
            </div>
            <div class="pr-panel-body">
                <div class="pr-tabs" role="tablist" aria-label="Chọn nguồn ảnh">
                    <button type="button" class="pr-tab active" id="cameraTab"><i class="bi bi-camera-video me-1"></i> Camera trực tiếp</button>
                    <button type="button" class="pr-tab" id="uploadTab"><i class="bi bi-image me-1"></i> Tải ảnh lên</button>
                </div>

                <div class="pr-camera" id="cameraStage">
                    <div class="pr-camera-placeholder" id="cameraPlaceholder">
                        <div class="pr-placeholder-icon"><i class="bi bi-camera-video"></i></div>
                        <strong>Sẵn sàng nhận diện</strong>
                        <span>Bật camera để chụp ngay hoặc chọn một ảnh có sẵn từ thiết bị.</span>
                    </div>
                    <video id="cameraVideo" autoplay playsinline muted style="display:none"></video>
                    <img id="capturedPreview" alt="Ảnh thú cưng đã chọn" style="display:none" />
                </div>

                <div class="pr-camera-actions" id="cameraActions">
                    <button type="button" class="pr-btn pr-btn-primary" id="startCamera"><i class="bi bi-camera-video"></i>Bật camera</button>
                    <button type="button" class="pr-btn" id="capturePhoto" disabled><i class="bi bi-camera"></i>Chụp ảnh</button>
                    <button type="button" class="pr-btn" id="stopCamera" disabled aria-label="Tắt camera"><i class="bi bi-camera-video-off"></i>Tắt</button>
                </div>

                <label class="pr-file-label" id="fileLabel">
                    <i class="bi bi-cloud-arrow-up"></i><span>Chọn ảnh từ máy tính hoặc điện thoại</span>
                    <input type="file" id="imageInput" accept="image/jpeg,image/png,image/webp" aria-label="Chọn ảnh thú cưng" />
                </label>
                <div class="pr-file-info" id="fileInfo">Chưa có ảnh đầu vào · JPG, PNG hoặc WEBP · tối đa 5 MB</div>

                <button type="button" class="pr-btn pr-btn-primary pr-btn-block" id="recognizeButton" disabled>
                    <i class="bi bi-search"></i> Phân tích ảnh bằng AI
                </button>
                <div class="pr-help"><i class="bi bi-lightbulb-fill"></i><span><strong>Mẹo:</strong> Ảnh đủ sáng, thấy rõ mặt và đặc điểm riêng sẽ giúp kết quả tốt hơn. Camera cần HTTPS hoặc localhost.</span></div>
            </div>
        </section>

        <section class="pr-panel" id="resultsPanel">
            <div class="pr-panel-head">
                <div class="pr-panel-title">
                    <span class="pr-panel-icon"><i class="bi bi-list-check"></i></span>
                    <div>
                        <h3>Danh sách ứng viên</h3>
                        <p>Đối chiếu kết quả và chọn đúng hồ sơ thú cưng.</p>
                    </div>
                </div>
                <span class="pr-count" id="candidateCount">0 ứng viên</span>
            </div>
            <div class="pr-panel-body">
                <div id="prNotice" class="pr-notice" role="status" aria-live="polite"></div>
                <div class="pr-tools">
                    <label class="pr-search" for="manualSearch">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <input id="manualSearch" type="search" maxlength="100" placeholder="Tên thú cưng, chủ nuôi, SĐT hoặc email..." autocomplete="off" aria-label="Tìm hồ sơ thú cưng" />
                    </label>
                    <button type="button" class="pr-btn pr-search-btn" id="searchButton"><i class="bi bi-person-search"></i>Tìm</button>
                </div>
                <div class="pr-results-meta">
                    <strong id="listTitle">Danh sách kết quả đối chiếu</strong>
                    <span id="listHint">Chưa phân tích ảnh</span>
                </div>
                <div id="candidates" class="pr-candidates">
                    <div class="pr-empty" id="emptyState">
                        <i class="bi bi-fingerprint"></i>
                        <strong>Chưa có ứng viên</strong>
                        <p>Nhận diện bằng ảnh hoặc nhập ít nhất 2 ký tự để tra cứu theo tên thú cưng, chủ nuôi, số điện thoại hay email.</p>
                    </div>
                </div>
                <div class="pr-footer"><i class="bi bi-info-circle me-1"></i>Điểm tương đồng thể hiện mức độ so khớp của mô hình, không phải xác suất chắc chắn. Kết quả tra cứu thủ công không có điểm AI.</div>
            </div>
        </section>
    </div>

    <section class="pr-service-panel" id="serviceActions" hidden aria-live="polite">
        <div class="pr-service-header">
            <div>
                <h3>Tiếp tục với hồ sơ đã xác nhận</h3>
                <p>Chọn chức năng cần thực hiện. Thú cưng đã được chọn sẵn ở màn hình tiếp theo.</p>
            </div>
            <div class="pr-service-pet" id="confirmedPetSummary"></div>
        </div>
        <div class="pr-service-grid">
            <a class="pr-service-link" id="spaServiceLink" asp-controller="Admin" asp-action="Appointments" asp-route-petId="@selectedPetId">
                <span class="pr-service-icon"><i class="bi bi-droplet"></i></span>
                <span><strong>Đặt dịch vụ Spa</strong><small>Mở lịch hẹn và chọn gói/dịch vụ chăm sóc cho thú cưng.</small></span>
            </a>
            <a class="pr-service-link" id="vaccinationServiceLink" asp-controller="Admin" asp-action="VaccinationRecords" asp-route-petId="@selectedPetId">
                <span class="pr-service-icon"><i class="bi bi-prescription2"></i></span>
                <span><strong>Tiêm phòng</strong><small>Mở màn hình tiêm phòng với hồ sơ thú cưng đã chọn.</small></span>
            </a>
            <a class="pr-service-link" id="healthServiceLink" asp-controller="Admin" asp-action="PetHealthRecords" asp-route-petId="@selectedPetId">
                <span class="pr-service-icon"><i class="bi bi-clipboard2-pulse"></i></span>
                <span><strong>Tra cứu sức khỏe</strong><small>Xem hồ sơ khám và sức khỏe của thú cưng đã xác nhận.</small></span>
            </a>
        </div>
        <div class="mt-3 text-end">
            <button type="button" class="pr-btn" id="newRecognitionButton">
                <i class="bi bi-arrow-repeat"></i>Nhận diện ca khác
            </button>
        </div>
    </section>
</div>

<div class="modal fade" id="confirmCandidateModal" tabindex="-1" aria-labelledby="confirmCandidateTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0">
                <div>
                    <span class="pr-kicker">XÁC NHẬN HỒ SƠ</span>
                    <h2 class="modal-title fs-5 fw-bold mt-1" id="confirmCandidateTitle">Đây có phải thú cưng cần tìm?</h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <div class="pr-compare-images mb-3">
                    <figure class="pr-compare-image">
                        <img id="confirmInputImage" alt="Ảnh đầu vào được chọn" />
                        <figcaption>Ảnh đầu vào (ảnh quét)</figcaption>
                    </figure>
                    <figure class="pr-compare-image">
                        <div id="confirmProfileImage" class="pr-compare-placeholder">
                            <i class="bi bi-camera"></i>
                        </div>
                        <figcaption>Ảnh hồ sơ thú cưng</figcaption>
                    </figure>
                </div>
                <div class="pr-confirm-details">
                    <div class="pr-confirm-detail">
                        <small>Thú cưng</small>
                        <strong id="confirmPetName"></strong>
                    </div>
                    <div class="pr-confirm-detail">
                        <small>Giống loài</small>
                        <strong id="confirmPetBreed"></strong>
                    </div>
                    <div class="pr-confirm-detail">
                        <small>Chủ nuôi</small>
                        <strong id="confirmPetOwner"></strong>
                    </div>
                    <div class="pr-confirm-detail">
                        <small>Mức độ tin cậy</small>
                        <span id="confirmPetConfidence" class="badge rounded-pill"></span>
                    </div>
                </div>
                <div id="lowConfidenceWarning" class="pr-low-confidence-warning mt-3" hidden></div>
                <div id="lowConfidenceAcknowledgement" class="pr-low-confidence-ack mt-2" hidden>
                    <div class="form-check mb-0">
                        <input class="form-check-input" type="checkbox" id="lowConfidenceConfirmCheckbox" />
                        <label class="form-check-label" for="lowConfidenceConfirmCheckbox">
                            Tôi đã đối chiếu kỹ và xác nhận đây đúng là thú cưng cần tìm.
                        </label>
                    </div>
                    <div id="lowConfidenceConfirmError" class="small mt-2" hidden>Vui lòng xác nhận đã đối chiếu kỹ trước khi tiếp tục.</div>
                </div>
                <p class="text-secondary small mt-3 mb-0">Kiểm tra ảnh và thông tin hồ sơ trước khi lưu ảnh vào lịch sử nhận diện.</p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="pr-btn" data-bs-dismiss="modal"><i class="bi bi-arrow-left"></i>Quay lại</button>
                <button type="button" class="pr-btn pr-btn-primary" id="confirmButton"><i class="bi bi-check-circle"></i>Xác nhận đúng hồ sơ</button>
            </div>
        </div>
    </div>
</div>

<script>
(() => {
    const recognizeUrl = '@Url.Action("Recognize", "PetRecognition")';
    const searchUrl = '@Url.Action("SearchOwners", "PetRecognition")';
    const confirmUrl = '@Url.Action("Confirm", "PetRecognition")';

    const $ = id => document.getElementById(id);
    const notice = $("prNotice");
    const video = $("cameraVideo");
    const placeholder = $("cameraPlaceholder");
    const capturedPreview = $("capturedPreview");
    const imageInput = $("imageInput");
    const fileInfo = $("fileInfo");
    const recognizeButton = $("recognizeButton");
    const candidatesContainer = $("candidates");
    const candidateCount = $("candidateCount");
    const serviceActions = $("serviceActions");
    const appointmentsUrl = '@Url.Action("Appointments", "Admin")';
    const vaccinationRecordsUrl = '@Url.Action("VaccinationRecords", "Admin")';
    const healthRecordsUrl = '@Url.Action("PetHealthRecords", "Admin")';
    const defaultPetAvatarUrl = '@Url.Content("~/images/pet-avatar-default.jpeg")';

    let cameraStream = null;
    let selectedFile = null;
    let previewUrl = null;
    let selectedCandidate = null;
    let currentRecognitionStatus = "";
    let currentCandidateMode = "";
    let isBusy = false;
    let searchTimer = null;
    let searchRequestId = 0;
    let searchController = null;
    const page = $("petRecognitionPage");
    function getConfirmationModal() {
        return bootstrap.Modal.getOrCreateInstance($("confirmCandidateModal"));
    }

    function setResultsMode(enabled) {
        page.classList.toggle("results-mode", enabled);
        page.classList.toggle("camera-first", !enabled);
        $("cameraPanelTitle").textContent = enabled ? "Ảnh đầu vào" : "Camera nhận diện trực tiếp";
    }

    function createIcon(className) {
        const icon = document.createElement("i");
        icon.className = className;
        return icon;
    }
    function createAvatar(imageUrl, altText = "Ảnh thú cưng") {
        if (!imageUrl) {
            imageUrl = defaultPetAvatarUrl;
        }

        const image = document.createElement("img");
        image.className = "pr-avatar";
        image.src = imageUrl;
        image.alt = altText;
        image.loading = "lazy";
        image.addEventListener("error", () => {
            if (image.dataset.fallbackAttempted !== "true" && image.src !== defaultPetAvatarUrl) {
                image.dataset.fallbackAttempted = "true";
                image.src = defaultPetAvatarUrl;
                return;
            }

            const placeholderAvatar = document.createElement("div");
            placeholderAvatar.className = "pr-avatar";
            placeholderAvatar.append(createIcon("bi bi-camera"));
            image.replaceWith(placeholderAvatar);
        });
        return image;
    }
    function createEmptyState(message, loading = false) {
        const container = document.createElement("div");
        container.className = "pr-empty";
        if (loading) {
            const spinner = document.createElement("span");
            spinner.className = "pr-spinner";
            container.append(spinner);
        } else {
            container.append(createIcon("bi bi-search"));
            const title = document.createElement("strong");
            title.textContent = message;
            container.append(title);
        }

        const description = document.createElement("p");
        description.textContent = loading
            ? "Đang tìm hồ sơ..."
            : "Thử nhận diện bằng ảnh hoặc thay đổi từ khóa tìm kiếm.";
        container.append(description);
        return container;
    }
    function setButtonContent(button, iconClass, label, loading = false) {
        const icon = document.createElement(loading ? "span" : "i");
        icon.className = loading ? "pr-spinner" : iconClass;
        button.replaceChildren(icon, document.createTextNode(` ${label}`));
    }
    function getAntiForgeryToken() {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        if (!token) throw new Error("Không tìm thấy mã chống giả mạo. Hãy tải lại trang.");
        return token;
    }

    function showNotice(message, type = "info") {
        notice.className = `pr-notice show ${type}`;
        notice.textContent = message;
    }
    function showRecognitionStatus(status, count) {
        const normalizedStatus = String(status ?? "").trim().toUpperCase();
        if (normalizedStatus === "MATCH") {
            showNotice(
                `✓ Nhận diện thành công: Khớp hồ sơ (Tìm thấy ${count} ứng viên)`,
                "success");
            return;
        }

        showNotice(
            `⚠ Chưa nhận diện chính xác: Không tìm thấy hồ sơ khớp tin cậy (Gợi ý ${count} ứng viên gần nhất)`,
            "warning");
    }
    function hideNotice() {
        notice.className = "pr-notice";
        notice.textContent = "";
    }
    function formatSize(bytes) {
        return bytes < 1024 * 1024 ? `${Math.max(1, Math.round(bytes / 1024))} KB` : `${(bytes / 1024 / 1024).toFixed(2)} MB`;
    }
    function stopCamera() {
        if (cameraStream) {
            cameraStream.getTracks().forEach(track => track.stop());
            cameraStream = null;
        }
        video.srcObject = null;
        video.style.display = "none";
        $("startCamera").disabled = false;
        $("capturePhoto").disabled = true;
        $("stopCamera").disabled = true;
    }
    function clearOldPreview() {
        if (previewUrl) URL.revokeObjectURL(previewUrl);
        previewUrl = null;
    }
    function setSelectedFile(file, fromCamera = false) {
        if (!file) return;
        if (!/^image\/(jpeg|png|webp)$/i.test(file.type)) {
            showNotice("Ảnh phải có định dạng JPG, PNG hoặc WEBP.", "error");
            return;
        }
        if (file.size > 5 * 1024 * 1024) {
            showNotice("Ảnh vượt quá 5 MB. Vui lòng chọn ảnh nhỏ hơn.", "error");
            return;
        }
        clearOldPreview();
        selectedFile = file;
        previewUrl = URL.createObjectURL(file);
        capturedPreview.src = previewUrl;
        capturedPreview.style.display = "block";
        video.style.display = "none";
        placeholder.style.display = "none";
        fileInfo.textContent = `${file.name || "anh-chup-camera.jpg"} · ${formatSize(file.size)}`;
        recognizeButton.disabled = false;
        hideNotice();
        if (!fromCamera) stopCamera();
        setResultsMode(true);
    }
    function clearCandidates(message = "Chưa có kết quả") {
        candidatesContainer.replaceChildren(createEmptyState(message));
        candidateCount.textContent = "0 ứng viên";
        selectedCandidate = null;
        serviceActions.hidden = true;
    }
    function renderCandidatePartial(html, fallbackMode) {
        const parsedDocument = new DOMParser().parseFromString(html, "text/html");
        const result = parsedDocument.querySelector("[data-result-count]");
        if (!result) throw new Error("Phản hồi danh sách ứng viên không đúng định dạng.");

        const count = Number(result.dataset.resultCount);
        if (!Number.isInteger(count) || count < 0) {
            throw new Error("Số lượng ứng viên trả về không hợp lệ.");
        }

        const mode = result.dataset.mode || fallbackMode;
        const recognitionStatus = result.dataset.recognitionStatus || "";
        currentCandidateMode = mode;
        currentRecognitionStatus = recognitionStatus.trim().toUpperCase();
        candidatesContainer.replaceChildren(document.importNode(result, true));
        setResultsMode(true);
        selectedCandidate = null;
        serviceActions.hidden = true;
        candidateCount.textContent = `${count} ứng viên`;
        $("listHint").textContent = count
            ? mode === "ai" ? "Sắp xếp theo kết quả AI trả về" : "Kết quả tra cứu trong cơ sở dữ liệu"
            : "0 kết quả";
        return { count, mode, recognitionStatus };
    }

    async function getErrorMessage(response) {
        const body = await response.text();
        try {
            const problem = JSON.parse(body);
            const validationMessage = Object.values(problem.errors || {})
                .flat()
                .find(message => typeof message === "string" && message.length > 0);
            return validationMessage || problem.detail || problem.title || problem.message || "Yêu cầu không thành công.";
        } catch {
            return body.trim() || "Yêu cầu không thành công.";
        }
    }

    candidatesContainer.addEventListener("click", event => {
        const button = event.target.closest("[data-confirm]");
        if (!button) return;
        const candidate = {
            petId: button.dataset.petId || "",
            databasePetId: Number(button.dataset.databasePetId),
            petName: button.dataset.petName || "Chưa có tên",
            species: button.dataset.species || "",
            breed: button.dataset.breed || "",
            ownerName: button.dataset.ownerName || "Không xác định",
            ownerPhone: button.dataset.ownerPhone || "",
            ownerEmail: button.dataset.ownerEmail || "",
            petImageUrl: button.dataset.petImageUrl || "",
            similarity: button.dataset.similarity === "" ? null : Number(button.dataset.similarity)
        };
        selectCandidate(candidate, button.closest(".pr-candidate"));
    });
    candidatesContainer.addEventListener("error", event => {
        if (event.target.matches(".pr-candidate .pr-avatar")) {
            if (event.target.dataset.fallbackAttempted !== "true") {
                event.target.dataset.fallbackAttempted = "true";
                event.target.src = defaultPetAvatarUrl;
                return;
            }

            event.target.replaceWith(createAvatarPlaceholder());
        }
    }, true);

    function createAvatarPlaceholder() {
        const placeholderAvatar = document.createElement("div");
        placeholderAvatar.className = "pr-avatar";
        placeholderAvatar.append(createIcon("bi bi-camera"));
        return placeholderAvatar;
    }

    function selectCandidate(candidate, card) {
        if (!candidate.databasePetId) {
            showNotice("Hồ sơ không có mã thú cưng hợp lệ, không thể xác nhận.", "error");
            return;
        }
        if (!selectedFile) {
            showNotice("Hãy chụp hoặc tải ảnh nhận diện trước khi xác nhận hồ sơ.", "info");
            return;
        }
        selectedCandidate = candidate;
        candidatesContainer.querySelectorAll(".pr-candidate").forEach(el => el.classList.remove("selected"));
        if (card) card.classList.add("selected");

        const inputImage = $("confirmInputImage");
        inputImage.src = previewUrl || "";
        inputImage.alt = `Ảnh đầu vào để đối chiếu với ${candidate.petName}`;
        $("confirmProfileImage").replaceChildren(
            candidate.petImageUrl
                ? createAvatar(candidate.petImageUrl, `Ảnh hồ sơ ${candidate.petName}`)
                : createPlaceholderAvatar());
        $("confirmPetName").textContent = `${candidate.petName} - ${candidate.petId}`;
        const speciesBreed = [candidate.species, candidate.breed].filter(Boolean).join(" - ");
        $("confirmPetBreed").textContent = speciesBreed || "Chưa cập nhật";
        $("confirmPetOwner").textContent =
            `${candidate.ownerName}${candidate.ownerPhone ? ` · ${candidate.ownerPhone}` : ""}`;

        const confidenceBadge = $("confirmPetConfidence");
        const confidence = Number.isFinite(candidate.similarity) ? candidate.similarity : null;
        confidenceBadge.className = "badge rounded-pill";
        if (confidence === null) {
            confidenceBadge.classList.add("text-bg-secondary");
            confidenceBadge.textContent = "Tra cứu thủ công";
        } else if (confidence >= 0.7) {
            confidenceBadge.classList.add("text-bg-success");
            confidenceBadge.textContent = `${(confidence * 100).toFixed(1)}% · Cao`;
        } else if (confidence >= 0.5) {
            confidenceBadge.classList.add("text-bg-warning");
            confidenceBadge.textContent = `${(confidence * 100).toFixed(1)}% · Trung bình`;
        } else {
            confidenceBadge.classList.add("text-bg-danger");
            confidenceBadge.textContent = `${(confidence * 100).toFixed(1)}% · Thấp`;
        }

        const requiresExtraConfirmation =
            (confidence !== null && confidence < 0.5) ||
            (currentCandidateMode === "ai" && currentRecognitionStatus === "NOT_RECOGNIZED");
        const lowConfidenceWarning = $("lowConfidenceWarning");
        const acknowledgement = $("lowConfidenceAcknowledgement");
        const acknowledgementCheckbox = $("lowConfidenceConfirmCheckbox");
        $("lowConfidenceConfirmError").hidden = true;
        acknowledgementCheckbox.checked = false;
        lowConfidenceWarning.hidden = !requiresExtraConfirmation;
        acknowledgement.hidden = !requiresExtraConfirmation;
        if (requiresExtraConfirmation) {
            const confidenceDescription = confidence === null
                ? "không xác định"
                : `${(confidence * 100).toFixed(1)}%`;
            lowConfidenceWarning.textContent =
                `⚠ Cảnh báo: Độ tin cậy nhận diện rất thấp (${confidenceDescription}). Bạn có chắc chắn muốn gán ảnh này cho thú cưng này không?`;
        } else {
            lowConfidenceWarning.textContent = "";
        }

        $("confirmButton").disabled = false;
        hideNotice();
        getConfirmationModal().show();
    }

    function createPlaceholderAvatar() {
        const placeholder = document.createElement("div");
        placeholder.className = "pr-compare-placeholder";
        placeholder.append(createIcon("bi bi-camera"));
        return placeholder;
    }

    $("cameraTab").addEventListener("click", () => {
        $("cameraTab").classList.add("active");
        $("uploadTab").classList.remove("active");
        $("cameraActions").style.display = "flex";
        $("fileLabel").style.display = "flex";
    });
    $("uploadTab").addEventListener("click", () => {
        $("uploadTab").classList.add("active");
        $("cameraTab").classList.remove("active");
        $("fileLabel").style.display = "flex";
        $("imageInput").click();
    });
    async function startCamera() {
        hideNotice();
        if (!navigator.mediaDevices?.getUserMedia) {
            showNotice("Trình duyệt không hỗ trợ camera hoặc trang chưa chạy trên HTTPS/localhost.", "error");
            return;
        }
        try {
            stopCamera();
            cameraStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: "environment" }, audio: false });
            video.srcObject = cameraStream;
            video.style.display = "block";
            capturedPreview.style.display = "none";
            placeholder.style.display = "none";
            $("startCamera").disabled = true;
            $("capturePhoto").disabled = false;
            $("stopCamera").disabled = false;
        } catch (error) {
            showNotice("Không mở được camera. Hãy kiểm tra quyền camera hoặc đóng ứng dụng khác đang sử dụng camera.", "error");
        }
    }
    $("startCamera").addEventListener("click", startCamera);
    $("capturePhoto").addEventListener("click", () => {
        if (!video.videoWidth || !video.videoHeight) {
            showNotice("Camera chưa sẵn sàng. Vui lòng đợi một chút rồi chụp lại.", "error");
            return;
        }
        const canvas = document.createElement("canvas");
        canvas.width = video.videoWidth;
        canvas.height = video.videoHeight;
        canvas.getContext("2d").drawImage(video, 0, 0, canvas.width, canvas.height);
        canvas.toBlob(blob => {
            if (!blob) {
                showNotice("Không thể lấy ảnh từ camera. Vui lòng thử lại.", "error");
                return;
            }
            setSelectedFile(new File([blob], `pet-camera-${Date.now()}.jpg`, { type: "image/jpeg" }), true);
            stopCamera();
        }, "image/jpeg", .92);
    });
    $("stopCamera").addEventListener("click", () => {
        stopCamera();
        if (!selectedFile) placeholder.style.display = "block";
    });
    imageInput.addEventListener("change", () => {
        const file = imageInput.files?.[0];
        if (file) setSelectedFile(file);
    });

    recognizeButton.addEventListener("click", async () => {
        if (!selectedFile || isBusy) return;
        isBusy = true;
        recognizeButton.disabled = true;
        setButtonContent(recognizeButton, "bi bi-search", "Đang phân tích ảnh...", true);
        $("listTitle").textContent = "Danh sách kết quả đối chiếu";
        clearCandidates("AI đang phân tích ảnh");
        try {
            const formData = new FormData();
            formData.append("file", selectedFile, selectedFile.name);
            formData.append("__RequestVerificationToken", getAntiForgeryToken());
            const response = await fetch(recognizeUrl, { method: "POST", body: formData });
            if (!response.ok) throw new Error(await getErrorMessage(response));
            const result = renderCandidatePartial(await response.text(), "ai");
            showRecognitionStatus(result.recognitionStatus, result.count);
        } catch (error) {
            clearCandidates("Chưa thể nhận diện ảnh");
            showNotice(error.message || "Có lỗi khi gọi dịch vụ nhận diện.", "error");
        } finally {
            isBusy = false;
            recognizeButton.disabled = !selectedFile;
            setButtonContent(recognizeButton, "bi bi-search", "Phân tích ảnh bằng AI");
        }
    });

    async function searchManual() {
        const q = $("manualSearch").value.trim();
        if (q.length < 2) {
            showNotice("Nhập ít nhất 2 ký tự để tìm tên thú cưng, chủ nuôi, số điện thoại hoặc email.", "info");
            return;
        }
        const requestId = ++searchRequestId;
        if (searchController) searchController.abort();
        searchController = new AbortController();
        $("searchButton").disabled = true;
        setButtonContent($("searchButton"), "bi bi-person-search", "Đang tìm", true);
        setResultsMode(true);
        $("listTitle").textContent = "Kết quả tìm thủ công";
        candidatesContainer.replaceChildren(createEmptyState("", true));
        try {
            const response = await fetch(`${searchUrl}?q=${encodeURIComponent(q)}`, { signal: searchController.signal });
            if (!response.ok) throw new Error(await getErrorMessage(response));
            if (requestId !== searchRequestId) return;
            const { count } = renderCandidatePartial(await response.text(), "manual");
            showNotice(`Tìm kiếm hoàn tất: ${count} hồ sơ.`, "success");
        } catch (error) {
            if (error.name === "AbortError") return;
            if (requestId !== searchRequestId) return;
            showNotice(error.message || "Có lỗi khi tìm hồ sơ.", "error");
        } finally {
            if (requestId === searchRequestId) {
                $("searchButton").disabled = false;
                setButtonContent($("searchButton"), "bi bi-person-search", "Tìm");
            }
        }
    }
    $("searchButton").addEventListener("click", searchManual);
    $("manualSearch").addEventListener("keydown", event => {
        if (event.key === "Enter") {
            event.preventDefault();
            searchManual();
        }
    });
    $("manualSearch").addEventListener("input", () => {
        clearTimeout(searchTimer);
        const q = $("manualSearch").value.trim();
        if (q.length >= 2) {
            searchTimer = setTimeout(searchManual, 450);
        } else {
            searchRequestId++;
            if (searchController) searchController.abort();
            searchController = null;
            clearCandidates("Nhập ít nhất 2 ký tự để bắt đầu tra cứu");
            $("listTitle").textContent = "Kết quả tìm thủ công";
            $("listHint").textContent = "Chưa có từ khóa tìm kiếm";
            $("searchButton").disabled = false;
            setButtonContent($("searchButton"), "bi bi-person-search", "Tìm");
        }
    });

    $("confirmButton").addEventListener("click", async () => {
        if (!selectedCandidate || !selectedFile || isBusy) {
            showNotice("Hãy chọn hồ sơ và cung cấp ảnh trước khi xác nhận.", "error");
            return;
        }
        if (!$("lowConfidenceAcknowledgement").hidden &&
            !$("lowConfidenceConfirmCheckbox").checked) {
            $("lowConfidenceConfirmError").hidden = false;
            $("lowConfidenceConfirmCheckbox").focus();
            return;
        }

        isBusy = true;
        const button = $("confirmButton");
        button.disabled = true;
        setButtonContent(button, "bi bi-check-circle", "Đang lưu...", true);
        try {
            const formData = new FormData();
            formData.append("file", selectedFile, selectedFile.name);
            formData.append("petId", String(selectedCandidate.databasePetId));
            formData.append("__RequestVerificationToken", getAntiForgeryToken());
            if (selectedCandidate.similarity !== null && selectedCandidate.similarity !== undefined) {
                formData.append("similarity", String(selectedCandidate.similarity));
            }
            const response = await fetch(confirmUrl, { method: "POST", body: formData });
            const data = response.ok ? await response.json() : null;
            if (!response.ok) throw new Error(await getErrorMessage(response));
            stopCamera();
            getConfirmationModal().hide();
            $("confirmedPetSummary").textContent = `${selectedCandidate.petName} · ${selectedCandidate.petId} · Chủ nuôi: ${selectedCandidate.ownerName}`;
            const petQuery = `?petId=${encodeURIComponent(selectedCandidate.databasePetId)}`;
            $("spaServiceLink").href = `${appointmentsUrl}${petQuery}`;
            $("vaccinationServiceLink").href = `${vaccinationRecordsUrl}${petQuery}`;
            $("healthServiceLink").href = `${healthRecordsUrl}${petQuery}`;
            page.classList.add("confirmed-mode");
            serviceActions.hidden = false;
            serviceActions.scrollIntoView({ behavior: "smooth", block: "center" });
        } catch (error) {
            showNotice(error.message || "Có lỗi khi lưu xác nhận.", "error");
        } finally {
            isBusy = false;
            button.disabled = !selectedFile;
            setButtonContent(button, "bi bi-check-circle", "Xác nhận hồ sơ này");
        }
    });
    $("lowConfidenceConfirmCheckbox").addEventListener("change", () => {
        if ($("lowConfidenceConfirmCheckbox").checked) {
            $("lowConfidenceConfirmError").hidden = true;
        }
    });

    $("newRecognitionButton").addEventListener("click", () => {
        stopCamera();
        clearTimeout(searchTimer);
        searchRequestId++;
        if (searchController) searchController.abort();
        searchController = null;
        clearOldPreview();
        selectedFile = null;
        selectedCandidate = null;
        currentRecognitionStatus = "";
        currentCandidateMode = "";
        imageInput.value = "";
        capturedPreview.removeAttribute("src");
        capturedPreview.style.display = "none";
        placeholder.style.display = "flex";
        fileInfo.textContent = "Chưa có ảnh đầu vào · JPG, PNG hoặc WEBP · tối đa 5 MB";
        $("manualSearch").value = "";
        $("listTitle").textContent = "Danh sách kết quả đối chiếu";
        $("listHint").textContent = "Chưa phân tích ảnh";
        clearCandidates("Chưa có ứng viên");
        recognizeButton.disabled = true;
        setButtonContent(recognizeButton, "bi bi-search", "Phân tích ảnh bằng AI");
        $("searchButton").disabled = false;
        setButtonContent($("searchButton"), "bi bi-person-search", "Tìm");
        hideNotice();
        serviceActions.hidden = true;
        page.classList.remove("confirmed-mode");
        setResultsMode(true);
        page.scrollIntoView({ behavior: "smooth", block: "start" });
    });

    // Chỉ xin quyền camera khi người dùng chủ động bật camera.
    if (!navigator.mediaDevices?.getUserMedia) {
        showNotice("Camera cần HTTPS hoặc localhost. Bạn vẫn có thể tải ảnh lên để nhận diện.", "info");
    }

    window.addEventListener("beforeunload", () => {
        stopCamera();
        clearOldPreview();
    });
})();
</script>
