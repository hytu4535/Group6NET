@using PetManagementSystem.Helpers
@model PetManagementSystem.ViewModels.Commerce.PaymentListViewModel
@{
    Layout = "_AdminLayout";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h5 class="mb-0">Thanh toán</h5>
            <small class="text-muted">@Model.TotalCount giao dịch</small>
        </div>
        @if (User.HasPermission("payments.create"))
        {
            <a class="btn btn-primary" asp-action="CreatePayment"><i class="bi bi-plus-circle me-1"></i>Tạo giao dịch</a>
        }
    </div>
    <div class="card-body">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success">@success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger">@error</div>
        }

        <form method="get" class="row g-2 mb-3">
            <div class="col-md-3">
                <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Tìm theo #đơn, mã GD, khách hàng..." />
            </div>
            <div class="col-md-3">
                <select name="method" class="form-select">
                    <option value="">-- Tất cả phương thức --</option>
                    @foreach (var m in PaymentMethods.All)
                    {
                        <option value="@m" selected="@(Model.Method == m)">@PaymentMethods.Label(m)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">-- Tất cả trạng thái --</option>
                    @foreach (var s in PaymentStatuses.All)
                    {
                        <option value="@s" selected="@(Model.Status == s)">@PaymentStatuses.Label(s)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-secondary w-100"><i class="bi bi-search"></i> Lọc</button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Đơn hàng</th>
                        <th>Khách hàng</th>
                        <th>Phương thức</th>
                        <th>Số tiền</th>
                        <th>Ngày thanh toán</th>
                        <th>Trạng thái</th>
                        <th>Mã giao dịch</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">Chưa có giao dịch nào</td></tr>
                    }
                    else
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td><a asp-action="OrderDetails" asp-route-id="@item.OrderId">#@item.OrderId</a></td>
                                <td>@item.CustomerName</td>
                                <td>@PaymentMethods.Label(item.PaymentMethod)</td>
                                <td>@CommerceFormat.Money(item.Amount)</td>
                                <td>@CommerceFormat.DateTimeText(item.PaymentDate)</td>
                                <td><span class="badge @PaymentStatuses.Badge(item.Status)">@PaymentStatuses.Label(item.Status)</span></td>
                                <td>@(item.TransactionCode ?? "-")</td>
                                <td class="text-end">
                                    @if (User.HasPermission("payments.update"))
                                    {
                                        <a class="btn btn-sm btn-outline-primary" asp-action="EditPayment" asp-route-id="@item.Id">Sửa</a>
                                    }
                                    @if (User.HasPermission("payments.delete"))
                                    {
                                        <form asp-action="DeletePayment" method="post" class="d-inline" onsubmit="return confirm('Xóa giao dịch này?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <partial name="~/Views/Shared/Commerce/_Pagination.cshtml"
                 view-data='new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData)
                 {
                     ["Page"] = Model.Page,
                     ["TotalPages"] = Model.TotalPages,
                     ["Action"] = "Payments",
                     ["RouteValues"] = new Dictionary<string, string?>
                     {
                         ["search"] = Model.Search,
                         ["method"] = Model.Method,
                         ["status"] = Model.Status
                     }
                 }' />
    </div>
</div>
