@using PetManagementSystem.Helpers
@model PetManagementSystem.ViewModels.Commerce.CartListViewModel
@{
    Layout = "_AdminLayout";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white">
        <h5 class="mb-0">Giỏ hàng</h5>
        <small class="text-muted">@Model.TotalCount giỏ hàng</small>
    </div>
    <div class="card-body">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success">@success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger">@error</div>
        }

        <form method="get" class="row g-2 mb-3">
            <div class="col-md-4">
                <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Tìm theo #, khách hàng..." />
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="active" selected="@(Model.Status == "active")">Đang hoạt động</option>
                    <option value="checked_out" selected="@(Model.Status == "checked_out")">Đã đặt hàng</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-secondary w-100"><i class="bi bi-search"></i> Lọc</button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Khách hàng</th>
                        <th>Trạng thái</th>
                        <th>Số sản phẩm</th>
                        <th>Tổng tiền</th>
                        <th>Cập nhật</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">Chưa có giỏ hàng nào</td></tr>
                    }
                    else
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>#@item.Id</td>
                                <td>@item.CustomerName</td>
                                <td><span class="badge @CartStatuses.Badge(item.Status)">@CartStatuses.Label(item.Status)</span></td>
                                <td>@item.ItemCount</td>
                                <td>@CommerceFormat.Money(item.TotalAmount)</td>
                                <td>@CommerceFormat.DateTimeText(item.UpdatedAt ?? item.CreatedAt)</td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="CartDetails" asp-route-id="@item.Id">Chi tiết</a>
                                    @if (User.HasPermission("carts.delete"))
                                    {
                                        <form asp-action="DeleteCart" method="post" class="d-inline" onsubmit="return confirm('Xóa giỏ hàng này?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <partial name="~/Views/Shared/Commerce/_Pagination.cshtml"
                 view-data='new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData)
                 {
                     ["Page"] = Model.Page,
                     ["TotalPages"] = Model.TotalPages,
                     ["Action"] = "Carts",
                     ["RouteValues"] = new Dictionary<string, string?> { ["search"] = Model.Search, ["status"] = Model.Status }
                 }' />
    </div>
</div>
