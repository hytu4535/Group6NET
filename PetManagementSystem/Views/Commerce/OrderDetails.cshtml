@using PetManagementSystem.Helpers
@model PetManagementSystem.ViewModels.Commerce.OrderDetailsViewModel
@{
    Layout = "_AdminLayout";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h5 class="mb-0">Đơn hàng #@Model.Id</h5>
        <div class="d-flex gap-2 flex-wrap">
            @if (Model.CanEdit && User.HasPermission("orders.update"))
            {
                <a class="btn btn-sm btn-outline-primary" asp-action="EditOrder" asp-route-id="@Model.Id">Sửa thông tin giao hàng</a>
            }
            @if (User.HasPermission("payments.create"))
            {
                <a class="btn btn-sm btn-outline-success" asp-action="CreatePayment" asp-route-orderId="@Model.Id">Tạo thanh toán</a>
            }
            @if (Model.InvoiceId is null && User.HasPermission("invoices.create") && Model.Status != "cancelled")
            {
                <a class="btn btn-sm btn-outline-secondary" asp-action="CreateInvoice" asp-route-orderId="@Model.Id">Lập hóa đơn</a>
            }
            @if (Model.InvoiceId is not null)
            {
                <a class="btn btn-sm btn-outline-secondary" asp-action="InvoiceDetails" asp-route-id="@Model.InvoiceId">Xem hóa đơn</a>
            }
            <a class="btn btn-sm btn-outline-secondary" asp-action="Orders">Quay lại</a>
        </div>
    </div>
    <div class="card-body">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success">@success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger">@error</div>
        }

        <dl class="row">
            <dt class="col-sm-2">Khách hàng</dt>
            <dd class="col-sm-4">@Model.CustomerName (@Model.Username)</dd>
            <dt class="col-sm-2">Email</dt>
            <dd class="col-sm-4">@(Model.Email ?? "-")</dd>

            <dt class="col-sm-2">SĐT nhận hàng</dt>
            <dd class="col-sm-4">@Model.Phone</dd>
            <dt class="col-sm-2">Ngày đặt</dt>
            <dd class="col-sm-4">@CommerceFormat.DateTimeText(Model.OrderDate)</dd>

            <dt class="col-sm-2">Địa chỉ giao hàng</dt>
            <dd class="col-sm-10">@Model.ShippingAddress</dd>

            <dt class="col-sm-2">Trạng thái</dt>
            <dd class="col-sm-4"><span class="badge @OrderStatuses.Badge(Model.Status)">@OrderStatuses.Label(Model.Status)</span></dd>
            <dt class="col-sm-2">Tổng tiền</dt>
            <dd class="col-sm-4 fw-semibold">@CommerceFormat.Money(Model.TotalAmount)</dd>

            <dt class="col-sm-2">Đã thanh toán</dt>
            <dd class="col-sm-4">@CommerceFormat.Money(Model.PaidAmount)</dd>
            <dt class="col-sm-2">Ghi chú</dt>
            <dd class="col-sm-4">@(Model.Note ?? "-")</dd>
        </dl>

        @if (Model.NextStatuses.Any() && User.HasPermission("orders.update"))
        {
            <div class="d-flex gap-2 mb-3">
                @foreach (var next in Model.NextStatuses)
                {
                    <form asp-action="ChangeOrderStatus" method="post"
                          onsubmit="return confirm('Chuyển đơn sang trạng thái \'@OrderStatuses.Label(next)\'?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="status" value="@next" />
                        <button type="submit" class="btn btn-sm btn-@(next == "cancelled" ? "outline-danger" : "outline-primary")">
                            Chuyển sang "@OrderStatuses.Label(next)"
                        </button>
                    </form>
                }
            </div>
        }

        <h6>Sản phẩm</h6>
        <div class="table-responsive mb-4">
            <table class="table table-striped align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Đơn vị</th>
                        <th>Số lượng</th>
                        <th>Đơn giá</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.ProductName</td>
                            <td>@(item.Unit ?? "-")</td>
                            <td>@item.Quantity</td>
                            <td>@CommerceFormat.Money(item.Price)</td>
                            <td>@CommerceFormat.Money(item.Subtotal)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <h6>Lịch sử thanh toán</h6>
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Ngày</th>
                        <th>Phương thức</th>
                        <th>Số tiền</th>
                        <th>Trạng thái</th>
                        <th>Mã giao dịch</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Payments.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-3">Chưa có giao dịch nào</td></tr>
                    }
                    else
                    {
                        foreach (var p in Model.Payments)
                        {
                            <tr>
                                <td>@CommerceFormat.DateTimeText(p.PaymentDate)</td>
                                <td>@PaymentMethods.Label(p.PaymentMethod)</td>
                                <td>@CommerceFormat.Money(p.Amount)</td>
                                <td><span class="badge @PaymentStatuses.Badge(p.Status)">@PaymentStatuses.Label(p.Status)</span></td>
                                <td>@(p.TransactionCode ?? "-")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
