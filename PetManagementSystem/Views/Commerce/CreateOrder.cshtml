@model PetManagementSystem.ViewModels.Commerce.OrderCreateViewModel
@{
    Layout = "_AdminLayout";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white"><h5 class="mb-0">Tạo đơn hàng</h5></div>
    <div class="card-body">
        <form asp-action="CreateOrder" method="post" novalidate id="orderForm">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="alert alert-danger"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="UserId" class="form-label">Khách hàng</label>
                    <select asp-for="UserId" class="form-select" id="userSelect">
                        <option value="">-- Chọn khách hàng --</option>
                        @foreach (var u in Model.UserOptions)
                        {
                            <option value="@u.Id" data-phone="@u.Phone" data-address="@u.Address">@u.Text</option>
                        }
                    </select>
                    <span asp-validation-for="UserId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label">Số điện thoại nhận hàng</label>
                    <input asp-for="Phone" class="form-control" id="phoneInput" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="ShippingAddress" class="form-label">Địa chỉ giao hàng</label>
                    <input asp-for="ShippingAddress" class="form-control" id="addressInput" />
                    <span asp-validation-for="ShippingAddress" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Note" class="form-label">Ghi chú</label>
                    <input asp-for="Note" class="form-control" />
                    <span asp-validation-for="Note" class="text-danger"></span>
                </div>
            </div>

            <hr class="my-4" />
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="mb-0">Sản phẩm trong đơn</h6>
                <button type="button" class="btn btn-sm btn-outline-primary" id="addLineBtn"><i class="bi bi-plus-lg"></i> Thêm dòng</button>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered align-middle" id="linesTable">
                    <thead class="table-light">
                        <tr>
                            <th style="min-width: 240px;">Sản phẩm</th>
                            <th style="width: 120px;">Số lượng</th>
                            <th style="width: 140px;">Đơn giá</th>
                            <th style="width: 140px;">Thành tiền</th>
                            <th style="width: 60px;"></th>
                        </tr>
                    </thead>
                    <tbody id="linesBody"></tbody>
                    <tfoot>
                        <tr>
                            <th colspan="3" class="text-end">Tổng cộng</th>
                            <th id="grandTotal">0đ</th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Lưu đơn hàng</button>
                <a class="btn btn-outline-secondary" asp-action="Orders">Quay lại</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script id="productOptionsData" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProductOptions))</script>
    <script>
        (function () {
            var products = JSON.parse(document.getElementById('productOptionsData').textContent || '[]');
            var body = document.getElementById('linesBody');
            var index = 0;

            var userSelect = document.getElementById('userSelect');
            userSelect.addEventListener('change', function () {
                var opt = this.options[this.selectedIndex];
                if (opt) {
                    document.getElementById('phoneInput').value = opt.dataset.phone || '';
                    document.getElementById('addressInput').value = opt.dataset.address || '';
                }
            });

            function money(v) {
                return Number(v || 0).toLocaleString('vi-VN') + 'đ';
            }

            function recalcTotal() {
                var total = 0;
                body.querySelectorAll('tr').forEach(function (row) {
                    total += Number(row.querySelector('.line-subtotal').dataset.value || 0);
                });
                document.getElementById('grandTotal').textContent = money(total);
            }

            function recalcRow(row, price) {
                var qty = Number(row.querySelector('.qty-input').value || 0);
                var subtotal = qty * price;
                var cell = row.querySelector('.line-subtotal');
                cell.dataset.value = subtotal;
                cell.textContent = money(subtotal);
                recalcTotal();
            }

            function addLine() {
                var i = index++;
                var tr = document.createElement('tr');

                var options = '<option value="">-- Chọn sản phẩm --</option>' + products.map(function (p) {
                    return '<option value="' + p.Id + '" data-price="' + p.SellPrice + '" data-stock="' + p.StockQuantity + '">' +
                        p.Name + (p.Unit ? ' (' + p.Unit + ')' : '') + ' - còn ' + p.StockQuantity + '</option>';
                }).join('');

                tr.innerHTML =
                    '<td><select class="form-select form-select-sm product-select" name="Lines[' + i + '].ProductId">' + options + '</select></td>' +
                    '<td><input type="number" min="1" value="1" class="form-control form-control-sm qty-input" name="Lines[' + i + '].Quantity" /></td>' +
                    '<td class="unit-price">0đ</td>' +
                    '<td class="line-subtotal" data-value="0">0đ</td>' +
                    '<td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger remove-line"><i class="bi bi-trash"></i></button></td>';

                body.appendChild(tr);

                var priceValue = 0;
                tr.querySelector('.product-select').addEventListener('change', function () {
                    var opt = this.options[this.selectedIndex];
                    priceValue = opt ? Number(opt.dataset.price || 0) : 0;
                    var stock = opt ? Number(opt.dataset.stock || 0) : 0;
                    tr.querySelector('.unit-price').textContent = money(priceValue);
                    var qtyInput = tr.querySelector('.qty-input');
                    qtyInput.max = stock || '';
                    recalcRow(tr, priceValue);
                });
                tr.querySelector('.qty-input').addEventListener('input', function () { recalcRow(tr, priceValue); });
                tr.querySelector('.remove-line').addEventListener('click', function () {
                    tr.remove();
                    recalcTotal();
                });
            }

            document.getElementById('addLineBtn').addEventListener('click', addLine);
            addLine();
        })();
    </script>
}
