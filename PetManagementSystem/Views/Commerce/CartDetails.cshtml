@using PetManagementSystem.Helpers
@model PetManagementSystem.ViewModels.Commerce.CartDetailsViewModel
@{
    Layout = "_AdminLayout";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Giỏ hàng #@Model.Id</h5>
        <a class="btn btn-sm btn-outline-secondary" asp-action="Carts">Quay lại</a>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-2">Khách hàng</dt>
            <dd class="col-sm-4">@Model.CustomerName (@Model.Username)</dd>
            <dt class="col-sm-2">Email</dt>
            <dd class="col-sm-4">@(Model.Email ?? "-")</dd>

            <dt class="col-sm-2">Trạng thái</dt>
            <dd class="col-sm-4"><span class="badge @CartStatuses.Badge(Model.Status)">@CartStatuses.Label(Model.Status)</span></dd>
            <dt class="col-sm-2">Cập nhật</dt>
            <dd class="col-sm-4">@CommerceFormat.DateTimeText(Model.UpdatedAt ?? Model.CreatedAt)</dd>
        </dl>

        <div class="table-responsive mt-3">
            <table class="table table-striped align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Đơn vị</th>
                        <th>Số lượng</th>
                        <th>Đơn giá</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.ProductName</td>
                            <td>@(item.Unit ?? "-")</td>
                            <td>@item.Quantity</td>
                            <td>@CommerceFormat.Money(item.Price)</td>
                            <td>@CommerceFormat.Money(item.Subtotal)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="4" class="text-end">Tổng cộng</th>
                        <th>@CommerceFormat.Money(Model.TotalAmount)</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
