@using PetManagementSystem.Helpers
@model PetManagementSystem.ViewModels.Commerce.ImportReceiptListViewModel
@{
    Layout = "_AdminLayout";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h5 class="mb-0">Phiếu nhập kho</h5>
            <small class="text-muted">@Model.TotalCount phiếu nhập</small>
        </div>
        @if (User.HasPermission("import_receipts.create"))
        {
            <a class="btn btn-primary" asp-action="CreateImportReceipt"><i class="bi bi-plus-circle me-1"></i>Tạo phiếu nhập</a>
        }
    </div>
    <div class="card-body">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success">@success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger">@error</div>
        }

        <form method="get" class="row g-2 mb-3">
            <div class="col-md-3">
                <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Tìm theo #, nhà cung cấp..." />
            </div>
            <div class="col-md-3">
                <select name="supplierId" class="form-select">
                    <option value="">-- Tất cả nhà cung cấp --</option>
                    @foreach (var s in Model.SupplierOptions)
                    {
                        <option value="@s.Value" selected="@(Model.SupplierId.HasValue && Model.SupplierId.Value.ToString() == s.Value)">@s.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <input type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-2">
                <input type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-secondary w-100"><i class="bi bi-search"></i> Lọc</button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Nhà cung cấp</th>
                        <th>Nhân viên nhập</th>
                        <th>Ngày nhập</th>
                        <th>Số dòng</th>
                        <th>Tổng tiền</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">Chưa có phiếu nhập nào</td></tr>
                    }
                    else
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>#@item.Id</td>
                                <td>@item.SupplierName</td>
                                <td>@item.EmployeeName</td>
                                <td>@CommerceFormat.DateTimeText(item.ReceiptDate)</td>
                                <td>@item.LineCount</td>
                                <td>@CommerceFormat.Money(item.TotalAmount)</td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="ImportReceiptDetails" asp-route-id="@item.Id">Chi tiết</a>
                                    @if (User.HasPermission("import_receipts.update"))
                                    {
                                        <a class="btn btn-sm btn-outline-primary" asp-action="EditImportReceipt" asp-route-id="@item.Id">Sửa</a>
                                    }
                                    @if (User.HasPermission("import_receipts.delete"))
                                    {
                                        <form asp-action="DeleteImportReceipt" method="post" class="d-inline" onsubmit="return confirm('Xóa phiếu nhập này? Tồn kho các sản phẩm liên quan sẽ được hoàn tác.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <partial name="~/Views/Shared/Commerce/_Pagination.cshtml"
                 view-data='new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData)
                 {
                     ["Page"] = Model.Page,
                     ["TotalPages"] = Model.TotalPages,
                     ["Action"] = "ImportReceipts",
                     ["RouteValues"] = new Dictionary<string, string?>
                     {
                         ["search"] = Model.Search,
                         ["supplierId"] = Model.SupplierId?.ToString(),
                         ["from"] = Model.From?.ToString("yyyy-MM-dd"),
                         ["to"] = Model.To?.ToString("yyyy-MM-dd")
                     }
                 }' />
    </div>
</div>
