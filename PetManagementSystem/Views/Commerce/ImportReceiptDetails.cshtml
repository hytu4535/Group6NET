@using PetManagementSystem.Helpers
@model PetManagementSystem.ViewModels.Commerce.ImportReceiptDetailsViewModel
@{
    Layout = "_AdminLayout";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Phiếu nhập #@Model.Id</h5>
        <div class="d-flex gap-2">
            @if (User.HasPermission("import_receipts.update"))
            {
                <a class="btn btn-sm btn-outline-primary" asp-action="EditImportReceipt" asp-route-id="@Model.Id">Sửa</a>
            }
            <a class="btn btn-sm btn-outline-secondary" asp-action="ImportReceipts">Quay lại</a>
        </div>
    </div>
    <div class="card-body">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success">@success</div>
        }

        <dl class="row">
            <dt class="col-sm-2">Nhà cung cấp</dt>
            <dd class="col-sm-4">@Model.SupplierName</dd>
            <dt class="col-sm-2">Nhân viên nhập</dt>
            <dd class="col-sm-4">@Model.EmployeeName</dd>

            <dt class="col-sm-2">Ngày nhập</dt>
            <dd class="col-sm-4">@CommerceFormat.DateTimeText(Model.ReceiptDate)</dd>
            <dt class="col-sm-2">Tổng tiền</dt>
            <dd class="col-sm-4 fw-semibold">@CommerceFormat.Money(Model.TotalAmount)</dd>

            <dt class="col-sm-2">Ghi chú</dt>
            <dd class="col-sm-10">@(Model.Note ?? "-")</dd>
        </dl>

        <div class="table-responsive mt-3">
            <table class="table table-striped align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Đơn vị</th>
                        <th>Số lượng</th>
                        <th>Giá nhập</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in Model.Lines)
                    {
                        <tr>
                            <td>@line.ProductName</td>
                            <td>@(line.Unit ?? "-")</td>
                            <td>@line.Quantity</td>
                            <td>@CommerceFormat.Money(line.ImportPrice)</td>
                            <td>@CommerceFormat.Money(line.Subtotal)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
