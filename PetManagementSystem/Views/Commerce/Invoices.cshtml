@using PetManagementSystem.Helpers
@model PetManagementSystem.ViewModels.Commerce.InvoiceListViewModel
@{
    Layout = "_AdminLayout";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h5 class="mb-0">Hóa đơn</h5>
            <small class="text-muted">@Model.TotalCount hóa đơn</small>
        </div>
        @if (User.HasPermission("invoices.create"))
        {
            <a class="btn btn-primary" asp-action="CreateInvoice"><i class="bi bi-plus-circle me-1"></i>Lập hóa đơn</a>
        }
    </div>
    <div class="card-body">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success">@success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger">@error</div>
        }

        <form method="get" class="row g-2 mb-3">
            <div class="col-md-4">
                <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Tìm theo #hóa đơn, #đơn, khách hàng..." />
            </div>
            <div class="col-md-2">
                <input type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-2">
                <input type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-secondary w-100"><i class="bi bi-search"></i> Lọc</button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Đơn hàng</th>
                        <th>Khách hàng</th>
                        <th>Ngày lập</th>
                        <th>Tổng tiền</th>
                        <th>Tiền thuế</th>
                        <th>Người lập</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">Chưa có hóa đơn nào</td></tr>
                    }
                    else
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>#@item.Id</td>
                                <td><a asp-action="OrderDetails" asp-route-id="@item.OrderId">#@item.OrderId</a></td>
                                <td>@item.CustomerName</td>
                                <td>@CommerceFormat.DateTimeText(item.InvoiceDate)</td>
                                <td>@CommerceFormat.Money(item.TotalAmount)</td>
                                <td>@CommerceFormat.Money(item.TaxAmount)</td>
                                <td>@item.IssuedByName</td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="InvoiceDetails" asp-route-id="@item.Id">Chi tiết</a>
                                    @if (User.HasPermission("invoices.update"))
                                    {
                                        <a class="btn btn-sm btn-outline-primary" asp-action="EditInvoice" asp-route-id="@item.Id">Sửa</a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <partial name="~/Views/Shared/Commerce/_Pagination.cshtml"
                 view-data='new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData)
                 {
                     ["Page"] = Model.Page,
                     ["TotalPages"] = Model.TotalPages,
                     ["Action"] = "Invoices",
                     ["RouteValues"] = new Dictionary<string, string?>
                     {
                         ["search"] = Model.Search,
                         ["from"] = Model.From?.ToString("yyyy-MM-dd"),
                         ["to"] = Model.To?.ToString("yyyy-MM-dd")
                     }
                 }' />
    </div>
</div>
