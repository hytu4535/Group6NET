@using PetManagementSystem.Helpers
@model PetManagementSystem.ViewModels.Commerce.ImportDetailListViewModel
@{
    Layout = "_AdminLayout";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white">
        <h5 class="mb-0">Chi tiết phiếu nhập</h5>
        <small class="text-muted">@Model.TotalCount dòng nhập kho</small>
    </div>
    <div class="card-body">
        <form method="get" class="row g-2 mb-3">
            <div class="col-md-3">
                <input type="number" name="receiptId" value="@Model.ReceiptId" class="form-control" placeholder="Mã phiếu nhập (#)" />
            </div>
            <div class="col-md-4">
                <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Tìm theo sản phẩm, nhà cung cấp..." />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-secondary w-100"><i class="bi bi-search"></i> Lọc</button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Phiếu nhập</th>
                        <th>Nhà cung cấp</th>
                        <th>Ngày nhập</th>
                        <th>Sản phẩm</th>
                        <th>Đơn vị</th>
                        <th>Số lượng</th>
                        <th>Giá nhập</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">Không có dữ liệu</td></tr>
                    }
                    else
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td><a asp-action="ImportReceiptDetails" asp-route-id="@item.ReceiptId">#@item.ReceiptId</a></td>
                                <td>@item.SupplierName</td>
                                <td>@CommerceFormat.DateTimeText(item.ReceiptDate)</td>
                                <td>@item.ProductName</td>
                                <td>@(item.Unit ?? "-")</td>
                                <td>@item.Quantity</td>
                                <td>@CommerceFormat.Money(item.ImportPrice)</td>
                                <td>@CommerceFormat.Money(item.Subtotal)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <partial name="~/Views/Shared/Commerce/_Pagination.cshtml"
                 view-data='new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData)
                 {
                     ["Page"] = Model.Page,
                     ["TotalPages"] = Model.TotalPages,
                     ["Action"] = "ImportDetails",
                     ["RouteValues"] = new Dictionary<string, string?>
                     {
                         ["receiptId"] = Model.ReceiptId?.ToString(),
                         ["search"] = Model.Search
                     }
                 }' />
    </div>
</div>
