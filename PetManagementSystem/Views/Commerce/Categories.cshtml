@using PetManagementSystem.Helpers
@model PetManagementSystem.ViewModels.Commerce.CategoryListViewModel
@{
    Layout = "_AdminLayout";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h5 class="mb-0">Danh mục sản phẩm</h5>
            <small class="text-muted">@Model.TotalCount danh mục</small>
        </div>
        @if (User.HasPermission("categories.create"))
        {
            <a class="btn btn-primary" asp-action="CreateCategory"><i class="bi bi-plus-circle me-1"></i>Thêm danh mục</a>
        }
    </div>
    <div class="card-body">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success">@success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger">@error</div>
        }

        <form method="get" class="row g-2 mb-3">
            <div class="col-md-4">
                <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Tìm theo tên danh mục..." />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-secondary w-100"><i class="bi bi-search"></i> Tìm</button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Tên danh mục</th>
                        <th>Mô tả</th>
                        <th>Số sản phẩm</th>
                        <th>Ngày tạo</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">Chưa có danh mục nào</td></tr>
                    }
                    else
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.CategoryName</td>
                                <td>@(item.Description ?? "-")</td>
                                <td><span class="badge text-bg-info">@item.ProductCount</span></td>
                                <td>@CommerceFormat.Date(item.CreatedAt)</td>
                                <td class="text-end">
                                    @if (User.HasPermission("categories.update"))
                                    {
                                        <a class="btn btn-sm btn-outline-primary" asp-action="EditCategory" asp-route-id="@item.Id">Sửa</a>
                                    }
                                    @if (User.HasPermission("categories.delete"))
                                    {
                                        <form asp-action="DeleteCategory" method="post" class="d-inline" onsubmit="return confirm('Xóa danh mục này?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <partial name="~/Views/Shared/Commerce/_Pagination.cshtml"
                 view-data='new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData)
                 {
                     ["Page"] = Model.Page,
                     ["TotalPages"] = Model.TotalPages,
                     ["Action"] = "Categories",
                     ["RouteValues"] = new Dictionary<string, string?> { ["search"] = Model.Search }
                 }' />
    </div>
</div>
