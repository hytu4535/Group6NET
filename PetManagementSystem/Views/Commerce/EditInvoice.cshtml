@model PetManagementSystem.ViewModels.Commerce.InvoiceUpsertViewModel
@{
    Layout = "_AdminLayout";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white"><h5 class="mb-0">Cập nhật hóa đơn #@Model.Id</h5></div>
    <div class="card-body">
        <form asp-action="EditInvoice" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <input asp-for="OrderId" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Đơn hàng</label>
                    <input class="form-control" value="@Model.OrderText" disabled />
                </div>
                <div class="col-md-6">
                    <label asp-for="InvoiceDate" class="form-label">Ngày lập hóa đơn</label>
                    <input asp-for="InvoiceDate" class="form-control" type="datetime-local" value="@Model.InvoiceDate.ToString("yyyy-MM-ddTHH:mm")" />
                    <span asp-validation-for="InvoiceDate" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Tổng tiền (theo đơn hàng)</label>
                    <input class="form-control" value="@Model.TotalAmount" disabled />
                </div>
                <div class="col-md-6">
                    <label asp-for="TaxAmount" class="form-label">Tiền thuế</label>
                    <input asp-for="TaxAmount" class="form-control" type="number" step="0.01" min="0" />
                    <span asp-validation-for="TaxAmount" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                <a class="btn btn-outline-secondary" asp-action="InvoiceDetails" asp-route-id="@Model.Id">Quay lại</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
