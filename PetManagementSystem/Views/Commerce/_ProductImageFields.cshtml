@using PetManagementSystem.Helpers
@model PetManagementSystem.ViewModels.Commerce.ProductUpsertViewModel
@{
    var hasImage = !string.IsNullOrWhiteSpace(Model.ImageUrl);
    var isUploaded = hasImage && Model.ImageUrl!.StartsWith("/uploads/products/", StringComparison.OrdinalIgnoreCase);
}
<div class="col-12">
    <label class="form-label">Ảnh sản phẩm</label>
    <div class="d-flex gap-3 align-items-start flex-wrap">
        <img id="product-image-preview" src="@ProductImages.Src(Model.ImageUrl)" alt="Ảnh sản phẩm" onerror="@ProductImages.OnError"
             referrerpolicy="no-referrer" class="border rounded bg-light" style="width:120px;height:120px;object-fit:contain;" />
        <div class="flex-grow-1" style="min-width:260px;">
            <input asp-for="ImageFile" type="file" id="product-image-file" class="form-control"
                   accept="image/jpeg,image/png,image/webp,image/gif" />
            <div class="form-text">Chọn ảnh từ máy (JPG, PNG, WEBP hoặc GIF, tối đa 5 MB). Ảnh được lưu trong <code>wwwroot/uploads/products</code>.</div>
            <span asp-validation-for="ImageFile" class="text-danger"></span>

            @if (isUploaded)
            {
                <input type="hidden" asp-for="ImageUrl" />
            }
            else
            {
                <label asp-for="ImageUrl" class="form-label mt-2 mb-1">Hoặc dán đường dẫn ảnh (http/https)</label>
                <input asp-for="ImageUrl" id="product-image-url" class="form-control" placeholder="https://..." />
            }
            <span asp-validation-for="ImageUrl" class="text-danger"></span>

            @if (hasImage)
            {
                <div class="form-check mt-2">
                    <input asp-for="RemoveImage" class="form-check-input" />
                    <label asp-for="RemoveImage" class="form-check-label">Bỏ ảnh hiện tại</label>
                </div>
            }
        </div>
    </div>
</div>

<script>
    (function () {
        var preview = document.getElementById('product-image-preview');
        var file = document.getElementById('product-image-file');
        var url = document.getElementById('product-image-url');
        var placeholder = '@ProductImages.Placeholder';
        if (!preview) { return; }

        if (file) {
            file.addEventListener('change', function () {
                if (file.files && file.files[0]) {
                    preview.src = URL.createObjectURL(file.files[0]);
                }
            });
        }
        if (url) {
            url.addEventListener('change', function () {
                preview.src = url.value.trim() || placeholder;
            });
        }
    })();
</script>
