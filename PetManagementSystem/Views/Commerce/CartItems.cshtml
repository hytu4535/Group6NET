@using PetManagementSystem.Helpers
@model PetManagementSystem.ViewModels.Commerce.CartItemListViewModel
@{
    Layout = "_AdminLayout";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white">
        <h5 class="mb-0">Chi tiết giỏ hàng</h5>
        <small class="text-muted">@Model.TotalCount giỏ hàng</small>
    </div>
    <div class="card-body">
        <form method="get" class="row g-2 mb-3">
            <div class="col-md-3">
                <input type="number" name="cartId" value="@Model.CartId" class="form-control" placeholder="Mã giỏ hàng (#)" />
            </div>
            <div class="col-md-4">
                <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Tìm theo sản phẩm, khách hàng..." />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-secondary w-100"><i class="bi bi-search"></i> Lọc</button>
            </div>
        </form>

        @if (!Model.Items.Any())
        {
            <div class="text-center text-muted py-4">Không có dữ liệu</div>
        }
        else
        {
            foreach (var cart in Model.Items)
            {
                <div class="card mb-4 shadow-sm" id="cart-@cart.CartId" style="border-left: 4px solid var(--bs-primary);">
                    <div class="card-header bg-light d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div>
                            <h6 class="mb-0">
                                <a asp-action="CartDetails" asp-route-id="@cart.CartId" class="text-decoration-none">Giỏ hàng #@cart.CartId</a>
                                <span class="badge ms-2 @CartStatuses.Badge(cart.Status)">@CartStatuses.Label(cart.Status)</span>
                            </h6>
                            <small class="text-muted">
                                Khách hàng: <strong>@cart.CustomerName</strong>@(string.IsNullOrEmpty(cart.Username) ? "" : $" ({cart.Username})")
                                @if ((cart.UpdatedAt ?? cart.CreatedAt) is DateTime changedAt)
                                {
                                    <span> &middot; Cập nhật: @CommerceFormat.DateTimeText(changedAt)</span>
                                }
                            </small>
                        </div>
                        <div class="text-end">
                            <div class="small text-muted">@cart.Items.Count dòng sản phẩm</div>
                            <div class="fw-bold">Tổng: @CommerceFormat.Money(cart.TotalAmount)</div>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th>Đơn vị</th>
                                    <th class="text-end">Số lượng</th>
                                    <th class="text-end">Đơn giá</th>
                                    <th class="text-end">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in cart.Items)
                                {
                                    <tr>
                                        <td>@item.ProductName</td>
                                        <td>@(item.Unit ?? "-")</td>
                                        <td class="text-end">@item.Quantity</td>
                                        <td class="text-end">@CommerceFormat.Money(item.Price)</td>
                                        <td class="text-end">@CommerceFormat.Money(item.Subtotal)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }

        <partial name="~/Views/Shared/Commerce/_Pagination.cshtml"
                 view-data='new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData)
                 {
                     ["Page"] = Model.Page,
                     ["TotalPages"] = Model.TotalPages,
                     ["Action"] = "CartItems",
                     ["RouteValues"] = new Dictionary<string, string?> { ["cartId"] = Model.CartId?.ToString(), ["search"] = Model.Search }
                 }' />
    </div>
</div>
