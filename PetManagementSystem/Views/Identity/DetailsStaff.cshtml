@model PetManagementSystem.Models.Staff
@{
    Layout = "_AdminLayout";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center"><div><h5 class="mb-0">Chi tiết nhân viên</h5><small class="text-muted">Thông tin tài khoản và hồ sơ nhân viên</small></div><a class="btn btn-sm btn-primary" asp-action="EditStaff" asp-route-id="@Model.Id">Chỉnh sửa</a></div>
    <div class="card-body">
        <h6 class="border-bottom pb-2">Thông tin người dùng</h6>
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label class="form-label">Email</label>
                <p class="form-control-plaintext">@(Model.User?.Email ?? "-")</p>
            </div>
            <div class="col-md-6">
                <label class="form-label">Số điện thoại</label>
                <p class="form-control-plaintext">@(Model.User?.PhoneNumber ?? "-")</p>
            </div>
            <div class="col-md-6">
                <label class="form-label">Địa chỉ</label>
                <p class="form-control-plaintext">@(Model.User?.Address ?? "-")</p>
            </div>
            <div class="col-md-6">
                <label class="form-label">Vai trò</label>
                <p class="form-control-plaintext">@(Model.User?.Role?.Name ?? "-")</p>
            </div>
        </div>
        <h6 class="border-bottom pb-2">Thông tin nhân viên</h6>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Người dùng</label>
                <p class="form-control-plaintext">@Model.User?.Username</p>
            </div>
            <div class="col-md-6">
                <label class="form-label">Họ và tên người dùng</label>
                <p class="form-control-plaintext">@Model.User?.FullName</p>
            </div>
            <div class="col-md-6">
                <label class="form-label">Chức vụ</label>
                <p class="form-control-plaintext">@Model.Position</p>
            </div>
            <div class="col-md-6">
                <label class="form-label">Ngày tuyển</label>
                <p class="form-control-plaintext">@Model.HireDate?.ToString("yyyy-MM-dd")</p>
            </div>
            <div class="col-md-6">
                <label class="form-label">Trạng thái</label>
                <span class="badge @(Model.Status == "active" ? "text-bg-success" : (Model.Status == "inactive" ? "text-bg-warning" : "text-bg-danger"))">
                    @(Model.Status == "active" ? "Hoạt động" : Model.Status == "inactive" ? "Khóa" : Model.Status == "deleted" ? "Đã xóa" : Model.Status)
                </span>
            </div>
            <div class="col-md-6">
                <label class="form-label">Ngày tạo</label>
                <p class="form-control-plaintext">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
            <div class="col-md-6">
                <label class="form-label">Ngày cập nhật</label>
                <p class="form-control-plaintext">@(Model.UpdatedAt.HasValue ? Model.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm") : "-")</p>
            </div>
        </div>
    </div>
    <div class="card-footer d-flex justify-content-end">
        <a class="btn btn-outline-secondary" asp-action="Staff">Quay lại danh sách</a>
    </div>
</div>