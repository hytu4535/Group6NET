@model List<PetManagementSystem.Models.Permission>
@{
    Layout = "_AdminLayout";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Danh sách quyền</h5>
        <a class="btn btn-primary" asp-action="CreatePermission"><i class="bi bi-plus-circle me-1"></i>Tạo quyền</a>
    </div>
    <div class="card-body">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @success
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @error
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Info"] is string info)
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @info
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Mã quyền</th>
                        <th>Tên quyền</th>
                        <th>Mô tả</th>
                        <th>Module</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Chưa có quyền nào</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Code</td>
                                <td>@item.Name</td>
                                <td>@(item.Description ?? "-")</td>
                                <td>@item.Module</td>
                                <td>
                                    <span class="badge @(item.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                        @if (item.IsActive)
                                        {
                                            @:"Hoạt động"
                                        }
                                        else
                                        {
                                            @:"Khóa"
                                        }
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-info" asp-action="DetailsPermission" asp-route-id="@item.Id" title="Xem chi tiết"><i class="bi bi-eye"></i></a>
                                    <a class="btn btn-sm btn-outline-primary" asp-action="EditPermission" asp-route-id="@item.Id" title="Chỉnh sửa"><i class="bi bi-pencil-square"></i></a>
                                    <form asp-action="SoftDeletePermission" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa quyền này khỏi danh sách?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa mềm"><i class="bi bi-trash"></i></button>
                                        @Html.AntiForgeryToken()
                                    </form>
                                    <form asp-action="LockPermission" asp-route-id="@item.Id" method="post">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary" title="@(item.IsActive ? "Khóa" : "Mở khóa")"><i class="bi bi-lock"></i></button>
                                        @Html.AntiForgeryToken()
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>