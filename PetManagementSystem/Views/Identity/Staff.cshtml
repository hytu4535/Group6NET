@model List<PetManagementSystem.Models.Staff>
@{
    Layout = "_AdminLayout";
    var items = ViewData["PageItems"] as List<PetManagementSystem.Models.Staff> ?? Model;
    var page = (int?)ViewData["Page"] ?? 1;
    var totalPages = (int?)ViewData["TotalPages"] ?? 1;
    var search = ViewData["Search"] as string;
    var position = ViewData["Position"] as string;
    var hireDateFrom = ViewData["HireDateFrom"] as string;
    var hireDateTo = ViewData["HireDateTo"] as string;
    var status = ViewData["Status"] as string ?? "active";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Danh sách nhân viên</h5>
        <a class="btn btn-primary" asp-action="CreateStaff"><i class="bi bi-plus-circle me-1"></i>Tạo nhân viên</a>
    </div>
    <div class="card-body">
        <form method="get" class="row g-2 mb-3"><div class="col-md-3"><input name="search" value="@search" class="form-control" placeholder="Username hoặc họ tên..." /></div><div class="col-md-2"><input name="position" value="@position" class="form-control" placeholder="Chức vụ..." /></div><div class="col-md-2"><input type="date" name="hireDateFrom" value="@hireDateFrom" class="form-control" title="Từ ngày tuyển" /></div><div class="col-md-2"><input type="date" name="hireDateTo" value="@hireDateTo" class="form-control" title="Đến ngày tuyển" /></div><div class="col-md-2"><select name="status" class="form-select"><option value="all" selected="@(status == "all")">Tất cả trạng thái</option><option value="active" selected="@(status == "active")">Hoạt động</option><option value="inactive" selected="@(status == "inactive")">Khóa</option><option value="deleted" selected="@(status == "deleted")">Đã xóa</option></select></div><div class="col-md-1"><button class="btn btn-outline-secondary w-100" type="submit">Lọc</button></div><div class="col-12"><a asp-action="Staff" class="btn btn-sm btn-outline-secondary">Xóa lọc</a></div></form>
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @success
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @error
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Info"] is string info)
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @info
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Username</th>
                        <th>Họ tên</th>
                        <th>Chức vụ</th>
                        <th>Ngày tuyển</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        var statusText = item.Status switch
                        {
                            "active" => "Hoạt động",
                            "inactive" => "Khóa",
                            "deleted" => "Đã xóa",
                            _ => item.Status
                        };
                        <tr>
                            <td>@item.User?.Username</td>
                            <td>@item.User?.FullName</td>
                            <td>@item.Position</td>
                            <td>@item.HireDate?.ToString("yyyy-MM-dd")</td>
                            <td>
                                <span class="badge @(item.Status == "active" ? "text-bg-success" :
                                              item.Status == "inactive" ? "text-bg-warning" :
                                              item.Status == "deleted" ? "text-bg-danger" :
                                              "text-bg-secondary")">
                                    @statusText
                                </span>
                            </td>
                            <td class="text-end">
                                    <div class="d-flex gap-1 flex-wrap w-100 justify-content-end">
                                        <a class="btn btn-sm btn-outline-info" asp-action="DetailsStaff" asp-route-id="@item.Id" title="Xem chi tiết"><i class="bi bi-eye"></i></a>
                                        <a class="btn btn-sm btn-outline-primary" asp-action="EditStaff" asp-route-id="@item.Id" title="Chỉnh sửa"><i class="bi bi-pencil-square"></i></a>
                                        <div class="w-100"></div>
                                        <form asp-action="SoftDeleteStaff" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa nhân viên này khỏi danh sách?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa mềm"><i class="bi bi-trash"></i></button>
                                            @Html.AntiForgeryToken()
                                        </form>
                                        <form asp-action="LockStaff" asp-route-id="@item.Id" method="post">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary" title="@(item.Status == "active" ? "Khóa" : "Mở khóa")"><i class="bi bi-lock"></i></button>
                                            @Html.AntiForgeryToken()
                                        </form>
                                    </div>
                                </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (totalPages > 1)
        {
            <nav class="mt-3"><ul class="pagination justify-content-center">
                @for (var i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == page ? "active" : "")"><a class="page-link" asp-action="Staff" asp-route-page="@i" asp-route-search="@search" asp-route-position="@position" asp-route-hireDateFrom="@hireDateFrom" asp-route-hireDateTo="@hireDateTo" asp-route-status="@status">@i</a></li>
                }
            </ul></nav>
        }
    </div>
</div>