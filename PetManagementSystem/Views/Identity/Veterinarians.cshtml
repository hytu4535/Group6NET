@model List<PetManagementSystem.Models.Veterinarian>
@{
    Layout = "_AdminLayout";
    var items = ViewData["PageItems"] as IEnumerable<PetManagementSystem.Models.Veterinarian> ?? Model;
    var page = (int?)ViewData["Page"] ?? 1;
    var totalPages = (int?)ViewData["TotalPages"] ?? 1;
    var search = ViewData["Search"] as string;
    var specialty = ViewData["Specialty"] as string;
    var licenseNo = ViewData["LicenseNo"] as string;
    var minExperience = ViewData["MinExperience"] as int?;
    var maxExperience = ViewData["MaxExperience"] as int?;
    var status = ViewData["Status"] as string ?? "all";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Danh sách bác sĩ thú y</h5>
        <a class="btn btn-primary" asp-action="CreateVeterinarian"><i class="bi bi-plus-circle me-1"></i>Tạo bác sĩ</a>
    </div>
    <div class="card-body">
            <div class="col-md-2"><select name="status" class="form-select"><option value="all" selected="@(status == "all")">Hoạt động / Khóa</option><option value="active" selected="@(status == "active")">Hoạt động</option><option value="inactive" selected="@(status == "inactive")">Khóa / Ngưng hoạt động</option><option value="deleted" selected="@(status == "deleted")">Không hoạt động</option></select></div>
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @success
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @error
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Info"] is string info)
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @info
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Username</th>
                        <th>Họ tên</th>
                        <th>Chuyên môn</th>
                        <th>Số chứng chỉ</th>
                        <th>Kinh nghiệm</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        var statusText = item.Status switch
                        {
                            "active" => "Hoạt động",
                            "inactive" => "Khóa / Ngưng hoạt động",
                            "deleted" => "Không hoạt động",
                            _ => item.Status
                        };
                        <tr>
                            <td>@item.User?.Username</td>
                            <td>@item.User?.FullName</td>
                            <td>@item.Specialty</td>
                            <td>@item.LicenseNo</td>
                            <td>@item.YearsOfExperience năm</td>
                            <td>
                                <span class="badge @(item.Status == "active" ? "text-bg-success" :
                                              item.Status == "inactive" ? "text-bg-warning" :
                                              item.Status == "deleted" ? "text-bg-danger" :
                                              "text-bg-secondary")">
                                    @statusText
                                </span>
                            </td>
                            <td class="text-end">
                                    <div class="d-flex gap-1 flex-wrap w-100 justify-content-end">
                                        <a class="btn btn-sm btn-outline-info" asp-action="DetailsVeterinarian" asp-route-id="@item.Id" title="Xem chi tiết"><i class="bi bi-eye"></i></a>
                                        <a class="btn btn-sm btn-outline-primary" asp-action="EditVeterinarian" asp-route-id="@item.Id" title="Chỉnh sửa"><i class="bi bi-pencil-square"></i></a>
                                        <div class="w-100"></div>
                                        <form asp-action="SoftDeleteVeterinarian" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Tài khoản có dữ liệu sẽ xóa mềm, tài khoản chưa có dữ liệu sẽ xóa cứng. Tiếp tục?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa tài khoản (tự động mềm/cứng)"><i class="bi bi-trash"></i></button>
                                            @Html.AntiForgeryToken()
                                        </form>
                                    </div>
                                </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (totalPages > 1)
        {
            <nav class="mt-3"><ul class="pagination justify-content-center">
                @for (var i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == page ? "active" : "")"><a class="page-link" asp-action="Veterinarians" asp-route-page="@i" asp-route-search="@search" asp-route-specialty="@specialty" asp-route-licenseNo="@licenseNo" asp-route-minExperience="@minExperience" asp-route-maxExperience="@maxExperience" asp-route-status="@status">@i</a></li>
                }
            </ul></nav>
        }
    </div>
</div>