@model List<PetManagementSystem.Models.Veterinarian>
@{
    Layout = "_AdminLayout";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Danh sách bác sĩ thú y</h5>
        <a class="btn btn-primary" asp-action="CreateVeterinarian"><i class="bi bi-plus-circle me-1"></i>Tạo bác sĩ</a>
    </div>
    <div class="card-body">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success">@success</div>
        }
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Username</th>
                        <th>Họ tên</th>
                        <th>Chuyên môn</th>
                        <th>License</th>
                        <th>Kinh nghiệm</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.User?.Username</td>
                            <td>@item.User?.FullName</td>
                            <td>@item.Specialty</td>
                            <td>@item.LicenseNo</td>
                            <td>@item.YearsOfExperience năm</td>
                            <td><span class="badge @(item.Status == "active" ? "text-bg-success" : "text-bg-secondary")">@item.Status</span></td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" asp-action="EditVeterinarian" asp-route-id="@item.Id">Cập nhật</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
