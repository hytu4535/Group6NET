@model PetManagementSystem.Models.User
@{
    Layout = "_AdminLayout";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <div><h5 class="mb-0">Chi tiết người dùng</h5><small class="text-muted">Thông tin tài khoản và hồ sơ liên kết</small></div>
        <a class="btn btn-sm btn-primary" asp-action="EditUser" asp-route-id="@Model.Id">Chỉnh sửa</a>
    </div>
    <div class="card-body">
        <h6 class="border-bottom pb-2">Thông tin tài khoản</h6>
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label class="form-label">Tên tài khoản</label>
                <p class="form-control-plaintext">@Model.Username</p>
            </div>
            <div class="col-md-6">
                <label class="form-label">Vai trò</label>
                <p class="form-control-plaintext">@Model.Role?.Name</p>
            </div>
            <div class="col-md-6">
                <label class="form-label">Họ và tên</label>
                <p class="form-control-plaintext">@Model.FullName</p>
            </div>
            <div class="col-md-6">
                <label class="form-label">Email</label>
                <p class="form-control-plaintext">@Model.Email</p>
            </div>
            <div class="col-md-6">
                <label class="form-label">Số điện thoại</label>
                <p class="form-control-plaintext">@Model.PhoneNumber</p>
            </div>
            <div class="col-md-6">
                <label class="form-label">Địa chỉ</label>
                <p class="form-control-plaintext">@Model.Address</p>
            </div>
            <div class="col-md-6">
                <label class="form-label">Trạng thái</label>
                <span class="badge @(Model.Status == "active" ? "text-bg-success" : (Model.Status == "inactive" ? "text-bg-warning" : "text-bg-danger"))">
                    @(Model.Status == "active" ? "Hoạt động" : Model.Status == "inactive" ? "Khóa" : Model.Status == "deleted" ? "Đã xóa" : Model.Status)
                </span>
            </div>
            <div class="col-md-6">
                <label class="form-label">Ngày tạo</label>
                <p class="form-control-plaintext">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
            <div class="col-md-6">
                <label class="form-label">Ngày cập nhật</label>
                <p class="form-control-plaintext">@(Model.UpdatedAt.HasValue ? Model.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm") : "-")</p>
            </div>
        </div>
        @if (Model.Staff is not null)
        {
            <h6 class="border-bottom pb-2">Hồ sơ nhân viên</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-4"><label class="form-label">Chức vụ</label><p class="form-control-plaintext">@(Model.Staff.Position ?? "-")</p></div>
                <div class="col-md-4"><label class="form-label">Ngày tuyển</label><p class="form-control-plaintext">@(Model.Staff.HireDate?.ToString("dd/MM/yyyy") ?? "-")</p></div>
                <div class="col-md-4"><label class="form-label">Trạng thái hồ sơ</label><p class="form-control-plaintext">@(Model.Staff.Status == "active" ? "Hoạt động" : Model.Staff.Status == "inactive" ? "Khóa" : Model.Staff.Status)</p></div>
            </div>
        }
        @if (Model.Veterinarian is not null)
        {
            <h6 class="border-bottom pb-2">Hồ sơ bác sĩ thú y</h6>
            <div class="row g-3">
                <div class="col-md-4"><label class="form-label">Chuyên môn</label><p class="form-control-plaintext">@(Model.Veterinarian.Specialty ?? "-")</p></div>
                <div class="col-md-4"><label class="form-label">Số chứng chỉ</label><p class="form-control-plaintext">@(Model.Veterinarian.LicenseNo ?? "-")</p></div>
                <div class="col-md-4"><label class="form-label">Kinh nghiệm</label><p class="form-control-plaintext">@(Model.Veterinarian.YearsOfExperience.HasValue ? $"{Model.Veterinarian.YearsOfExperience} năm" : "-")</p></div>
            </div>
        }
    </div>
    <div class="card-footer d-flex justify-content-end gap-2">
        @if (Model.Staff is not null) { <a class="btn btn-outline-primary" asp-action="DetailsStaff" asp-route-id="@Model.Staff.Id">Xem hồ sơ nhân viên</a> }
        @if (Model.Veterinarian is not null) { <a class="btn btn-outline-primary" asp-action="DetailsVeterinarian" asp-route-id="@Model.Veterinarian.Id">Xem hồ sơ bác sĩ</a> }
        <a class="btn btn-outline-secondary" asp-action="Users">Quay lại danh sách</a>
    </div>
</div>