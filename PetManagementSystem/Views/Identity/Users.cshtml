@model List<PetManagementSystem.Models.User>
@{
    Layout = "_AdminLayout";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Danh sách người dùng</h5>
        <a class="btn btn-primary" asp-action="CreateUser"><i class="bi bi-plus-circle me-1"></i>Tạo người dùng</a>
    </div>
    <div class="card-body">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @success
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @error
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Info"] is string info)
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @info
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Username</th>
                        <th>Họ tên</th>
                        <th>Email</th>
                        <th>Điện thoại</th>
                        <th>Vai trò</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Username</td>
                            <td>@item.FullName</td>
                            <td>@item.Email</td>
                            <td>@item.PhoneNumber</td>
                            <td><span class="badge text-bg-secondary">@item.Role?.Name</span></td>
                            <td>
                                <span class="badge @(item.Status == "active" ? "text-bg-success" :
                                              item.Status == "inactive" ? "text-bg-warning" :
                                              item.Status == "deleted" ? "text-bg-danger" :
                                              "text-bg-secondary")">
                                    @switch (item.Status)
                                    {
                                        case "active":
                                            @:"Hoạt động";
                                            break;
                                        case "inactive":
                                            @:"Khóa";
                                            break;
                                        case "deleted":
                                            @:"Đã xóa";
                                            break;
                                        default:
                                            @:item.Status;
                                            break;
                                    }
                                </span>
                            </td>
                            <td class="text-end">
                                    <div class="d-flex gap-1 flex-wrap w-100 justify-content-end">
                                        <a class="btn btn-sm btn-outline-info" asp-action="DetailsUser" asp-route-id="@item.Id" title="Xem chi tiết"><i class="bi bi-eye"></i></a>
                                        <a class="btn btn-sm btn-outline-primary" asp-action="EditUser" asp-route-id="@item.Id" title="Chỉnh sửa"><i class="bi bi-pencil-square"></i></a>
                                        <div class="w-100"></div>
                                        <form asp-action="SoftDeleteUser" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa người dùng này khỏi danh sách?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa mềm"><i class="bi bi-trash"></i></button>
                                            @Html.AntiForgeryToken()
                                        </form>
                                        <form asp-action="LockUser" asp-route-id="@item.Id" method="post">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary" title="@(item.Status == "active" ? "Khóa" : "Mở khóa")"><i class="bi bi-lock"></i></button>
                                            @Html.AntiForgeryToken()
                                        </form>
                                    </div>
                                </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>