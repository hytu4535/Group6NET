@model List<PetManagementSystem.Models.User>
@{
    Layout = "_AdminLayout";
    var items = ViewData["PageItems"] as List<PetManagementSystem.Models.User> ?? Model;
    var page = (int?)ViewData["Page"] ?? 1;
    var totalPages = (int?)ViewData["TotalPages"] ?? 1;
    var search = ViewData["Search"] as string;
    var selectedRoleId = ViewData["RoleId"] as int?;
    var status = ViewData["Status"] as string ?? "all";
    var roleOptions = ViewData["RoleOptions"] as List<PetManagementSystem.Models.Role> ?? [];
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Danh sách người dùng</h5>
        <a class="btn btn-primary" asp-action="CreateUser"><i class="bi bi-plus-circle me-1"></i>Tạo người dùng</a>
    </div>
    <div class="card-body">
        <form method="get" class="row g-2 mb-3">
            <div class="col-md-4"><input name="search" value="@search" class="form-control" placeholder="Tìm tên đăng nhập, họ tên, email, điện thoại..." /></div>
            <div class="col-md-2"><select name="roleId" class="form-select"><option value="">Tất cả vai trò</option>@foreach (var role in roleOptions) { <option value="@role.Id" selected="@(selectedRoleId == role.Id)">@role.Name</option> }</select></div>
            <div class="col-md-2"><select name="status" class="form-select"><option value="all" selected="@(status == "all")">Đang hoạt động / bị khóa</option><option value="active" selected="@(status == "active")">Hoạt động</option><option value="inactive" selected="@(status == "inactive")">Khóa</option><option value="deleted" selected="@(status == "deleted")">Không hoạt động</option></select></div>
            <div class="col-md-2"><button class="btn btn-outline-secondary w-100" type="submit"><i class="bi bi-search"></i> Lọc</button></div>
            <div class="col-md-2"><a asp-action="Users" class="btn btn-outline-secondary w-100">Xóa lọc</a></div>
        </form>
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @success
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @error
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Info"] is string info)
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @info
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Username</th>
                        <th>Họ tên</th>
                        <th>Email</th>
                        <th>Điện thoại</th>
                        <th>Vai trò</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        var statusText = item.Status switch
                        {
                            "active" => "Hoạt động",
                            "inactive" => "Khóa",
                            "deleted" => "Không hoạt động",
                            _ => item.Status
                        };
                        <tr>
                            <td>@item.Username</td>
                            <td>@item.FullName</td>
                            <td>@item.Email</td>
                            <td>@item.PhoneNumber</td>
                            <td><span class="badge text-bg-secondary">@item.Role?.Name</span></td>
                            <td>
                                <span class="badge @(item.Status == "active" ? "text-bg-success" :
                                              item.Status == "inactive" ? "text-bg-warning" :
                                              item.Status == "deleted" ? "text-bg-danger" :
                                              "text-bg-secondary")">
                                    @statusText
                                </span>
                            </td>
                            <td class="text-end">
                                    <div class="d-flex gap-1 flex-wrap w-100 justify-content-end">
                                        <a class="btn btn-sm btn-outline-info" asp-action="DetailsUser" asp-route-id="@item.Id" title="Xem chi tiết"><i class="bi bi-eye"></i></a>
                                        <a class="btn btn-sm btn-outline-primary" asp-action="EditUser" asp-route-id="@item.Id" title="Chỉnh sửa"><i class="bi bi-pencil-square"></i></a>
                                        <div class="w-100"></div>
                                        <form asp-action="SoftDeleteUser" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa người dùng này khỏi danh sách?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa mềm"><i class="bi bi-trash"></i></button>
                                            @Html.AntiForgeryToken()
                                        </form>
                                        @if (item.Status != "deleted")
                                        {
                                            <form asp-action="LockUser" asp-route-id="@item.Id" method="post">
                                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="@(item.Status == "active" ? "Khóa tài khoản" : "Mở khóa tài khoản")">
                                                    <i class="bi @(item.Status == "active" ? "bi-lock" : "bi-unlock")"></i>
                                                </button>
                                                @Html.AntiForgeryToken()
                                            </form>
                                        }
                                    </div>
                                </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (totalPages > 1)
        {
            <nav class="mt-3"><ul class="pagination justify-content-center">
                @for (var i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == page ? "active" : "")"><a class="page-link" asp-action="Users" asp-route-page="@i" asp-route-search="@search" asp-route-roleId="@selectedRoleId" asp-route-status="@status">@i</a></li>
                }
            </ul></nav>
        }
    </div>
</div>