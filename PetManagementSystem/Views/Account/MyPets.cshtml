@model IEnumerable<PetManagementSystem.Models.Pet>

@{
    ViewData["Title"] = "Thú cưng của tôi";
}

<h2 class="mb-4">Thú cưng của tôi</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Bạn chưa có thú cưng nào. <a asp-controller="Pets" asp-action="Create">Thêm thú cưng đầu tiên</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 g-4">
        @foreach (var pet in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="ratio ratio-1x1">
                        <img src="@(pet.PetImages.FirstOrDefault(pi => pi.IsAvatar == true)?.ImageUrl ?? "/images/default-pet.jpg")" class="card-img-top" alt="@pet.Name">
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@pet.Name</h5>
                        <p class="card-text">
                            <strong>Giống:</strong> @pet.Breed<br>
                            <strong>Loài:</strong> @pet.Species<br>
                            <strong>Cân nặng:</strong> @pet.WeightKg kg
                        </p>
                        <a asp-controller="Pets" asp-action="Details" asp-route-id="@pet.Id" class="btn btn-primary mt-auto">Xem chi tiết</a>
                    </div>
                </div>
            </div>
        }
    </div>
}