@model IEnumerable<PetManagementSystem.Models.Pet>

@{
    ViewData["Title"] = "Thú cưng của tôi";
}

<h2 class="mb-4">Thú cưng của tôi</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Bạn chưa có thú cưng nào. <a asp-controller="Pets" asp-action="Create">Thêm thú cưng đầu tiên</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 g-4">
        @foreach (var pet in Model)
        {
            var avatarUrl = pet.PetImages
                .Where(image => image.IsAvatar)
                .OrderByDescending(image => image.Id)
                .Select(image => image.ImageUrl)
                .FirstOrDefault()
                ?? pet.PetImages
                    .OrderByDescending(image => image.Id)
                    .Select(image => image.ImageUrl)
                    .FirstOrDefault()
                ?? "/images/pet-avatar-default.jpeg";
            <div class="col">
                <div class="card h-100 shadow-sm overflow-hidden">
                    <div class="row g-0 align-items-center h-100">
                        <div class="col-4">
                            <div class="ratio ratio-1x1">
                                <img src="@avatarUrl"
                                     class="w-100 h-100 object-fit-cover" alt="@pet.Name"
                                     onerror="this.onerror=null;this.src='/images/pet-avatar-default.jpeg';">
                            </div>
                        </div>
                        <div class="col-8">
                            <div class="card-body d-flex flex-column h-100">
                                <h5 class="card-title">@pet.Name</h5>
                                <p class="card-text small">
                                    <strong>Giống:</strong> @pet.Breed<br>
                                    <strong>Loài:</strong> @pet.Species<br>
                                    <strong>Cân nặng:</strong> @pet.WeightKg kg
                                </p>
                                <a asp-controller="Pets" asp-action="Details" asp-route-id="@pet.Id" class="btn btn-primary btn-sm mt-auto">Xem chi tiết</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}