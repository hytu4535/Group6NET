@model IEnumerable<PetManagementSystem.Models.Pet>

@{
    ViewData["Title"] = "Thú cưng của tôi";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1"><i class="bi bi-paw me-2"></i>Thú cưng của tôi</h2>
            <p class="text-muted mb-0">Quản lý thông tin và hình ảnh các bé thú cưng của bạn.</p>
        </div>
        <a asp-controller="Pets" asp-action="Create" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-plus-lg me-1"></i>Thêm thú cưng
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 text-center py-5 px-4 my-4 bg-white">
            <div class="card-body py-4">
                <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 90px; height: 90px;">
                    <i class="bi bi-heart text-danger display-5"></i>
                </div>
                <h4 class="fw-bold mb-2 text-dark">Bạn chưa có thú cưng nào</h4>
                <p class="text-muted mb-4 mx-auto" style="max-width: 480px;">
                    Hãy thêm hồ sơ thú cưng đầu tiên của bạn để dễ dàng đặt lịch khám, theo dõi sức khỏe và quản lý lịch tiêm phòng.
                </p>
                <a asp-controller="Pets" asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
                    <i class="bi bi-plus-lg me-1"></i>Thêm thú cưng ngay
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var pet in Model)
            {
                var avatarUrl = pet.PetImages?.FirstOrDefault(pi => pi.IsAvatar == true)?.ImageUrl 
                    ?? pet.PetImages?.OrderByDescending(pi => pi.UploadedAt).FirstOrDefault()?.ImageUrl 
                    ?? "/dist/assets/img/default-150x150.png";

                <div class="col">
                    <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden">
                        <div class="ratio ratio-1x1 bg-light">
                            <img src="@avatarUrl" class="card-img-top object-fit-cover" alt="@pet.Name" onerror="this.src='/dist/assets/img/default-150x150.png';">
                        </div>
                        <div class="card-body d-flex flex-column p-4">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title fw-bold text-dark mb-0">@pet.Name</h5>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 rounded-pill small">@pet.Species</span>
                            </div>
                            <p class="card-text text-muted small mb-3">
                                <strong>Giống:</strong> @(string.IsNullOrEmpty(pet.Breed) ? "Không rõ" : pet.Breed)
                            </p>

                            <div class="mb-3 p-3 bg-light rounded-3 small">
                                <div class="d-flex justify-content-between text-muted mb-1">
                                    <span>Giới tính:</span>
                                    <span class="fw-semibold text-dark">@(pet.Gender == "Male" ? "Đực" : "Cái")</span>
                                </div>
                                <div class="d-flex justify-content-between text-muted">
                                    <span>Cân nặng:</span>
                                    <span class="fw-semibold text-dark">@(pet.WeightKg.HasValue ? $"{pet.WeightKg} kg" : "N/A")</span>
                                </div>
                            </div>

                            <div class="d-flex gap-2 mt-auto pt-3 border-top">
                                <a asp-controller="Pets" asp-action="Details" asp-route-id="@pet.Id" class="btn btn-outline-primary btn-sm rounded-pill flex-grow-1">
                                    <i class="bi bi-eye me-1"></i>Chi tiết
                                </a>
                                <a asp-controller="Pets" asp-action="Edit" asp-route-id="@pet.Id" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                                    <i class="bi bi-pencil me-1"></i>Sửa
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
