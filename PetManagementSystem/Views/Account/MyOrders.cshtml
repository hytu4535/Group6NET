@model IEnumerable<PetManagementSystem.Models.Order>

@{
    ViewData["Title"] = "Đơn hàng của tôi";
}

<h2 class="mb-4">Đơn hàng của tôi</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Bạn chưa có đơn hàng nào. <a asp-controller="Product" asp-action="Index">Mua sắm ngay</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Ngày đặt</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th>Ghi chú</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@order.TotalAmount.ToString("#,##0") đ</td>
                        <td>
                            @switch (order.Status)
                            {
                                case "pending":
                                    <span class="badge bg-warning text-dark">Chờ xử lý</span>
                                    break;
                                case "confirmed":
                                    <span class="badge bg-success">Đã xác nhận</span>
                                    break;
                                case "shipping":
                                    <span class="badge bg-info">Đang giao</span>
                                    break;
                                case "completed":
                                    <span class="bg-success text-white">Hoàn thành</span>
                                    break;
                                case "cancelled":
                                    <span class="badge bg-danger">Đã hủy</span>
                                    break;
                                case "refunded":
                                    <span class="badge bg-secondary">Hoàn tiền</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">@order.Status</span>
                                    break;
                            }
                        </td>
                        <td>@order.Note</td>
                        <td>
                            <a asp-controller="Order" asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">Chi tiết</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}