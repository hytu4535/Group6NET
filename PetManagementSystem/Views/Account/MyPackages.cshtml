@model List<PetManagementSystem.Models.PetPackage>
@{
    ViewData["Title"] = "Gói dịch vụ đã mua";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">Gói dịch vụ đã mua</h2>
        <a asp-controller="Service" asp-action="Index" class="btn btn-primary btn-sm rounded-pill px-3">
            <i class="bi bi-plus-circle me-1"></i> Mua gói mới
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center py-4">
            <i class="bi bi-info-circle fs-4 d-block mb-2"></i> Bạn chưa đăng ký gói dịch vụ combo nào cho thú cưng.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 g-4">
            @foreach (var pp in Model)
            {
                var isActive = pp.Status == 1 && pp.EndDate >= DateTime.Now;
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 rounded-4">
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="fw-bold text-dark mb-1">@pp.ServicePackage?.Name</h5>
                                    <span class="text-muted small">Thú cưng: <strong class="text-primary">@pp.Pet?.Name</strong></span>
                                </div>
                                @if (isActive)
                                {
                                    <span class="badge bg-success px-3 py-2 rounded-pill">Đang hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-2 rounded-pill">Hết hạn / Đã hủy</span>
                                }
                            </div>

                            <p class="text-muted small mb-3">@pp.ServicePackage?.Description</p>

                            <div class="p-3 bg-light rounded-3 mb-3 small">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted">Ngày bắt đầu:</span>
                                    <strong class="text-dark">@pp.StartDate.ToString("dd/MM/yyyy")</strong>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted">Ngày hết hạn:</span>
                                    <strong class="text-danger">@pp.EndDate.ToString("dd/MM/yyyy")</strong>
                                </div>
                            </div>

                            <div class="mb-3 flex-grow-1">
                                <span class="d-block small text-muted mb-2 fw-semibold">Dịch vụ trong gói:</span>
                                @if (pp.ServicePackage?.ServicePackageServices != null && pp.ServicePackage.ServicePackageServices.Any())
                                {
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var sps in pp.ServicePackage.ServicePackageServices)
                                        {
                                            <span class="badge bg-white text-dark border px-2 py-1">@sps.Service?.Name</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">Không có dịch vụ thành phần</span>
                                }
                            </div>

                            <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-auto">
                                <span class="text-muted small">Giá gói: <strong class="text-danger">@pp.ServicePackage?.Price.ToString("#,##0") đ</strong></span>
                                <a asp-controller="Appointment" asp-action="Book" asp-route-packageId="@pp.PackageId" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                    Đặt lịch ngay
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
