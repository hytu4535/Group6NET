<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pet Management System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <div class="admin-wrapper">
        <!-- Sidebar -->
        <aside class="admin-sidebar">
            <a href="@Url.Action("Dashboard", "Admin")" class="brand-link">
                <i class="bi bi-heart-pulse-fill brand-icon"></i>
                <span class="brand-text">PetCare Admin</span>
            </a>
            <div class="user-panel">
                <i class="bi bi-person-circle"></i>
                <span>Xin chào, Admin</span>
            </div>
            <nav class="sidebar-nav">
                <ul class="nav-list">
                    <li class="@(ViewData["Active"] as string == "Dashboard" ? "active" : "")">
                        <a href="@Url.Action("Dashboard", "Admin")"><i class="bi bi-speedometer2"></i><span>Dashboard</span></a>
                    </li>
                    <li class="nav-section">Quản lý hội viên</li>
                    <li class="@(ViewData["Active"] as string == "Customers" ? "active" : "")">
                        <a href="@Url.Action("Customers", "Admin")"><i class="bi bi-people-fill"></i><span>Khách hàng</span></a>
                    </li>
                    <li class="@(ViewData["Active"] as string == "Pets" ? "active" : "")">
                        <a href="@Url.Action("Pets", "Admin")"><i class="bi bi-heart-fill"></i><span>Thú cưng</span></a>
                    </li>
                    <li class="nav-section">Nhân sự & Dịch vụ</li>
                    <li class="@(ViewData["Active"] as string == "Employees" ? "active" : "")">
                        <a href="@Url.Action("Employees", "Admin")"><i class="bi bi-person-badge-fill"></i><span>Nhân viên</span></a>
                    </li>
                    <li class="@(ViewData["Active"] as string == "Services" ? "active" : "")">
                        <a href="@Url.Action("Services", "Admin")"><i class="bi bi-box-seam-fill"></i><span>Gói dịch vụ</span></a>
                    </li>
                    <li class="@(ViewData["Active"] as string == "Appointments" ? "active" : "")">
                        <a href="@Url.Action("Appointments", "Admin")"><i class="bi bi-calendar-check-fill"></i><span>Lịch hẹn</span></a>
                    </li>
                    <li class="nav-section">Bán hàng</li>
                    <li class="@(ViewData["Active"] as string == "Products" ? "active" : "")">
                        <a href="@Url.Action("Products", "Admin")"><i class="bi bi-basket-fill"></i><span>Sản phẩm</span></a>
                    </li>
                    <li class="@(ViewData["Active"] as string == "Orders" ? "active" : "")">
                        <a href="@Url.Action("Orders", "Admin")"><i class="bi bi-receipt"></i><span>Đơn hàng</span></a>
                    </li>
                    <li class="nav-section">Khác</li>
                    <li class="@(ViewData["Active"] as string == "Feedback" ? "active" : "")">
                        <a href="@Url.Action("Feedback", "Admin")"><i class="bi bi-chat-left-text-fill"></i><span>Phản hồi</span></a>
                    </li>
                </ul>
            </nav>
        </aside>

        <!-- Main content -->
        <div class="admin-main">
            <nav class="admin-topbar">
                <button class="btn-toggle-sidebar" type="button" aria-label="Toggle sidebar">
                    <i class="bi bi-list"></i>
                </button>
                <ol class="breadcrumb-custom">
                    <li><a href="@Url.Action("Dashboard", "Admin")">Trang chủ</a></li>
                    <li class="active">@ViewData["Title"]</li>
                </ol>
            </nav>
            <div class="admin-content">
                <div class="content-header">
                    <h1>@ViewData["Title"]</h1>
                </div>
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
