<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Trang chủ - PetCare</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            background-color: #fde2e4;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #4a2c2a;
        }
        .navbar-brand-custom {
            color: #ff7b72 !important;
            font-weight: 800;
            font-size: 1.5rem;
            letter-spacing: -0.5px;
        }
        .btn-custom-primary {
            background-color: #ff7b72;
            border-color: #ff7b72;
            color: white;
            border-radius: 50px;
            padding: 0.5rem 1.5rem;
            font-weight: 600;
            transition: all 0.2s;
        }
        .btn-custom-primary:hover {
            background-color: #fa655b;
            border-color: #fa655b;
            color: white;
        }
        .nav-link {
            color: #4a2c2a !important;
            font-weight: 500;
            margin: 0 0.25rem;
        }
        .nav-link:hover {
            color: #ff7b72 !important;
        }
    </style>
</head>
<body>
    <div class="container my-3">
        <nav class="navbar navbar-expand-lg navbar-light bg-white px-4 py-3 shadow-sm" style="border-radius: 20px;">
            <div class="container-fluid px-0">
                <a class="navbar-brand navbar-brand-custom" asp-controller="Home" asp-action="Index">PetCare</a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav mx-auto align-items-lg-center">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Services">Dịch vụ</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Product" asp-action="Index">Sản phẩm</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Doctors">Bác sĩ thú y</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Blog">Bài viết & Tips</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Liên hệ</a></li>
                    </ul>
                    <div class="d-flex align-items-center gap-3 mt-3 mt-lg-0">
                        <a class="btn btn-custom-primary text-decoration-none" asp-controller="Home" asp-action="Booking">Đặt lịch ngay</a>
                        <div class="dropdown">
                            <a class="btn btn-light dropdown-toggle rounded-pill px-3 py-2 text-dark border" href="#" role="button" id="accountDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle text-danger me-1"></i> Tài khoản
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 mt-2" aria-labelledby="accountDropdown">
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <li><a class="dropdown-item py-2" asp-controller="Account" asp-action="MyPets"><i class="bi bi-paw me-2 text-muted"></i>Thú cưng của tôi</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Account" asp-action="MyAppointments"><i class="bi bi-calendar-check me-2 text-muted"></i>Lịch hẹn của tôi</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Account" asp-action="MyOrders"><i class="bi bi-bag me-2 text-muted"></i>Đơn hàng của tôi</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Cart" asp-action="Index"><i class="bi bi-cart me-2 text-muted"></i>Giỏ hàng</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2 text-muted"></i>Hồ sơ cá nhân</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key me-2 text-muted"></i>Đổi mật khẩu</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item py-2 text-danger" asp-controller="Auth" asp-action="UserLogin"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                                }
                                else
                                {
                                    <li><a class="dropdown-item py-2" asp-controller="Auth" asp-action="UserLogin"><i class="bi bi-box-arrow-in-right me-2 text-muted"></i>Đăng nhập</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Auth" asp-action="Register"><i class="bi bi-person-plus me-2 text-muted"></i>Đăng ký</a></li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </div>

    <main class="container my-4">
        @RenderBody()
    </main>

    <footer class="text-center py-4 text-muted small">
        <div class="container">
            &copy; 2026 - PetCare - Hệ thống quản lý thú cưng
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
