@using PetManagementSystem.Helpers
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@model PetManagementSystem.ViewModels.Shop.MyOrderListViewModel
@{
    ViewData["Title"] = "Đơn hàng của tôi";
    var pagerData = new ViewDataDictionary(ViewData)
    {
        ["Page"] = Model.Page,
        ["TotalPages"] = Model.TotalPages,
        ["Action"] = "Index",
        ["RouteValues"] = Model.RouteValues
    };
}

<link rel="stylesheet" href="~/css/shop.css" asp-append-version="true" />

<h2 class="mb-4">Đơn hàng của tôi</h2>

<partial name="Shop/_Alerts" />

<form method="get" asp-action="Index" class="card border-0 shadow-sm rounded-4 p-3 mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-12 col-md-4">
            <label class="form-label small mb-1" for="status">Trạng thái</label>
            <select id="status" name="status" class="form-select">
                <option value="">Tất cả</option>
                @foreach (var status in OrderStatuses.All)
                {
                    <option value="@status" selected="@(Model.Status == status)">@OrderStatuses.Label(status)</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label small mb-1" for="from">Từ ngày</label>
            <input id="from" name="from" type="date" class="form-control" value="@Model.From?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label small mb-1" for="to">Đến ngày</label>
            <input id="to" name="to" type="date" class="form-control" value="@Model.To?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-12 col-md-2 d-grid">
            <button type="submit" class="btn btn-shop">Lọc</button>
        </div>
    </div>
    @if (Model.HasFilter)
    {
        <div class="mt-2"><a asp-action="Index" class="small">Xóa bộ lọc</a></div>
    }
</form>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-info">
        @if (Model.HasFilter)
        {
            <span>Không có đơn hàng nào phù hợp với bộ lọc.</span>
        }
        else
        {
            <span>Bạn chưa có đơn hàng nào. <a asp-controller="Product" asp-action="Index">Mua sắm ngay</a></span>
        }
    </div>
}
else
{
    <div class="card border-0 shadow-sm rounded-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã đơn</th>
                        <th>Ngày đặt</th>
                        <th class="text-center">Sản phẩm</th>
                        <th class="text-end">Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th>Thanh toán</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Items)
                    {
                        <tr>
                            <td class="fw-semibold">#@order.Id</td>
                            <td>@CommerceFormat.DateTimeText(order.OrderDate)</td>
                            <td class="text-center">@order.ItemCount</td>
                            <td class="text-end">@CommerceFormat.Money(order.TotalAmount)</td>
                            <td><span class="badge @OrderStatuses.Badge(order.Status)">@OrderStatuses.Label(order.Status)</span></td>
                            <td>
                                @if (order.PaymentStatus is null)
                                {
                                    <span class="text-muted">-</span>
                                }
                                else
                                {
                                    <span class="badge @PaymentStatuses.Badge(order.PaymentStatus)">@PaymentStatuses.Label(order.PaymentStatus)</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">Chi tiết</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <partial name="Commerce/_Pagination" view-data="pagerData" />
}
