@using PetManagementSystem.Helpers
@model PetManagementSystem.ViewModels.Shop.CartViewModel
@{
    ViewData["Title"] = "Giỏ hàng";
}

<link rel="stylesheet" href="~/css/shop.css" asp-append-version="true" />
@Html.AntiForgeryToken()

<h2 class="mb-4">Giỏ hàng của tôi</h2>

<partial name="Shop/_Alerts" />

@if (Model.Items.Count == 0)
{
    <div class="alert alert-info">
        Giỏ hàng của bạn đang trống. <a asp-controller="Product" asp-action="Index">Tiếp tục mua sắm</a>
    </div>
}
else
{
    <div class="card border-0 shadow-sm rounded-4">
        <div class="table-responsive">
            <table id="cart-table" class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Sản phẩm</th>
                        <th class="text-end">Đơn giá</th>
                        <th style="width:130px;">Số lượng</th>
                        <th class="text-end">Thành tiền</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="shop-thumb-sm">
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl" alt="@item.ProductName" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-box-seam text-muted"></i>
                                        }
                                    </div>
                                    <div>
                                        <a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId" class="fw-semibold text-dark text-decoration-none">@item.ProductName</a>
                                        @if (!string.IsNullOrEmpty(item.Unit))
                                        {
                                            <div class="small text-muted">Đơn vị: @item.Unit</div>
                                        }
                                        @if (item.Issue is not null)
                                        {
                                            <div class="small text-danger line-issue"><i class="bi bi-exclamation-triangle me-1"></i>@item.Issue</div>
                                        }
                                        @if (item.PriceChanged)
                                        {
                                            <div class="small text-warning-emphasis">Giá đã được cập nhật theo giá bán hiện tại</div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="text-end">@CommerceFormat.Money(item.UnitPrice)</td>
                            <td>
                                <input type="number" class="form-control form-control-sm qty-input" value="@item.Quantity" data-prev="@item.Quantity"
                                       min="1" max="@Math.Max(1, item.StockQuantity)" data-item-id="@item.ItemId" aria-label="Số lượng" />
                            </td>
                            <td class="text-end fw-semibold line-total">@CommerceFormat.Money(item.LineTotal)</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-danger remove-item" data-item-id="@item.ItemId" title="Xóa khỏi giỏ">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="table-light">
                        <td colspan="3" class="text-end fw-bold">Tổng cộng (<span id="cart-count">@Model.TotalQuantity</span> sản phẩm):</td>
                        <td id="cart-total" class="text-end fw-bold shop-price fs-5">@CommerceFormat.Money(Model.TotalAmount)</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="mt-4 d-flex gap-2">
        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary">Tiếp tục mua sắm</a>
        <a asp-controller="Checkout" asp-action="Index" class="btn btn-shop px-4">Thanh toán</a>
    </div>
}

@section Scripts {
    <script src="~/js/shop.js" asp-append-version="true"></script>
}
