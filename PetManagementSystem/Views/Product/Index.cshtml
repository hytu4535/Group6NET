@using PetManagementSystem.Helpers
@model PetManagementSystem.ViewModels.Shop.ProductListViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Sản phẩm thú cưng";
}

<link rel="stylesheet" href="~/css/shop.css" asp-append-version="true" />

<div class="container py-4 py-lg-5">
    <header class="text-center mb-4">
        <h1 class="h2 fw-bold">Sản phẩm &amp; phụ kiện thú cưng</h1>
        <p class="text-muted mb-0">Tìm thức ăn, đồ chơi và phụ kiện phù hợp cho thú cưng của bạn.</p>
    </header>

    <form method="get" asp-action="Index" class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3 p-lg-4">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-lg-4">
                    <label for="productSearch" class="form-label">Tìm kiếm sản phẩm</label>
                    <div class="input-group">
                        <span class="input-group-text" aria-hidden="true"><i class="bi bi-search"></i></span>
                        <input id="productSearch" name="search" type="search" maxlength="100"
                               value="@Model.Search" class="form-control"
                               placeholder="Nhập tên sản phẩm..." />
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-lg-3">
                    <label for="categoryId" class="form-label">Danh mục</label>
                    <select id="categoryId" name="categoryId" class="form-select">
                        <option value="">Tất cả danh mục</option>
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.Id" selected="@(Model.CategoryId == category.Id)">
                                @category.Name
                            </option>
                        }
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-lg-3">
                    <label for="sort" class="form-label">Sắp xếp</label>
                    <select id="sort" name="sort" class="form-select">
                        <option value="@ProductSorts.Newest" selected="@(Model.Sort == ProductSorts.Newest)">Mới nhất</option>
                        <option value="@ProductSorts.PriceAsc" selected="@(Model.Sort == ProductSorts.PriceAsc)">Giá tăng dần</option>
                        <option value="@ProductSorts.PriceDesc" selected="@(Model.Sort == ProductSorts.PriceDesc)">Giá giảm dần</option>
                        <option value="@ProductSorts.Name" selected="@(Model.Sort == ProductSorts.Name)">Tên A-Z</option>
                    </select>
                </div>
                <div class="col-12 col-lg-2 d-grid">
                    <button type="submit" class="btn btn-shop">
                        <i class="bi bi-funnel me-1"></i>Áp dụng
                    </button>
                </div>
            </div>

            <details class="mt-3">
                <summary class="fw-semibold text-primary">Bộ lọc nâng cao</summary>
                <div class="row g-3 align-items-end pt-3">
                    <div class="col-12 col-sm-6 col-lg-3">
                        <label for="minPrice" class="form-label">Giá từ</label>
                        <div class="input-group">
                            <input id="minPrice" name="minPrice" type="number" min="0" step="1000"
                                   value="@Model.MinPrice" class="form-control" placeholder="0" />
                            <span class="input-group-text">đ</span>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3">
                        <label for="maxPrice" class="form-label">Đến giá</label>
                        <div class="input-group">
                            <input id="maxPrice" name="maxPrice" type="number" min="0" step="1000"
                                   value="@Model.MaxPrice" class="form-control" placeholder="Không giới hạn" />
                            <span class="input-group-text">đ</span>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3">
                        <label for="pageSize" class="form-label">Số sản phẩm mỗi trang</label>
                        <select id="pageSize" name="pageSize" class="form-select">
                            <option value="12" selected="@(Model.PageSize == 12)">12</option>
                            <option value="24" selected="@(Model.PageSize == 24)">24</option>
                            <option value="48" selected="@(Model.PageSize == 48)">48</option>
                        </select>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="form-check mb-2">
                            <input id="inStock" name="inStock" type="checkbox" value="true"
                                   class="form-check-input" checked="@Model.InStock" />
                            <label for="inStock" class="form-check-label">Chỉ xem sản phẩm còn hàng</label>
                        </div>
                    </div>
                </div>
            </details>
        </div>
    </form>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <p class="text-muted mb-0">
            Tìm thấy <strong>@Model.TotalItems</strong> sản phẩm
            @if (Model.CategoryId.HasValue)
            {
                var selectedCategory = Model.Categories.FirstOrDefault(category => category.Id == Model.CategoryId);
                if (selectedCategory is not null)
                {
                    <span>trong danh mục <strong>@selectedCategory.Name</strong></span>
                }
            }
        </p>
        @if (Model.HasFilter)
        {
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-x-circle me-1"></i>Xóa bộ lọc
            </a>
        }
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-3 g-lg-4">
        @if (Model.Items.Count == 0)
        {
            <div class="col-12">
                <div class="text-center bg-light rounded-4 py-5 px-3">
                    <i class="bi bi-search text-muted fs-1" aria-hidden="true"></i>
                    <p class="text-muted fs-5 mt-3 mb-1">Không tìm thấy sản phẩm phù hợp.</p>
                    <p class="text-muted mb-0">Thử thay đổi từ khóa hoặc bộ lọc của bạn.</p>
                </div>
            </div>
        }
        else
        {
            @foreach (var product in Model.Items)
            {
                <div class="col">
                    <article class="card border-0 shadow-sm h-100 rounded-4 overflow-hidden product-card">
                        <a asp-action="Details" asp-route-id="@product.Id"
                           class="d-flex align-items-center justify-content-center bg-light position-relative p-3"
                           style="height: 210px;" aria-label="Xem @product.Name">
                            <img src="@ProductImages.Src(product.ImageUrl)" alt="@product.Name"
                                 onerror="@ProductImages.OnError" referrerpolicy="no-referrer"
                                 class="img-fluid" loading="lazy"
                                 style="max-height: 100%; object-fit: contain;" />
                            <span class="badge position-absolute top-0 end-0 m-3 @(product.InStock ? "text-bg-success" : "text-bg-secondary")">
                                @(product.InStock ? $"Còn {product.StockQuantity}" : "Hết hàng")
                            </span>
                        </a>
                        <div class="card-body d-flex flex-column">
                            @if (!string.IsNullOrWhiteSpace(product.CategoryName))
                            {
                                <span class="small text-muted mb-1">@product.CategoryName</span>
                            }
                            <h2 class="h6 card-title fw-bold">
                                <a asp-action="Details" asp-route-id="@product.Id"
                                   class="text-decoration-none text-dark">@product.Name</a>
                            </h2>
                            <p class="card-text text-muted small flex-grow-1">
                                @(string.IsNullOrWhiteSpace(product.Description)
                                    ? "Chưa có mô tả sản phẩm."
                                    : product.Description)
                            </p>
                            <div class="mt-2">
                                <span class="fw-bold fs-5 text-nowrap">@CommerceFormat.Money(product.Price)</span>
                            </div>
                            <div class="d-flex gap-2 mt-2">
                                <a asp-action="Details" asp-route-id="@product.Id"
                                   class="btn btn-sm btn-outline-secondary rounded-pill flex-fill">
                                    Chi tiết
                                </a>
                                <button type="button" class="btn btn-sm btn-shop rounded-pill flex-fill"
                                        data-add-to-cart="@product.Id" data-qty="1" disabled="@(!product.InStock)">
                                    <i class="bi bi-cart-plus me-1"></i>@(product.InStock ? "Thêm vào giỏ" : "Hết hàng")
                                </button>
                            </div>
                        </div>
                    </article>
                </div>
            }
        }
    </div>

    <partial name="~/Views/Shared/Commerce/_Pagination.cshtml"
             view-data='new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData)
             {
                 ["Page"] = Model.Page,
                 ["TotalPages"] = Model.TotalPages,
                 ["Action"] = "Index",
                 ["RouteValues"] = Model.RouteValues
             }' />
</div>

@section Scripts {
    <script src="~/js/shop.js" asp-append-version="true"></script>
}

<style>
    .product-card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .product-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1) !important;
    }
</style>
