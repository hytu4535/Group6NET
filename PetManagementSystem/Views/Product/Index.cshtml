@using PetManagementSystem.Helpers
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@model PetManagementSystem.ViewModels.Shop.ProductListViewModel
@{
    ViewData["Title"] = "Sản phẩm thú cưng";
    var pagerData = new ViewDataDictionary(ViewData)
    {
        ["Page"] = Model.Page,
        ["TotalPages"] = Model.TotalPages,
        ["Action"] = "Index",
        ["RouteValues"] = Model.RouteValues
    };
}

<link rel="stylesheet" href="~/css/shop.css" asp-append-version="true" />
@Html.AntiForgeryToken()

<div class="py-2">
    <div class="text-center mb-4">
        <h2 class="fw-bold">Sản phẩm &amp; Phụ kiện thú cưng</h2>
        <p class="text-muted mb-0">Thức ăn, đồ chơi và phụ kiện chất lượng cao cho thú cưng của bạn.</p>
    </div>

    <partial name="Shop/_Alerts" />

    <form method="get" asp-controller="Product" asp-action="Index" class="card border-0 shadow-sm rounded-4 p-3 mb-4">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label small mb-1" for="search">Tên sản phẩm</label>
                <input id="search" name="search" value="@Model.Search" class="form-control" maxlength="150" placeholder="Tìm kiếm sản phẩm..." />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small mb-1" for="categoryId">Danh mục</label>
                <select id="categoryId" name="categoryId" class="form-select">
                    <option value="">Tất cả</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Id" selected="@(Model.CategoryId == category.Id)">@category.Name</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small mb-1" for="sort">Sắp xếp</label>
                <select id="sort" name="sort" class="form-select">
                    @foreach (var sort in ProductSorts.All)
                    {
                        <option value="@sort" selected="@(Model.Sort == sort)">@ProductSorts.Label(sort)</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-1">
                <label class="form-label small mb-1" for="minPrice">Giá từ</label>
                <input id="minPrice" name="minPrice" type="number" min="0" step="1000" value="@Model.MinPrice" class="form-control" />
            </div>
            <div class="col-6 col-md-1">
                <label class="form-label small mb-1" for="maxPrice">Đến</label>
                <input id="maxPrice" name="maxPrice" type="number" min="0" step="1000" value="@Model.MaxPrice" class="form-control" />
            </div>
            <div class="col-12 col-md-1 d-grid">
                <button type="submit" class="btn btn-shop">Lọc</button>
            </div>
        </div>
        <div class="form-check mt-2">
            <input class="form-check-input" type="checkbox" id="inStock" name="inStock" value="true" checked="@Model.InStock" />
            <label class="form-check-label small" for="inStock">Chỉ hiện sản phẩm còn hàng</label>
            @if (Model.HasFilter)
            {
                <a asp-action="Index" class="ms-3 small">Xóa bộ lọc</a>
            }
        </div>
    </form>

    @if (Model.Items.Count == 0)
    {
        <div class="text-center py-5">
            <i class="bi bi-box-seam text-muted" style="font-size:3rem;"></i>
            <p class="text-muted fs-5 mt-2">
                @(Model.HasFilter ? "Không tìm thấy sản phẩm phù hợp với bộ lọc." : "Hiện chưa có sản phẩm nào đang bán.")
            </p>
        </div>
    }
    else
    {
        <p class="text-muted small">Tìm thấy @Model.TotalCount sản phẩm</p>
        <div class="row g-4">
            @foreach (var item in Model.Items)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card border-0 shadow-sm h-100 rounded-4 overflow-hidden shop-card">
                        <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none">
                            <div class="shop-thumb p-3">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.Name" loading="lazy" />
                                }
                                else
                                {
                                    <i class="bi bi-box-seam text-muted" style="font-size:3rem;"></i>
                                }
                                @if (item.InStock)
                                {
                                    <span class="badge text-bg-success position-absolute top-0 end-0 m-2">Còn hàng</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary position-absolute top-0 end-0 m-2">Hết hàng</span>
                                }
                            </div>
                        </a>
                        <div class="card-body d-flex flex-column">
                            @if (!string.IsNullOrEmpty(item.CategoryName))
                            {
                                <span class="small text-muted">@item.CategoryName</span>
                            }
                            <h5 class="card-title fw-bold fs-6 mb-2">
                                <a asp-action="Details" asp-route-id="@item.Id" class="text-dark text-decoration-none">@item.Name</a>
                            </h5>
                            <div class="mt-auto">
                                <div class="shop-price fs-5">@CommerceFormat.Money(item.Price)@(string.IsNullOrEmpty(item.Unit) ? "" : " / " + item.Unit)</div>
                                @if (item.InStock)
                                {
                                    @if (User.Identity?.IsAuthenticated == true)
                                    {
                                        <button type="button" class="btn btn-sm btn-shop w-100 mt-2" data-add-to-cart="@item.Id">
                                            <i class="bi bi-cart-plus me-1"></i>Thêm vào giỏ
                                        </button>
                                    }
                                    else
                                    {
                                        <a class="btn btn-sm btn-shop w-100 mt-2" href="/User/Login?returnUrl=@Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString)">
                                            <i class="bi bi-cart-plus me-1"></i>Đăng nhập để mua
                                        </a>
                                    }
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-secondary w-100 mt-2" disabled>Hết hàng</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <partial name="Commerce/_Pagination" view-data="pagerData" />
    }
</div>

@section Scripts {
    <script src="~/js/shop.js" asp-append-version="true"></script>
}
