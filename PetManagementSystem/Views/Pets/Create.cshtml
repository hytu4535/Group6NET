@model PetManagementSystem.ViewModels.CreatePetViewModel

@{
    ViewData["Title"] = "Thêm thú cưng";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h1 class="h4 mb-0">Thêm thú cưng</h1>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Tên thú cưng</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Species" class="form-label">Loài</label>
                                <input asp-for="Species" class="form-control" placeholder="Chó, Mèo..." />
                                <span asp-validation-for="Species" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Breed" class="form-label">Giống</label>
                                <input asp-for="Breed" class="form-control" />
                                <span asp-validation-for="Breed" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Gender" class="form-label">Giới tính</label>
                                <select asp-for="Gender" class="form-select">
                                    <option value="">-- Chọn giới tính --</option>
                                    <option value="Male">Đực</option>
                                    <option value="Female">Cái</option>
                                </select>
                                <span asp-validation-for="Gender" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="WeightKg" class="form-label">Cân nặng (kg)</label>
                                <input asp-for="WeightKg" type="number" step="0.1" class="form-control" />
                                <span asp-validation-for="WeightKg" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="AvatarFile" class="form-label">Ảnh đại diện</label>
                            <div class="mb-2">
                                <img id="avatarPreview" alt="Xem trước ảnh đại diện"
                                     class="rounded object-fit-cover border" width="140" height="140" style="display:none" />
                            </div>
                            <input asp-for="AvatarFile" type="file"
                                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                   class="form-control" />
                            <span asp-validation-for="AvatarFile" class="text-danger"></span>
                            <div class="form-text">JPG, JPEG, PNG hoặc WEBP, tối đa 5 MB.</div>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Lưu thú cưng</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const avatarInput = document.getElementById("AvatarFile");
    const avatarPreview = document.getElementById("avatarPreview");
    let avatarPreviewUrl;

    avatarInput.addEventListener("change", () => {
        const file = avatarInput.files?.[0];
        if (avatarPreviewUrl) URL.revokeObjectURL(avatarPreviewUrl);
        if (!file) {
            avatarPreview.removeAttribute("src");
            avatarPreview.style.display = "none";
            return;
        }

        avatarPreviewUrl = URL.createObjectURL(file);
        avatarPreview.src = avatarPreviewUrl;
        avatarPreview.style.display = "inline-block";
    });
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
