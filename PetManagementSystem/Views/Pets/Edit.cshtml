@model PetManagementSystem.ViewModels.EditPetViewModel
@{
    ViewData["Title"] = $"Cập nhật thú cưng - {Model.Name}";
}

<div class="container py-4">
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="status">@successMessage</div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3 text-primary" style="width: 70px; height: 70px;">
                            <i class="bi bi-pencil-square fs-2"></i>
                        </div>
                        <h3 class="fw-bold text-dark">Cập nhật thú cưng</h3>
                        <p class="text-muted small">Chỉnh sửa thông tin cho @Model.Name</p>
                    </div>

                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="UserId" />
                        <input type="hidden" name="petId" value="@Model.Id" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold">Tên thú cưng <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control rounded-pill px-3 py-2" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                                        </div>

                        <div class="mb-3">
                            <label asp-for="Species" class="form-label fw-semibold">Loài <span class="text-danger">*</span></label>
                            <input asp-for="Species" class="form-control rounded-pill px-3 py-2" required />
                            <span asp-validation-for="Species" class="text-danger small"></span>
                                </div>

                        <div class="mb-3">
                            <label asp-for="Breed" class="form-label fw-semibold">Giống (Breed)</label>
                            <input asp-for="Breed" class="form-control rounded-pill px-3 py-2" />
                            <span asp-validation-for="Breed" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Gender" class="form-label fw-semibold">Giới tính <span class="text-danger">*</span></label>
                            <select asp-for="Gender" class="form-select rounded-pill px-3 py-2" required>
                                <option value="Male">Đực (Male)</option>
                                <option value="Female">Cái (Female)</option>
                            </select>
                            <span asp-validation-for="Gender" class="text-danger small"></span>
                            </div>

                        <div class="mb-4">
                            <label asp-for="WeightKg" class="form-label fw-semibold">Cân nặng (kg)</label>
                            <input asp-for="WeightKg" type="number" step="0.1" class="form-control rounded-pill px-3 py-2" />
                            <span asp-validation-for="WeightKg" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="AvatarFile" class="form-label fw-semibold">Ảnh đại diện mới</label>
                            <input asp-for="AvatarFile" id="AvatarFile" class="form-control rounded-pill px-3 py-2" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                            <span asp-validation-for="AvatarFile" class="text-danger small"></span>
                            <div class="form-text">JPG, PNG hoặc WEBP; tối đa 5 MB.</div>
                            @if (!string.IsNullOrWhiteSpace(Model.CurrentAvatarUrl))
                            {
                                <img id="avatarPreview" src="@Model.CurrentAvatarUrl" alt="Ảnh đại diện hiện tại" class="img-thumbnail mt-2" style="max-width: 120px; max-height: 120px; object-fit: cover;" />
                            }
                            else
                            {
                                <img id="avatarPreview" alt="Ảnh đại diện xem trước" class="img-thumbnail mt-2" style="display: none; max-width: 120px; max-height: 120px; object-fit: cover;" />
                            }
                        </div>

                        @if (Model.GalleryImages.Count > 0)
                        {
                            <div class="mb-4">
                                <label class="form-label fw-semibold">Thư viện ảnh</label>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var image in Model.GalleryImages)
                                    {
                                        <div class="text-center">
                                            <img src="@image.ImageUrl" alt="Ảnh thú cưng" class="img-thumbnail" style="width: 80px; height: 80px; object-fit: cover;" />
                                            @if (!image.IsAvatar)
                                            {
                                                <button type="submit" formaction="@Url.Action("SetAvatar", "Pets")" formmethod="post" name="imageId" value="@image.Id" class="btn btn-link btn-sm d-block mx-auto p-0">Đặt làm avatar</button>
                                            }
                                            else
                                            {
                                                <small class="text-success d-block">Avatar</small>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-controller="Account" asp-action="MyPets" class="btn btn-outline-secondary rounded-pill px-4">
                                <i class="bi bi-arrow-left me-1"></i>Quay lại
                            </a>
                            <button type="submit" class="btn btn-primary rounded-pill px-5 shadow-sm">
                                <i class="bi bi-check-lg me-1"></i>Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const avatarInput = document.getElementById("AvatarFile");
    const avatarPreview = document.getElementById("avatarPreview");
    let avatarPreviewUrl;

    avatarInput?.addEventListener("change", () => {
        const file = avatarInput.files?.[0];
        if (avatarPreviewUrl) URL.revokeObjectURL(avatarPreviewUrl);
        if (!file) {
            if (avatarPreview) {
                avatarPreview.src = avatarPreview.dataset.originalSrc ?? "";
                avatarPreview.style.display = avatarPreview.dataset.originalSrc ? "inline-block" : "none";
            }
            return;
        }

        avatarPreviewUrl = URL.createObjectURL(file);
        if (avatarPreview) {
            avatarPreview.src = avatarPreviewUrl;
            avatarPreview.style.display = "inline-block";
        }
    });
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
