@model IEnumerable<PetManagementSystem.Models.Pet>
@{
    ViewData["Title"] = "Danh sách thú cưng";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary"><i class="bi bi-paw me-2"></i>Danh sách thú cưng</h2>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-plus-circle me-1"></i>Thêm thú cưng mới
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 text-center py-5">
            <div class="card-body">
                <i class="bi bi-heart text-muted display-4 mb-3"></i>
                <h4 class="fw-bold text-dark">Chưa có thú cưng nào</h4>
                <p class="text-muted mb-4">Hãy thêm thú cưng của bạn để bắt đầu quản lý sức khỏe và lịch hẹn.</p>
                <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">Thêm thú cưng ngay</a>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var pet in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 rounded-4">
                        <div class="ratio ratio-1x1 bg-light rounded-top-4 overflow-hidden">
                            <img src="@(pet.PetImages.FirstOrDefault(pi => pi.IsAvatar == true)?.ImageUrl ?? "/images/default-pet.jpg")" class="card-img-top object-fit-cover" alt="@pet.Name">
                        </div>
                        <div class="card-body d-flex flex-column p-4">
                            <h5 class="fw-bold text-dark mb-1">@pet.Name</h5>
                            <p class="text-muted small mb-3">@pet.Species - @(pet.Breed ?? "Không rõ giống")</p>

                            <div class="bg-light p-3 rounded-3 mb-3 small">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted">Giới tính:</span>
                                    <strong class="text-dark">@pet.Gender</strong>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted">Cân nặng:</span>
                                    <strong class="text-dark">@(pet.WeightKg.HasValue ? $"{pet.WeightKg} kg" : "N/A")</strong>
                                </div>
                            </div>

                            <div class="d-flex gap-2 mt-auto">
                                <a asp-action="Details" asp-route-id="@pet.Id" class="btn btn-outline-primary btn-sm rounded-pill flex-grow-1">
                                    <i class="bi bi-eye me-1"></i>Chi tiết
                                </a>
                                <a asp-action="Edit" asp-route-id="@pet.Id" class="btn btn-outline-secondary btn-sm rounded-pill">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
